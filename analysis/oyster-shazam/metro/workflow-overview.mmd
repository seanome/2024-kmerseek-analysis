graph LR
 subgraph inputs [Experimental inputs]
  raw[ ]
 end
 subgraph trim [Trimming — complete]
  trimming[Trim Galore]
  r1[ ]
  r2[ ]
  trimming -->|focal| r1
  trimming -->|focal| r2
 end
 subgraph discover [Differential discovery]
  splash[SPLASH — complete]
  select[Every adjusted P < 0.05 anchor]
  dekupl[DE-kupl — complete]
  splash -->|focal| select
 end
 subgraph extensions [Recover DNA]
  compact[Compactors — both mates]
  dna[ ]
  diff[ ]
  compact -->|focal| dna
 end
 subgraph refs [Reference inputs]
  publicreads[ ]
  swissfa[ ]
 end
 subgraph sketches [Build sketches]
  pubtrim[Trim + sketch runs]
  runsigs[ ]
  swsketch[manysketch]
  swisssigs[ ]
  pubtrim -->|archive| runsigs
  swsketch -->|swiss| swisssigs
 end
 subgraph querybuild [Build query sketches]
  queries[manysketch — new builds]
  querysigs[ ]
  queries -->|focal| querysigs
 end
 subgraph search [Search sequences]
  many[Branchwater index + manysearch]
 end
 querysigs -->|focal| many
 subgraph output [Compare and report]
  matches[ ]
  compare[Audit coverage + scale losses]
  losses[ ]
  matches -->|archive| compare
  compare -->|archive| losses
 end
 subgraph geneinput [Gene inputs]
  genepairs[ ]
 end
 subgraph quant [Quantify — complete]
  quantify[Salmon]
  abundance[ ]
  quantify -->|genes| abundance
 end
 subgraph fit [Gene DE]
  deseq[R DESeq2]
 end
 subgraph geneout [Gene results]
  geneDE[ ]
 end
 genepairs -->|genes| quantify
 abundance -->|genes| deseq
 deseq -->|genes| geneDE
 raw -->|focal| trimming
 r1 -->|focal| splash
 r2 -->|dekupl| dekupl
 select -->|focal| compact
 dekupl -->|dekupl| diff
 dna -->|focal| queries
 diff -->|dekupl| queries
 publicreads -->|archive| pubtrim
 swissfa -->|swiss| swsketch
 runsigs -->|archive| many
 swisssigs -->|swiss| many
 many -->|archive| matches
