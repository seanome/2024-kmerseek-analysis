manifest.nextflowVersion = '=25.04.7'
params {
    access_confirmed = false
    resources_reviewed = false
    ownership_reviewed = false
    python = null
    sourmash = null
    reference_manifest = null
    query_manifest = null
    // Supply measured first-attempt resources in an untracked launch config.
    task_cpus = null
    task_memory = null
    task_time = null
    partition = null
}
process.errorStrategy = 'terminate'
profiles {
    sherlock {
        process.executor = 'slurm'
        process.queue = params.partition
        process.cpus = params.task_cpus
        process.memory = params.task_memory
        process.time = params.task_time
        executor.queueSize = 2
        executor.pollInterval = '60 sec'
    }
}
trace.enabled = true
report.enabled = true
timeline.enabled = true
dag.enabled = true
