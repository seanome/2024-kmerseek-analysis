// Local execution is bounded by the enclosing Slurm allocation.
process {
    executor = 'local'
    cpus = 2
    memory = '4 GB'
    time = '12h'
    maxForks = 2
    errorStrategy = 'terminate'
    withName: '.*:TRIMGALORE' {
        cpus = 8
        memory = '8 GB'
    }
    withName: '.*:SALMON_INDEX' {
        cpus = 4
        memory = '16 GB'
    }
}
executor {
    cpus = 16
    memory = '48 GB'
}
singularity {
    enabled = true
    autoMounts = true
    cacheDir = "${System.getenv('SCRATCH')}/botryllus-shazam-PEC-20261023/images"
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
    fields = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,workdir'
}
