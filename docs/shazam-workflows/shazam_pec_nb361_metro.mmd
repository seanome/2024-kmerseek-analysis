%%metro title: Shazam for Biology, Botryllus electrical stimulation (PEC), nb361
%%metro style: nfcore
%%metro legend: bl
%%metro caption: Every station not marked (script) or (planned) is one of the 9 processes of nextflow-runs/pec-domen2026. File icon = file type, with what it holds below it. "(planned)" = not built yet.
%%metro line_order: definition
%%metro compact_offsets: true
%%metro center_ports: true
%%metro line: splash | SPLASH anchors (reference-free) | #0570b0
%%metro line: counts | Anchor counts, PyDESeq2 | #2db572
%%metro line: dekupl | DE-kupl contigs, limma | #e6550d
%%metro line: protein | Protein sketches and search | #756bb1
%%metro line: check | Checks: known-answer control, paper gene lists | #7f7f7f | dashed
%%metro process: download | ^download$
%%metro process: fastp | ^fastp$
%%metro process: simulate_control | ^simulate_control$
%%metro process: splash | ^splash$
%%metro process: compactors | ^compactors$
%%metro process: anchor_counts | ^anchor_counts$
%%metro process: dekupl | ^dekupl$
%%metro process: search | ^search$
%%metro process: control_truth | ^control_truth$
%%metro files: reads_in | FASTQ.GZ | 64 runs, 47 used\n78 GB
%%metro file: design_in | TSV | design + c_j\n(freeze_design)
%%metro file: design_dk | TSV | design\n(freeze_design)
%%metro file: ctrlfa_in | FA | control\n3,100 transcripts
%%metro file: ctrltsv_in | TSV | control\nplanted changes
%%metro file: db_in | ROCKSDB | 3 protein indexes\n(06_db_sketch)
%%metro file: si_in | XLSX | PNAS Dataset S1
%%metro file: anch_out | TSV | anchors, q at most 0.05
%%metro file: comp_out | TSV | compactors
%%metro file: deseq_out | PARQUET | anchor DESeq2
%%metro file: dekupl_out | TSV.GZ | k-mers, contigs
%%metro file: aln_out | PARQUET | peptide hits +\nalignments
%%metro file: ctrlj_out | JSON | control recall
%%metro file: paper_out | TSV | paper gene lists
%%metro file: nb_out | IPYNB | notebook 361,\nfigures, report\n(planned)
%%metro off_track: anch_out, comp_out, deseq_out, dekupl_out, aln_out, ctrlj_out, paper_out
%%metro grid: reads | 0,0,1,1
%%metro grid: find | 1,0,1,1
%%metro grid: dk | 0,1,1,1
%%metro grid: srch | 1,1,1,1
%%metro grid: checks | 0,2,1,1

graph LR
    subgraph reads [Reads]
        %%metro exit: right | splash, counts, dekupl
        reads_in[ ]
        ctrlfa_in[ ]
        ctrltsv_in[ ]
        download[download\nmd5 + read count]
        simulate_control[simulate_control\n12 samples x 1 M pairs]
        fastp[fastp]

        reads_in -->|splash,counts,dekupl| download
        download -->|splash,counts,dekupl| fastp
        ctrlfa_in -->|splash,counts,dekupl| simulate_control
        ctrltsv_in -->|splash,counts,dekupl| simulate_control
        simulate_control -->|splash,counts,dekupl| fastp
    end

    subgraph find [SPLASH, PEC +1 vs control -1]
        %%metro entry: left | splash, counts
        %%metro exit: right | splash, counts
        design_in[ ]
        splash[splash\nSPLASH 2.11.9]
        compactors[compactors]
        anchor_counts[anchor_counts\nPyDESeq2]
        anch_out[ ]
        comp_out[ ]
        deseq_out[ ]

        design_in -->|splash,counts| splash
        splash -->|splash| compactors
        splash -->|splash| anch_out
        compactors -->|splash| comp_out
        splash -->|counts| anchor_counts
        anchor_counts -->|counts| deseq_out
    end

    subgraph dk [DE-kupl, PEC vs control]
        %%metro entry: left | dekupl
        %%metro exit: right | dekupl
        design_dk[ ]
        dekupl[dekupl\nDE-kupl 1.3.5, limma]
        dekupl_out[ ]

        design_dk -->|dekupl| dekupl
        dekupl -->|dekupl| dekupl_out
    end

    subgraph srch [Translate and search]
        %%metro entry: left | splash, dekupl
        %%metro exit: right | splash, dekupl, protein
        db_in[ ]
        search[search\ntranslate, manysearch,\nparasail]
        aln_out[ ]

        db_in -->|protein| search
        search -->|splash,dekupl,protein| aln_out
    end

    subgraph checks [Checks and results]
        %%metro entry: left | splash, counts, dekupl, protein
        si_in[ ]
        control_truth[control_truth]
        paper[paper_gene_lists\n(script)]
        recover[paper-list recovery,\nnotebook 361 (planned)]
        ctrlj_out[ ]
        paper_out[ ]
        nb_out[ ]

        control_truth -->|check| ctrlj_out
        si_in -->|check| paper
        paper -->|check| paper_out
        control_truth -->|check| recover
        paper -->|check| recover
        recover -->|splash,counts,dekupl,protein,check| nb_out
    end

    fastp -->|splash,counts| splash
    fastp -->|dekupl| dekupl
    compactors -->|splash| search
    dekupl -->|dekupl| search
    splash -->|splash| control_truth
    anchor_counts -->|counts| control_truth
    dekupl -->|dekupl| control_truth
    anchor_counts -->|counts| recover
    search -->|splash,dekupl,protein| recover
