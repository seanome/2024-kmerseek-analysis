manifest { nextflowVersion = '25.10.4' }
params {
    inputs = null
    design = null
    samples = null
    reference = null
    gtf = null
    targets = null
    paper = null
    annotations = null
    genome = null
    pfam_hmm = null
    minimap2 = "/share/software/user/open/minimap2/2.30/bin/minimap2"
    hmmscan = null
    outdir = 'results'
    expected_libraries = 64
    python = "${System.getenv('GROUP_HOME')}/opt/oyster-shazam-20261023/bin/python"
    dekupl = "${System.getenv('GROUP_HOME')}/opt/botryllus-dekupl-1.3.3-20261024"
    software = "${System.getenv('SCRATCH')}/oyster-shazam-20261023/software"
}
process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    cpus = 1
    memory = '8 GB'
    time = '4h'
    errorStrategy = 'terminate'
    cache = 'deep'
}
profiles {
    sherlock {
        process.executor = 'slurm'
        process.queue = 'normal,hns'
        process.clusterOptions = { task.time > 48.h ? '--qos=long' : '' }
        executor.queueSize = 64
        process.maxForks = 64
    }
}
trace { enabled = true; fields = 'task_id,hash,name,status,exit,submit,duration,realtime,cpus,memory,time,peak_rss,workdir'; file = "${params.outdir}/diagnostics/trace-${new Date().format('yyyyMMdd-HHmmss-SSS')}.tsv" }
report { enabled = true; overwrite = true; file = "${params.outdir}/diagnostics/report-${new Date().format('yyyyMMdd-HHmmss-SSS')}.html" }
timeline { enabled = true; overwrite = true; file = "${params.outdir}/diagnostics/timeline-${new Date().format('yyyyMMdd-HHmmss-SSS')}.html" }
