  sra_manifest[ ]
  fetch[curl / MD5 / Rust FASTQ validation]
  sra_r1[ ]
  sra_r2[ ]
  trim[Trim Galore; public archive only]
  sra_trim1[ ]
  sra_trim2[ ]
  sra_sketch[sourmash sketch dna / translate]
  sra_sig[ ]
  index[Branchwater index]
  sra_index[ ]
  occurrence[Branchwater manysearch; scaled 10 and 100]
  sra_hits[ ]
  coverage[ ]
  sra_manifest -->|sra| fetch
  fetch -->|sra| sra_r1
  fetch -->|sra| sra_r2
  sra_r1 -->|sra| trim
  sra_r2 -->|sra| trim
  trim -->|sra| sra_trim1
  trim -->|sra| sra_trim2
  sra_trim1 -->|sra| sra_sketch
  sra_trim2 -->|sra| sra_sketch
  sra_sketch -->|sra| sra_sig
  sra_sig -->|sra| index
  index -->|sra| sra_index
  sra_index -->|sra| occurrence
  occurrence -->|sra| sra_hits
  occurrence -->|sra| coverage
 end
 subgraph dna_query [SRA queries use the Botryllus experiment; no archive-wide SPLASH or DE-kupl]
