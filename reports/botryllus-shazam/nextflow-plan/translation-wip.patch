diff --git a/scripts/botryllus_shazam/dekupl_translation.py b/scripts/botryllus_shazam/dekupl_translation.py
new file mode 100644
index 00000000..31a865f7
--- /dev/null
+++ b/scripts/botryllus_shazam/dekupl_translation.py
@@ -0,0 +1,30 @@
+"""Six-frame context translation; only stops delimit stretches."""
+
+from Bio.Seq import Seq
+
+
+def translate_context(dna):
+    fragments, membership, coordinates = {}, {}, {}
+    for origin, sequence in dna.items():
+        for strand, oriented in [
+            ("+", sequence),
+            ("-", str(Seq(sequence).reverse_complement())),
+        ]:
+            for frame in range(3):
+                coding = oriented[frame:]
+                coding = coding[: len(coding) - len(coding) % 3]
+                peptide = str(Seq(coding).translate())
+                offset = 0
+                for stretch in peptide.split("*"):
+                    if len(stretch) >= 30:
+                        fid = f"FRAG{len(fragments)+1:012d}"
+                        fragments[fid] = stretch
+                        membership[fid] = origin
+                        coordinates[fid] = dict(
+                            origin=origin,
+                            strand=strand,
+                            frame=frame,
+                            amino_acid_offset=offset,
+                        )
+                    offset += len(stretch) + 1
+    return fragments, membership, coordinates
diff --git a/scripts/botryllus_shazam/test_dekupl_translation.py b/scripts/botryllus_shazam/test_dekupl_translation.py
new file mode 100644
index 00000000..615c02db
--- /dev/null
+++ b/scripts/botryllus_shazam/test_dekupl_translation.py
@@ -0,0 +1,26 @@
+import unittest
+from dekupl_translation import translate_context
+
+
+class TranslationTests(unittest.TestCase):
+    def test_boundaries(self):
+        for length in (29, 30, 31):
+            f, m, c = translate_context({"origin": "GCT" * length})
+            plus_zero = [k for k in c if c[k]["strand"] == "+" and c[k]["frame"] == 0]
+            self.assertEqual(len(plus_zero), int(length >= 30))
+            if plus_zero:
+                self.assertEqual(f[plus_zero[0]], "A" * length)
+            self.assertTrue(all(v == "origin" for v in m.values()))
+
+    def test_x_stops_six_frames(self):
+        f, m, c = translate_context(
+            {"x": "GCT" * 15 + "NNN" + "GCT" * 15 + "TAA" + "GCT" * 30}
+        )
+        plus_zero = [f[k] for k in c if c[k]["strand"] == "+" and c[k]["frame"] == 0]
+        self.assertEqual(plus_zero, ["A" * 15 + "X" + "A" * 15, "A" * 30])
+        f, m, c = translate_context({"all": "GCT" * 100})
+        self.assertEqual(
+            {(v["strand"], v["frame"]) for v in c.values()},
+            {(s, i) for s in ("+", "-") for i in range(3)},
+        )
+        self.assertTrue(all(m[k] == c[k]["origin"] for k in f))
