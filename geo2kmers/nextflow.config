// geo2kmers. No `def` here: Nextflow 26 rejects declarations in configs.

trace {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/geo2kmers.trace.txt"
    fields    = 'task_id,name,status,exit,cpus,memory,attempt,realtime,%cpu,peak_rss'
}

process {
    cpus   = 1
    memory = { 2.GB * task.attempt }
    time   = { 15.min * task.attempt }
}

profiles {
    // no GPU, no scheduler: four CPUs and 16 GB, the size of a laptop
    small {
        process.executor = 'local'
        executor {
            cpus   = 4
            memory = '16 GB'
        }
    }
}
