# The Python steps of the DisProt benchmark: truth building, disorder-binned evaluation
# (scikit-learn), aggregation and figures (matplotlib), MultiQC inputs. The kmerseek
# image carries polars but neither scikit-learn nor matplotlib, and metapredict has its
# own image, so this one exists for the rest.
#
# Build and push with `make push-python-image`; params.python_image in main.nf names the
# pushed tag. Sherlock compute nodes are amd64, so the Makefile builds --platform
# linux/amd64 (an Apple Silicon default build is arm64, which Apptainer refuses).
#
# polars-lts-cpu, not polars: the plain amd64 wheel is compiled for AVX2 and segfaults
# under the laptop's amd64 emulation (`make run-mini`), which has no AVX. The lts-cpu build
# dispatches at runtime and runs on both; the tables here are small enough that the
# speed difference is nothing. Its newest PyPI release on 2026-09-18 was 1.33.1, and every
# polars call in bin/ was checked against 1.34 on the laptop. scikit-learn and matplotlib
# were resolved against PyPI the same day; numpy and pyarrow match the kmerseek image.
FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates procps zstd gzip python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir --break-system-packages \
        'polars-lts-cpu==1.33.1' 'pyarrow==25.0.1' 'numpy==2.5.2' \
        'scikit-learn==1.9.1' 'matplotlib==3.11.2'

# matplotlib writes a font cache under $HOME; under Apptainer $HOME can be read-only.
ENV MPLCONFIGDIR=/tmp/mplconfig

WORKDIR /data
