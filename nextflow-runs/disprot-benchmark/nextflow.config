// nextflow.config -- DisProt disorder benchmark
//
// Three profiles: `standard` (local Docker, for a smoke test on the laptop), `sherlock`
// (SLURM + Apptainer, the real sweep) and `stub` (wiring check, no containers, no data).
// Executor, queue and account conventions are qfo-pfam-region-benchmark's and
// invertebrate-dark-set's, so a job from this pipeline queues and accounts exactly like
// its neighbours.

// The three images, declared HERE and not in main.nf: the config is parsed first, so a
// param the withLabel/withName selectors below read has to exist by then.
//
// kmerseek: every search task's cache key includes this, so changing it re-runs every
// search. The rocksdb-4gb-readonly build opens the target index read-only, which is
// what makes sharing the region benchmark's index cache safe: the earlier build wrote
// into index directories it searched and invalidated every stored search on them
// (2026-09-17).
params.kmerseek_image    = 'docker.io/olgabot/kmerseek:2026-09-13-rocksdb-4gb-readonly'
// The Python steps: the evaluator needs scikit-learn and the aggregator matplotlib,
// neither of which the kmerseek image carries. Built and pushed by
// `make push-python-image`; the tag is the build date and the Makefile's
// PYTHON_IMAGE_TAG must match it.
params.python_image      = 'docker.io/olgabot/disprot-benchmark-python:2026-09-18'
// metapredict, the same tag the region benchmark and the dark set use, so all three
// pipelines score disorder with one predictor version.
params.metapredict_image = 'docker.io/olgabot/metapredict:2026-08-27'

// Per PROCESS. A sweep is ~1_650 searches plus as many format and evaluate tasks; the
// region benchmark ran the same shape at 150.
params.max_forks         = 100
params.submit_rate_limit = '15/1min'
params.queue_size        = 400

// One trace per run, so a mini and a full run in the same launch directory do not
// truncate each other's timings. Declared here, not in main.nf: the config is parsed
// first. `make run-mini` passes --run_tag mini.
params.run_tag = 'full'

workDir = "${launchDir}/work"

trace {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/disprot_benchmark.${params.run_tag}.trace.txt"
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,container,cpus,time,memory,attempt,submit,start,complete,duration,realtime,%cpu,%mem,rss,peak_rss'
}
timeline { enabled = true; overwrite = true; file = "${launchDir}/disprot_benchmark.${params.run_tag}.timeline.html" }
report   { enabled = true; overwrite = true; file = "${launchDir}/disprot_benchmark.${params.run_tag}.report.html" }

// Every process declares its own errorStrategy in main.nf (retryOnKill or its variants),
// so nothing here falls back to Nextflow's default `terminate`, whose first failure
// cancels every task still running.

profiles {
    standard {
        process {
            cpus   = 2
            memory = '8 GB'
            withLabel: medium_cpu { cpus = 4; memory = '8 GB' }
            // Container by label. Every Python step carries it, so a new one is covered.
            withLabel: python     { cpus = 1; memory = '8 GB'; container = params.python_image }
            // Body directives lose to any config selector, so container, cpus and memory
            // for the two special cases live here.
            withName: predictDisorder { container = params.metapredict_image
                                        cpus = 2; memory = '16 GB' }
            // cpus only: memory for both kmerseek processes is the per-combo closure in
            // main.nf, and a selector here would silently replace it.
            withName: 'kmerseekIndex|kmerseekSearch' { cpus = 4 }
        }
        docker {
            enabled    = true
            runOptions = '--entrypoint "" --platform linux/amd64'
        }
        executor {
            name   = 'local'
            cpus   = 12
            memory = '64 GB'
        }
    }

    sherlock {
        process {
            executor       = 'slurm'
            queue          = 'hns'
            clusterOptions = '--account=ayeletv'
            cpus     = 2
            memory   = '16 GB'
            time     = '4h'
            maxForks = params.max_forks

            withLabel: python { cpus = 2; memory = '24 GB'; time = '4h'
                                container = params.python_image }
            // 271 queries against one proteome at -s 7: minutes.
            withLabel: medium_cpu { cpus = 8; memory = '32 GB'; time = '4h' }

            // cpus and time ONLY. Memory is the per-combo closure in main.nf; a withName
            // setting memory here would replace it without saying so (measured in the
            // dark set, Nextflow 25.10: a body directive beats the generic block but
            // loses to any selector). 8 cpus, not 16: a search is memory-bound and two
            // 8-cpu searches fit on a 192 GB / 24-core hns node where one 16-cpu search
            // left the rest idle. The region benchmark's searches on these targets ran
            // 3-30 min with 19_696 queries; 271 queries want far less than 4h.
            withName: 'kmerseekIndex|kmerseekSearch' {
                cpus = 8
                time = { Math.min(4 * task.attempt, 24) + 'h' }
            }
            // metapredict over 271 proteins is one short task; the largest region
            // benchmark proteome peaked at 11.80 GB, so 16 GB has headroom.
            withName: predictDisorder { container = params.metapredict_image
                                        cpus = 4; memory = '16 GB'; time = '2h' }
            withName: 'aggregateDisprotMetrics|buildMultiqcInputs' { memory = '32 GB' }
        }
        // Sherlock throttles job SUBMISSION per hour separately from how many may run,
        // and hitting it aborts the run (`sbatch: error: Reached jobs per hour limit`).
        // Values are the region benchmark's, which ran a sweep of this shape under them.
        executor {
            submitRateLimit = params.submit_rate_limit
            queueSize       = params.queue_size
        }
        apptainer {
            enabled    = true
            autoMounts = true
            cacheDir   = "${System.getenv('SCRATCH') ?: '.'}/apptainer-cache"
        }
    }

    // Wiring check only: `nextflow run main.nf -profile stub -stub-run` runs every
    // process's `stub:` block locally with no container and no data. Declared LAST:
    // Nextflow applies profiles in the order they are declared here, not the order on
    // the command line, and a layered profile declared above the one it overrides loses.
    stub {
        docker.enabled    = false
        apptainer.enabled = false
        // The per-combo memory model still runs in a stub run and the local executor
        // refuses a task that asks for more than the machine has.
        params.kmerseek_memory_max       = '1 GB'
        params.kmerseek_memory_floor     = '1 GB'
        params.kmerseek_index_memory_max = '1 GB'
        params.kmerseek_memory_unmodelled = ''
        process {
            executor = 'local'
            cpus     = 1
            memory   = '1 GB'
            withLabel: medium_cpu { cpus = 1; memory = '1 GB' }
            withLabel: python     { cpus = 1; memory = '1 GB' }
            withName: predictDisorder { cpus = 1; memory = '1 GB' }
            withName: 'kmerseekIndex|kmerseekSearch' { cpus = 1 }
        }
    }
}
