// nextflow.config — DisProt disorder benchmark pipeline

def dateFormat = new java.text.SimpleDateFormat('yyyy-MM-dd')
def today = dateFormat.format(new java.util.Date())

workDir = "${launchDir}/work"

trace {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/disprot_benchmark.${today}.trace.txt"
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,container,cpus,time,memory,attempt,submit,start,complete,duration,realtime,%cpu,%mem,rss,peak_rss'
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/disprot_benchmark.${today}.timeline.html"
}

report {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/disprot_benchmark.${today}.report.html"
}

// ---------------------------------------------------------------------------
// Process resource labels
// ---------------------------------------------------------------------------

process {
    errorStrategy = { task.exitStatus in [130, 137, 140] ? 'retry' : 'terminate' }
    maxRetries    = 3

    withLabel: medium_cpu {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = '12h'
    }

    withLabel: python {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = '4h'
        // No container; uses conda Python via absolute shebang in script
    }

    // Per-process overrides
    withName: downloadDisprot {
        memory = '2 GB'
        time   = '30m'
    }

    withName: mapDisprotToPfam {
        memory = { 4.GB * task.attempt }
    }

    withName: buildDisprotGroundTruth {
        memory = { 8.GB * task.attempt }
    }

    withName: predictDisorder {
        cpus   = 2
        memory = { 16.GB * task.attempt }   // ESM embeddings can be large
        time   = '6h'
    }

    withName: kmerseekIndex {
        cpus     = 4
        memory   = { 8.GB * task.attempt }
        maxForks = 6    // index builds are fast; limit I/O pressure
    }

    withName: kmerseekSearch {
        cpus     = 4
        memory   = { 8.GB * task.attempt }
        time     = '8h'
        maxForks = 4
    }

    withName: formatKmerseekResults {
        cpus     = 1
        memory   = { 4.GB * task.attempt }
        time     = '2h'
        maxForks = 9
    }

    withName: downloadAlphaFoldStructures {
        cpus     = 1
        memory   = '4 GB'
        time     = '6h'
        maxForks = 2    // 2 label-batches × 5 internal workers = 10 concurrent HTTP
    }

    withName: foldseekSearch {
        cpus     = 4
        memory   = { 16.GB * task.attempt }
        maxForks = 4
    }

    withName: mmseqs2EasySearch {
        cpus     = 4
        memory   = { 16.GB * task.attempt }
        maxForks = 3
    }

    withName: evaluateDisprotBenchmark {
        cpus     = 1
        memory   = { 4.GB * task.attempt }
        maxForks = 9
    }

    withName: aggregateDisprotMetrics {
        cpus   = 1
        memory = '8 GB'
        time   = '2h'
    }

    withName: generateReport {
        memory = '2 GB'
        time   = '30m'
    }
}

// ---------------------------------------------------------------------------
// Executor
// ---------------------------------------------------------------------------

executor {
    name   = 'local'
    cpus   = 12
    memory = '64 GB'
}

// ---------------------------------------------------------------------------
// Docker
// ---------------------------------------------------------------------------

docker {
    enabled    = true
    runOptions = '--entrypoint ""'
}
