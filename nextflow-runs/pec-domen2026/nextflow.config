// Notebook 361 pipeline: Domen et al. 2026 PEC RNA-seq without a genome.
// No `def` here: Nextflow 26 rejects variable declarations in config files.

params {
    pec_root      = null
    code_dir      = null
    contrasts     = 'young_2h,young_24h,old_24h,young_13_49d,young_132d,old_41_93d'
    control       = true
    dekupl_method = 'limma'
    reuse_dir     = ''
    run_date      = new java.text.SimpleDateFormat('yyyy-MM-dd_HHmm').format(new java.util.Date())
}

workDir = "${launchDir}/work"

trace {
    enabled   = true
    overwrite = false
    file      = "${launchDir}/pec361.${params.run_date}.trace.txt"
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,cpus,time,memory,attempt,submit,start,complete,duration,realtime,%cpu,%mem,rss,peak_rss,workdir'
}
timeline { enabled = true; overwrite = false; file = "${launchDir}/pec361.${params.run_date}.timeline.html" }
report   { enabled = true; overwrite = false; file = "${launchDir}/pec361.${params.run_date}.report.html" }

// First asks come from the stages' measured runs (2026-10-23 to 10-30, Slurm logs and
// /usr/bin/time in $SCRATCH/nb361-pec): see the README table. Retries double memory and time.
process {
    // Scheduler kills report Integer.MAX_VALUE, not 137/140; retry those and memory/time kills
    // twice, then give up on that task only, so one contrast cannot stop the others.
    errorStrategy = { def s = task.exitStatus
                      (s == null || s == Integer.MAX_VALUE || s in [137, 140] || s in 128..143) && task.attempt <= 2
                          ? 'retry' : 'ignore' }
    maxRetries    = 2

    withLabel: download      { cpus = 2;  memory = { 4.GB * task.attempt };   time = { 12.h * task.attempt } }
    withLabel: fastp         { cpus = 8;  memory = { 8.GB * task.attempt };   time = { 2.h * task.attempt } }
    withLabel: small         { cpus = 4;  memory = { 8.GB * task.attempt };   time = { 2.h * task.attempt } }
    withLabel: small_mem     { cpus = 2;  memory = { 32.GB * task.attempt };  time = { 2.h * task.attempt } }
    withLabel: splash        { cpus = 32; memory = { 128.GB * task.attempt }; time = { 12.h * task.attempt } }
    withLabel: compactors    { cpus = 32; memory = { 64.GB * task.attempt };  time = { 12.h * task.attempt } }
    withLabel: anchor_counts { cpus = 16; memory = { 128.GB * task.attempt }; time = { 24.h * task.attempt } }
    withLabel: dekupl        { cpus = 32; memory = { 128.GB * task.attempt }; time = { 48.h * task.attempt } }
    withLabel: search        { cpus = 16; memory = { 64.GB * task.attempt };  time = { 24.h * task.attempt } }
}

profiles {
    sherlock {
        process {
            executor       = 'slurm'
            queue          = 'hns,normal'
            clusterOptions = '--account=ayeletv'
        }
        executor {
            queueSize       = 40
            submitRateLimit = '10/1min'
            pollInterval    = '1 min'
        }
    }
}
