// Nextflow configuration for kmerseek HP alphabet sweep benchmark

def dateFormat = new java.text.SimpleDateFormat('yyyy-MM-dd')
def today = dateFormat.format(new java.util.Date())

workDir = "${launchDir}/work"

trace {
    enabled = true
    file = "${launchDir}/hp_alphabet_sweep.${today}.trace.txt"
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes'
}

timeline {
    enabled   = true
    overwrite = true
    file = "${launchDir}/hp_alphabet_sweep.${today}.timeline.html"
}

report {
    enabled   = true
    overwrite = true
    file = "${launchDir}/hp_alphabet_sweep.${today}.report.html"
}

process {
    cpus   = 1
    memory = '4 GB'
    time   = '12h'

    withName: parseScopeHeaders {
        cpus   = 1
        memory = '1 GB'
        time   = '10m'
    }

    withName: indexDatabase {
        cpus      = 2
        memory    = '32 GB'   // largest index ~512 MB on disk; 32 GB is conservative
        time      = '72h'
        maxForks  = 2
        container = 'kmerseek:0.3.0'
    }

    withName: searchAllVsAll {
        cpus      = 2
        memory    = '32 GB'   // all-vs-all loads one index; same ceiling as index
        time      = '72h'
        maxForks  = 2
        container = 'kmerseek:0.3.0'
    }

    withName: evaluateScopeHierarchy {
        cpus      = 1
        memory    = '16 GB'
        time      = '2h'
        container = 'kmerseek-analysis:latest'
    }

    withName: aggregateScopeResults {
        cpus      = 1
        memory    = '2 GB'
        time      = '30m'
        container = 'kmerseek-analysis:latest'
    }
}

executor {
    name   = 'local'
    cpus   = 8
    memory = '110 GB'   // Leave ~18 GB for OS and other processes.
}

docker {
    enabled = true
}
