// Regions-index pilot. Two profiles: `local` (the laptop: conda Python and the repo's pixi
// MMseqs2, no containers) and `sherlock` (SLURM + Apptainer).

params.run_date = new java.text.SimpleDateFormat('yyyy-MM-dd').format(new java.util.Date())
// Read by the sherlock profile's process block, so declared here, not in main.nf (a config
// profile cannot see a param main.nf declares: Nextflow 25.04 stops with "Unknown config
// attribute process.params...").
// 0.4.1-rc1 = v0.4.0 plus `search --ka-r-database` (kmerseek branch
// olgabot/v0.4.1-ka-r-database, ea12593), for the shared-fit reading.
// Tag 0.4.1-rc1, pushed 2026-10-13, digest
// sha256:bc877be09416c7d83232a860567a1d9c306adf977afd80a5d89c7558275dd765. Kept as the tag:
// the full run started on the tag, and the container name is part of each task's cache
// key, so switching to the digest would rerun every finished task. Do not push another
// image under this tag.
params.kmerseek_image = 'docker.io/olgabot/kmerseek:0.4.1-rc1'
params.max_forks      = 200
// Same MMseqs2 image as invertebrate-dark-set's mmseqs2Search (olgabot/dark-set-kmerseek-0.4).
params.mmseqs_image   = 'quay.io/biocontainers/mmseqs2@sha256:3503bfe576d560e550df2872af86a1ad1bcc1c06cfb7caadd3e7a95649f5f0ef'
params.python         = 'python3'
params.mmseqs         = 'mmseqs'
params.kmerseek       = 'kmerseek'
// Sherlock asks for the kmerseek and MMseqs2 tasks. Set from the laptop measurement in
// BUILD_REPORT.md ("Resources"), and raised on a retry. Read by the sherlock profile, so
// declared here.
params.kmerseek_index_hours      = 6
params.kmerseek_search_hours     = 4
params.mmseqs_memory_gb          = 64
params.mmseqs_hours              = 8
// scoreCalls holds every call of one label in memory, so its peak grows with the size of
// its call files. Fitted 2026-10-16 to the full run's 27 finished scoreCalls tasks and its
// 18 memory kills at a flat 24 GB (BUILD_REPORT.md, "scoreCalls memory"). Peak GB =
// base + slope x (GB of gzipped calls). The whole-protein index needs more, because each
// call is joined with every feature of its target protein. First ask = headroom x peak, at
// least the floor, doubled on each retry, never above the max: the 1 TB hns nodes.
params.score_calls_whole_base_gb  = 6
params.score_calls_whole_slope    = 32
params.score_calls_other_base_gb  = 1
params.score_calls_other_slope    = 18
params.score_calls_headroom       = 1.25
params.score_calls_floor_gb       = 8
params.score_calls_memory_max_gb  = 950
// Walltime: the slowest finished task took 9.7 min per GB of calls (whole, sdm12 k7).
params.score_calls_base_hours     = 1
params.score_calls_hours_per_gb   = 0.2

workDir = "${launchDir}/work"

trace {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/regions_index_pilot.${params.run_date}.trace.txt"
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,container,cpus,time,memory,attempt,submit,start,complete,duration,realtime,%cpu,peak_rss,rchar,wchar'
}

profiles {
    local {
        params.python = '/Users/olga/anaconda3/envs/2025-kmerseek-analysis/bin/python3'
        params.time_cmd = '/usr/bin/time -l'
        // The laptop has 128 GB; no task may ask for more than the local executor allows.
        params.kmerseek_memory_max_gb = 110
        // The pixi env lives in the main checkout only; a worktree has no .pixi folder.
        params.mmseqs = "${System.getenv('HOME')}/code/2024-kmerseek-analysis/.pixi/envs/mmseqs2/bin/mmseqs"
        // kmerseek: pass --kmerseek <path to a v0.4.0 (0aed5ca) build>, the commit whose
        // features the 0.4.0-rc5 image matches (Makefile: KMERSEEK=...).
        executor { cpus = 16; memory = '120 GB' }
        process {
            executor = 'local'
            cpus     = 2
            memory   = '8 GB'
            withLabel: mmseqs          { cpus = 8;  memory = '32 GB' }
            withLabel: kmerseek_index  { cpus = 16; maxForks = 1 }
            // Measured 2026-10-07: protein20 k5 whole-protein index + decoys, 87 GB footprint to
            // build and fit, 71 GB resident to search 20 queries. One at a time on 128 GB.
            withLabel: kmerseek_search { cpus = 8;  maxForks = 1 }
        }
    }

    sherlock {
        // A failed sbatch ends the run unless Nextflow retries it. On 2026-10-14 one
        // submission failed with "Protocol authentication error" (SLURM's login service,
        // briefly) and stopped the full run with 97 searches running. The default retries
        // only "Socket timed out".
        executor {
            retry {
                reason     = '.*(Socket timed out|authentication error|failed to connect|Unable to contact slurm controller|Transport endpoint).*'
                maxAttempt = 10
                delay      = '30 sec'
                maxDelay   = '10 min'
            }
        }
        apptainer {
            enabled    = true
            autoMounts = true
            cacheDir   = "${System.getenv('SCRATCH') ?: System.getenv('HOME')}/apptainer-cache"
        }
        process {
            executor       = 'slurm'
            queue          = 'hns,normal'
            clusterOptions = '--account=ayeletv'
            cpus     = 2
            memory   = '16 GB'
            time     = '4h'
            maxForks = params.max_forks
            // Measured on the laptop 2026-10-06: the parse holds the whole feature table
            // (1.4 M rows) and 575_748 sequences; the decoy step holds one index in memory.
            withLabel: python { container = params.kmerseek_image; memory = '24 GB' }
            withLabel: mmseqs { container = params.mmseqs_image; cpus = 16
                                memory = { "${params.mmseqs_memory_gb * task.attempt} GB" }
                                time   = { "${params.mmseqs_hours * task.attempt}h" } }
            // Memory for both kmerseek processes is set in their process bodies (per
            // setting; see main.nf), so it must not be set here: a selector beats a body
            // directive.
            withLabel: kmerseek_index  { container = params.kmerseek_image; cpus = 8
                                time   = { "${params.kmerseek_index_hours * task.attempt}h" } }
            withLabel: kmerseek_search { container = params.kmerseek_image; cpus = 8
                                time   = { "${params.kmerseek_search_hours * task.attempt}h" } }
            // A scheduler kill reports Integer.MAX_VALUE, not 128-143 (global lessons).
            errorStrategy = { def st = task.exitStatus
                              (st == null || st == Integer.MAX_VALUE || st in 128..143) && task.attempt < 3
                                  ? 'retry' : 'terminate' }
            maxRetries = 2
            // withName beats the withLabel: python 24 GB above. `calls` is the staged list of
            // call files (a single path for MMseqs2 and the composition classifier); its
            // size() is the real file's (tested on Sherlock, Nextflow 25.04.7, 2026-10-16).
            // Only directives change here, not the script, so finished tasks stay cached.
            withName: scoreCalls {
                memory = { def gb = ((calls instanceof Collection ? calls : [calls]).sum { it.size() } as double) / 1.0e9
                           def whole = label.tokenize('.')[1] == 'whole'
                           def peak = whole
                               ? (params.score_calls_whole_base_gb as double) + (params.score_calls_whole_slope as double) * gb
                               : (params.score_calls_other_base_gb as double) + (params.score_calls_other_slope as double) * gb
                           def first = Math.max(params.score_calls_floor_gb as double,
                                                Math.ceil((params.score_calls_headroom as double) * peak))
                           "${Math.min(first * Math.pow(2, task.attempt - 1), params.score_calls_memory_max_gb as double) as long} GB" }
                time   = { def gb = ((calls instanceof Collection ? calls : [calls]).sum { it.size() } as double) / 1.0e9
                           def h = (params.score_calls_base_hours as double) + (params.score_calls_hours_per_gb as double) * gb
                           "${Math.ceil(h * task.attempt) as long}h" }
                // Retry a memory, walltime or scheduler kill with the doubled ask. Past that,
                // ignore rather than terminate: one label's loss should not cancel the other
                // labels' scoring. compareIndexes then runs on the labels that finished, the
                // log names each ignored task, and a later -resume scores only those.
                errorStrategy = { def st = task.exitStatus
                                  (st == null || st == Integer.MAX_VALUE || st in 128..143) && task.attempt < 3
                                      ? 'retry' : 'ignore' }
            }
        }
    }
}
