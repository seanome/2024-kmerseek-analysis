// Regions-index pilot. Two profiles: `local` (the laptop: conda Python and the repo's pixi
// MMseqs2, no containers) and `sherlock` (SLURM + Apptainer).

params.run_date = new java.text.SimpleDateFormat('yyyy-MM-dd').format(new java.util.Date())
// Read by the sherlock profile's process block, so declared here, not in main.nf (a config
// profile cannot see a param main.nf declares: Nextflow 25.04 stops with "Unknown config
// attribute process.params...").
params.kmerseek_image = 'docker.io/olgabot/kmerseek:0.4.0-rc5'
params.max_forks      = 50
// Same MMseqs2 image as invertebrate-dark-set's mmseqs2Search (olgabot/dark-set-kmerseek-0.4).
params.mmseqs_image   = 'quay.io/biocontainers/mmseqs2@sha256:3503bfe576d560e550df2872af86a1ad1bcc1c06cfb7caadd3e7a95649f5f0ef'
params.python         = 'python3'
params.mmseqs         = 'mmseqs'

workDir = "${launchDir}/work"

trace {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/regions_index_pilot.${params.run_date}.trace.txt"
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,container,cpus,time,memory,attempt,submit,start,complete,duration,realtime,%cpu,peak_rss,rchar,wchar'
}

profiles {
    local {
        params.python = '/Users/olga/anaconda3/envs/2025-kmerseek-analysis/bin/python3'
        // The pixi env lives in the main checkout only; a worktree has no .pixi folder.
        params.mmseqs = "${System.getenv('HOME')}/code/2024-kmerseek-analysis/.pixi/envs/mmseqs2/bin/mmseqs"
        process {
            executor = 'local'
            cpus     = 2
            memory   = '8 GB'
            withLabel: mmseqs { cpus = 8 }
        }
    }

    sherlock {
        apptainer {
            enabled    = true
            autoMounts = true
            cacheDir   = "${System.getenv('SCRATCH') ?: System.getenv('HOME')}/apptainer-cache"
        }
        process {
            executor       = 'slurm'
            queue          = 'hns,normal'
            clusterOptions = '--account=ayeletv'
            cpus     = 2
            memory   = '16 GB'
            time     = '4h'
            maxForks = params.max_forks
            // Measured on the laptop 2026-10-06: the parse holds the whole feature table
            // (1.4 M rows) and 575_748 sequences; the decoy step holds one index in memory.
            withLabel: python { container = params.kmerseek_image; memory = '24 GB' }
            withLabel: mmseqs { container = params.mmseqs_image; cpus = 16; memory = '32 GB' }
        }
    }
}
