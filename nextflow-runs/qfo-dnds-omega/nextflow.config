// qfo-dnds-omega/nextflow.config

def dateStr = new java.text.SimpleDateFormat('yyyy-MM-dd').format(new java.util.Date())

workDir = "${launchDir}/work"

trace {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/qfo_omega.${dateStr}.trace.txt"
    fields    = 'task_id,hash,process,tag,status,exit,cpus,memory,attempt,submit,start,complete,duration,realtime,%cpu,peak_rss'
}
timeline { enabled = true; overwrite = true; file = "${launchDir}/qfo_omega.${dateStr}.timeline.html" }
report   { enabled = true; overwrite = true; file = "${launchDir}/qfo_omega.${dateStr}.report.html" }

process {
    errorStrategy = { task.exitStatus in [-1, 130, 137, 140] ? 'retry' : 'terminate' }
    maxRetries    = 2

    // buildPairs holds both proteomes' CDS and the group dictionaries built from two
    // .idmapping files at once. Human's is the largest input at 73 MB of text, and
    // the dictionaries derived from it are the peak rather than the FASTAs.
    withLabel: pairing {
        cpus   = 1
        memory = '4 GB'
        time   = '1h'
    }

    // Measured at 0.1 s per pair on human-mouse, so a 250-pair chunk runs in well
    // under a minute. The limit is set far above that because codeml slows down a
    // lot on long alignments between distant species, where it spends longer
    // searching a likelihood surface that is flat in dS.
    withLabel: codeml {
        cpus   = 1
        memory = '2 GB'
        time   = '2h'
    }
}

docker {
    enabled    = true
    // See docker/Dockerfile.omega: Nextflow needs to exec /bin/bash inside the
    // container, so any ENTRYPOINT has to be out of the way.
    runOptions = '--entrypoint ""'
}

profiles {
    standard {
        executor {
            name   = 'local'
            cpus   = 8
            memory = '24 GB'
        }
    }

    // 20 pairs per species, one chunk each: enough to confirm the container, the
    // pairing, the codeml call and the .mlc parser end to end before committing to a
    // full run. Check that dS and omega differ in the output -- their being equal was
    // the bug in the previous pipeline.
    test {
        params {
            max_pairs  = 20
            chunk_size = 20
        }
        executor {
            name   = 'local'
            cpus   = 4
            memory = '8 GB'
        }
    }
}
