// Nextflow configuration for kmerseek SCOPe p-value benchmark

def dateFormat = new java.text.SimpleDateFormat('yyyy-MM-dd')
def today = dateFormat.format(new java.util.Date())

workDir = "${launchDir}/work"

trace {
    enabled = true
    file = "${launchDir}/kmerseek_scope_benchmark.${today}.trace.txt"
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes'
}

timeline {
    enabled   = true
    overwrite = true
    file = "${launchDir}/kmerseek_scope_benchmark.${today}.timeline.html"
}

report {
    enabled   = true
    overwrite = true
    file = "${launchDir}/kmerseek_scope_benchmark.${today}.report.html"
}

process {
    cpus = 1
    memory = '4 GB'
    time = '12h'

    withName: buildRelease {
        cpus = 2
        memory = '8 GB'
        time = '30m'
    }

    withName: indexDatabase {
        cpus = 2
        memory = '100 GB'
        time = '24h'
        maxForks = 1  // Each index uses 27-54 GB RAM, must run one at a time
    }

    withName: searchAllVsAll {
        cpus = 2
        memory = '100 GB'
        time = '24h'
        maxForks = 1  // Run 1 search at a time (TEA k=10 needs ~92GB, use 100GB to be safe)
    }

    withName: searchShuffledVsOriginal {
        cpus = 2
        memory = '100 GB'
        time = '24h'
        maxForks = 1
    }

    withName: parseScopeHeaders {
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }

    withName: evaluateScopeHierarchy {
        cpus = 1
        memory = '16 GB'
        time = '2h'
        container = 'kmerseek-analysis:latest'
    }

    withName: aggregateScopeResults {
        cpus = 1
        memory = '1 GB'
        time = '10m'
        container = 'kmerseek-analysis:latest'
    }
}

executor {
    name = 'local'
    cpus = 8
    memory = '110 GB'  // Leave ~18 GB for OS and other processes
}

docker {
    enabled = true
}
