// Nextflow configuration for SCOPe p-value benchmark k=31–45 rerun

def dateFormat = new java.text.SimpleDateFormat('yyyy-MM-dd')
def today = dateFormat.format(new java.util.Date())

workDir = "${launchDir}/work-k31-45"

trace {
    enabled = true
    file = "${launchDir}/kmerseek_scope_k31_45.${today}.trace.txt"
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar'
}

timeline {
    enabled = true
    file = "${launchDir}/kmerseek_scope_k31_45.${today}.timeline.html"
}

report {
    enabled = true
    file = "${launchDir}/kmerseek_scope_k31_45.${today}.report.html"
}

process {
    cpus   = 1
    memory = '4 GB'
    time   = '12h'

    withName: indexDatabase {
        cpus      = 2
        memory    = '100 GB'
        time      = '24h'
        maxForks  = 1   // Each index uses 27–54 GB RAM; run one at a time
    }

    withName: searchAllVsAll {
        cpus      = 2
        memory    = '100 GB'
        time      = '24h'
        maxForks  = 1   // Searches are memory-intensive; run one at a time
    }

    withName: evaluateScopeHierarchy {
        cpus      = 1
        memory    = '16 GB'
        time      = '2h'
        // No docker — uses conda Python shebang directly
    }
}

executor {
    name   = 'local'
    cpus   = 8
    memory = '110 GB'   // Leave ~18 GB for OS
}

// Docker disabled — evaluateScopeHierarchy uses the conda Python shebang
docker {
    enabled = false
}
