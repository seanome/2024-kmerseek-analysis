// Time-split test (notebook 280). Executor, queue and account as the dark-set run, so the
// two pipelines queue and account the same way. Nothing here is shared with that run:
// its own launch dir, work dir, index cache and outdir.

params.run_tag           = 'pilot'
params.max_forks         = 150
params.queue_size        = 300
params.submit_rate_limit = '15/1min'

process {
    // Every process retries any non-zero exit twice. Scheduler kills report
    // Integer.MAX_VALUE, which `in 128..143` would miss, so no exit list here.
    errorStrategy = { task.attempt < 3 ? 'retry' : 'finish' }
    maxRetries = 2
    // An index or a search that fails three times is dropped, not fatal: scoreTransfers
    // reads whatever arrived with collect(), and setting_summary lists each setting's
    // files, so a missing one shows as a setting with fewer chunks, not as zero recall.
    withName: 'kmerseekIndex|kmerseekSearch' {
        errorStrategy = { task.attempt < 3 ? 'retry' : 'ignore' }
    }
}

profiles {
    standard {
        docker { enabled = true }
        process { cpus = 2; memory = '8 GB' }
    }

    // `make stub`: the wiring on the laptop with -stub, no containers. Each process keeps its
    // own memory and time directives, so the trace shows the asks the Sherlock run would
    // make; the local executor is told it has 4 TB and 64 CPUs only so that it schedules
    // them. Stub tasks run a printf or two and use none of it.
    stub {
        docker { enabled = false }
        executor {
            name   = 'local'
            memory = '4 TB'
            cpus   = 64
        }
    }

    sherlock {
        process {
            executor       = 'slurm'
            queue          = 'hns,normal'
            clusterOptions = '--account=ayeletv'
            maxForks       = params.max_forks
        }
        executor {
            submitRateLimit = params.submit_rate_limit
            queueSize       = params.queue_size
        }
        apptainer {
            enabled    = true
            autoMounts = true
            cacheDir   = "${System.getenv('SCRATCH') ?: '.'}/apptainer-cache"
        }
    }
}

// One trace per run tag, so the pilot's timings survive the full run. memory and time are
// in it so the next sizing can compare each ask with its peak.
trace   { enabled = true; overwrite = true; file = "trace.${params.run_tag}.txt"
          fields = 'task_id,hash,name,status,exit,attempt,cpus,memory,time,realtime,%cpu,peak_rss,read_bytes,write_bytes,workdir' }
report  { enabled = true; overwrite = true; file = "report.${params.run_tag}.html" }
timeline{ enabled = true; overwrite = true; file = "timeline.${params.run_tag}.html" }
