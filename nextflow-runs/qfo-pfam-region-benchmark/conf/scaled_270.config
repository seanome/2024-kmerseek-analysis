// --scaled on the mini set (notebook 270). Passed with -c by `make run-mini-scaled-270`;
// nothing else reads it.
//
// Arms: every alphabet notebook 244 chose for a Swiss-Prot feature type, at the k it chose,
// mask on (244 chose among mask-on arms). protein20 k5 is both 244's MOTIF/SITE arm and the
// control at protein20's smallest k. Each crossed with scaled 1, 2, 5 and 10.
//
// Filters are open: one shared k-mer per pair, no whole-protein or region p-value cut. The
// notebook tests how many seeds survive subsampling, and any score cut would mix that with
// how the score itself moves with scaled. Region rows are cut in the notebook instead.
//
// Extension is set per run on the command line (--kmerseek_extend true|false), because
// result names do not record it: the two runs need separate outdirs. The run with
// extension off gives the exact seed runs; the one with it on gives the extended calls.

params {
    kmerseek_combos       = 'hp_lehninger_c_nonpolar2:18,hp_thomas_dill2:19,hp_thomas_dill_no_c2:19,hp_kyte_doolittle2:19,gbmr4:16,mmseqs12:7,sdm12:6,protein20:5'
    low_complexity_toggle = 'true'
    kmerseek_scaled       = '1,2,5,10'

    threshold        = 0.0
    min_shared_kmers = 1
    max_query_pvalue = 1.0   // OR'd with min_region_score, so this keeps every region

    // kmerseek and the truth tables only.
    skip_baselines   = true
    skip_foldseek    = true
    skip_folddisco   = true
    skip_reseek      = true
    skip_prostt5     = true
    skip_hhblits     = true
    skip_identity    = true
    skip_metapredict = true
    skip_multiqc     = true
    allow_thin_targets = true
}
