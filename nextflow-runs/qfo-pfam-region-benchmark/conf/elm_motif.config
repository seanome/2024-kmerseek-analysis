// ELM motif-transfer run (notebook 250). Passed with -c by `make run-elm-motif` and
// `make run-elm-motif-local`; nothing else reads it.
//
// Queries are the human proteins with an experimentally supported ELM instance. The target
// is every non-human protein with one (label elm_pooled), or the chicken ones alone for the
// dry run (elm_chicken). scripts/prep_elm_inputs.py stages both. The targets have no Pfam
// table, so the pipeline searches them and scores nothing; scoring is
// scripts/reduce_elm_landing.py.
//
// Every tool reports deep and is cut at the same list length (1000 per query) in scoring,
// not in the tool. The sequence-tool flags are the ones in
// nextflow-runs/invertebrate-dark-set/MATCHED-PERMISSIVE.md (branch
// olgabot/dark-set-kmerseek-0.4):
//   phmmer, jackhmmer  --max -E 1000 --domE 1000
//   mmseqs2            -s 7.5 -e 1000 --max-seqs 1000 --min-ungapped-score 0 --mask 0
//   kmerseek           --threshold 0 --min-shared-kmers 2 --max-query-pvalue 1
// That document does not cover HHblits, Foldseek, ProstT5 or Reseek. They get the same
// -e 1000 through params.evalue_report and otherwise run as in midi-plus.

params {
    kmerseek_extra_encodings = true      // every alphabet, polarity4 and funcgroups8 included
    low_complexity_toggle    = 'false,true'
    kmerseek_scaled          = '1,2,5,10'
    max_query_pvalue         = 1.0       // OR'd with min_region_score, so this keeps every match
    evalue_report            = 1000.0
    mmseqs2_sensitivity      = 7.5
    hmmer_extra_flags        = '--max --domE 1000'
    mmseqs2_extra_flags      = '--min-ungapped-score 0 --mask 0'

    skip_identity   = true   // Pfam-domain identity; the targets carry no Pfam table
    skip_metapredict = true  // disorder per motif comes from scripts/prep_elm_inputs.py
    skip_folddisco  = true   // not in the ELM comparison set
    skip_multiqc    = true   // the Pfam report has nothing to score here
    swissprot_dat   = null
    allow_thin_targets = true
}
