// ELM cover search (notebook 250). Passed with -c by `make run-elm-search`; nothing else reads it.
//
// Queries: the 1_303 human proteins with a usable experimental ELM instance
// (assets/elm_cover_query_accessions.txt). Targets: the nine QfO proteomes, whole. Inputs are
// staged by scripts/elm_cover_inputs.py (`make elm-cover-inputs`). The targets carry no Pfam
// table, so the pipeline searches and scores nothing; scoring is scripts/reduce_elm_cover.py.
//
// kmerseek: two seed lengths per alphabet from tables/250_two_k_per_alphabet.csv
// (scripts/elm_seed_floor.py): k_main, the shortest k whose seed is in fewer than 100 human
// proteins, and k_small, the shortest under 1_000 that fits the 128 GB search limit; four
// alphabets have only k_main. Every arm is extended (PR #52) with its alphabet's mismatch
// penalty from assets/kappa_by_alphabet.pfam_a_38.2_seed_pairs_20-30pct_identity.tsv;
// funcgroups8 has no kappa there and stays exact. Low-complexity mask off and on; scaled
// 1, 2, 5 and 10 (a smaller, subsampled database).
//
// Comparators report deep and are cut at list length 1000 per query in scoring. Filters as
// in nextflow-runs/invertebrate-dark-set/MATCHED-PERMISSIVE.md: phmmer and jackhmmer
// --max -E 1000 --domE 1000; MMseqs2 -s 7.5 -e 1000 --max-seqs 1000 --min-ungapped-score 0
// --mask 0. HHblits, Foldseek, ProstT5 and Reseek get -e 1000 through evalue_report.

params {
    kmerseek_combos          = 'protein20:5,uniprot18:5,hsdm17:5,wass14:5,mmseqs12:5,mmseqs12:6,sdm12:6,sdm12:7,dayhoff6:7,dayhoff6:9,wwmj5:8,wwmj5:9,gbmr7:10,gbmr7:13,gbmr4:12,gbmr4:14,hp_lehninger_hpc3:14,hp_lehninger_hpc3:17,hp_lehninger2:15,hp_lehninger2:17,hp_lehninger_c_nonpolar2:15,hp_lehninger_c_nonpolar2:18,hp_pbotc_1st_ed2:15,hp_pbotc_1st_ed2:18,hp_thomas_dill2:16,hp_thomas_dill2:19,hp_thomas_dill_no_c2:17,hp_thomas_dill_no_c2:20,hp_kyte_doolittle2:17,hp_kyte_doolittle2:20,polarity4:10,polarity4:12,funcgroups8:6,funcgroups8:7'
    kmerseek_extend          = true
    low_complexity_toggle    = 'false,true'
    kmerseek_scaled          = '1,2,5,10'
    max_query_pvalue         = 1.0       // OR'd with min_region_score, so this keeps every match
    evalue_report            = 1000.0
    mmseqs2_sensitivity      = 7.5
    hmmer_extra_flags        = '--max --domE 1000'
    mmseqs2_extra_flags      = '--min-ungapped-score 0 --mask 0'

    skip_identity    = true   // Pfam-domain identity; the targets carry no Pfam table here
    skip_metapredict = true   // disorder per motif comes from scripts/elm_stage0_flanks.py
    skip_folddisco   = true   // not in the comparison set
    skip_multiqc     = true   // the Pfam report has nothing to score here
    swissprot_dat    = null
    allow_thin_targets = true
}
