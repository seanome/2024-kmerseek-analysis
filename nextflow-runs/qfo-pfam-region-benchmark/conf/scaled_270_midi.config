// --scaled on the midi set (notebook 270): 964 human chromosome-6 queries against the nine
// full QfO proteomes. Passed with -c by `make run-scaled-270 S270_SET=midi`; nothing else
// reads it.
//
// Two arms, mask on as on the mini set, at scaled 1 and 5 only: hp_thomas_dill_no_c2 k19
// (notebook 244's arm for ZN_FING and DOMAIN) and protein20 k5 (the control at its
// smallest k). Filters open, as on the mini set.
//
// Every task runs with the local executor inside the head's one allocation (24 CPUs,
// 180 GB on a 192 GB hns node). Tasks last from about 10 s (index builds) to about 20 min
// (searches), so one Slurm job per task would be dozens of jobs under 10 minutes, against
// Sherlock's rule for automated tools (/etc/agents/AGENTS.md, rule 10). Per-task memory and
// time come from the trace; every task here outlasts Nextflow's first memory sample.
//
// Sizing, from the uncapped ELM cover run on chicken (run-elm-search, 2026-09-25, 1_303
// queries, extension on): hp_thomas_dill_no_c2 search peaks 68.6 GB at k17 and 19.3 GB at
// k20 against asks of 103 and 75.9 GB; protein20 k5 5.8 GB against 64.5 GB. All first
// attempts completed, the longest search in 20 min. The pipeline's own asks are kept; with
// 170 GB for tasks, two HP searches run at a time.

params {
    kmerseek_combos  = 'hp_thomas_dill_no_c2:19:s1:lctrue,hp_thomas_dill_no_c2:19:s5:lctrue,protein20:5:s1:lctrue,protein20:5:s5:lctrue'

    threshold        = 0.0
    min_shared_kmers = 1
    max_query_pvalue = 1.0   // OR'd with min_region_score, so this keeps every region

    skip_baselines   = true
    skip_foldseek    = true
    skip_folddisco   = true
    skip_reseek      = true
    skip_prostt5     = true
    skip_hhblits     = true
    skip_identity    = true
    skip_metapredict = true
    skip_multiqc     = true
}

process.executor = 'local'
executor {
    name   = 'local'
    cpus   = 24
    memory = '170 GB'
}
