# Nextflow run state and per-run reports: regenerated on every launch, and the
# trace/timeline/report names carry the run date so they pile up fast.
.nextflow/
.nextflow.log*
work/
run/
run-report/
results/
*.report.html
*.timeline.html
*.trace.txt

# Data staged onto the cluster by the sync-* targets, and the mini set regenerated there.
# These live inside the pipeline directory because every remote path is relative to it.
data/
run-mini/

# Symlink tree built and torn down by `make sync-data`.
.sync-staging/
