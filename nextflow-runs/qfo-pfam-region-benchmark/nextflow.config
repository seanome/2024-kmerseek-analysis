// Configuration for the QfO Pfam region/domain-finding benchmark.
//
// Two profiles: `standard` (local Docker, for smoke tests) and `sherlock`
// (SLURM + Apptainer, for the real sweep). See README-sherlock.md.

def dateFormat = new java.text.SimpleDateFormat('yyyy-MM-dd')
def today = dateFormat.format(new java.util.Date())

workDir = "${launchDir}/work"

trace {
    enabled = true
    overwrite = true
    file = "${launchDir}/qfo_pfam_region.${today}.trace.txt"
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes'
}

timeline {
    enabled   = true
    overwrite = true
    file = "${launchDir}/qfo_pfam_region.${today}.timeline.html"
}

report {
    enabled   = true
    overwrite = true
    file = "${launchDir}/qfo_pfam_region.${today}.report.html"
}

// Image carrying both the region-scoring kmerseek binary and python+polars, so the
// search arm and the scoring arm share one pull. Baseline tools use their own
// biocontainers, pinned per process in main.nf.
params.kmerseek_image = 'docker.io/olgabot/kmerseek:2026-08-18-region-scoring'

profiles {

    standard {
        process {
            cpus     = 2
            memory   = '16 GB'
            time     = '12h'
            maxForks = 4

            withLabel: high_cpu { cpus = 8;  memory = '32 GB' }
            withLabel: python   { cpus = 1;  memory = '32 GB' }

            withName: 'kmerseekIndexAndSearch|buildDomainTruth|scoreDomainCalls|scoreHmmscanCeiling|aggregateMetrics' {
                container = params.kmerseek_image
            }
        }

        executor {
            name   = 'local'
            cpus   = 8
            memory = '110 GB'
        }

        docker { enabled = true }
    }

    // Stanford Sherlock: each process is its own SLURM job on the `hns` school-condo
    // partition, billed to the ayeletv account. Check `sh_part` before a big submission --
    // hns is usually far shorter than the public `normal` partition, but not always.
    sherlock {
        process {
            executor       = 'slurm'
            queue          = 'hns'
            clusterOptions = '--account=ayeletv'
            cpus     = 4
            memory   = '32 GB'
            time     = '24h'
            maxForks = 60

            withLabel: high_cpu { cpus = 16; memory = '64 GB';  time = '48h' }
            // The eval joins a species' full region table against its domain map. HP
            // combos at low ksize produce the largest region tables in the sweep, so this
            // is sized for those rather than for the median combo.
            withLabel: python   { cpus = 2;  memory = '96 GB';  time = '12h' }

            withName: 'buildDomainTruth|scoreDomainCalls|scoreHmmscanCeiling|aggregateMetrics' {
                container = params.kmerseek_image
            }

            // memory/errorStrategy/maxRetries for kmerseekIndexAndSearch are set in main.nf,
            // not here: they need the task's own alphabet and ksize to size per-combo, and
            // config directives always beat script-declared ones in Nextflow. Setting them
            // here even as a "default" would silently override the per-combo sizing.
            withName: kmerseekIndexAndSearch {
                container = params.kmerseek_image
                time      = '48h'
            }
        }

        apptainer {
            enabled    = true
            autoMounts = true
            // $SCRATCH, never $HOME -- the home quota is small and image conversion is big.
            cacheDir   = "${System.getenv('SCRATCH') ?: '.'}/apptainer-cache"
        }
    }
}
