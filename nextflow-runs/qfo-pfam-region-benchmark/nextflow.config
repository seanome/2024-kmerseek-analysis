// Configuration for the QfO Pfam region/domain-finding benchmark.
//
// Two profiles: `standard` (local Docker, for smoke tests) and `sherlock`
// (SLURM + Apptainer, for the real sweep). See README-sherlock.md.

def dateFormat = new java.text.SimpleDateFormat('yyyy-MM-dd')
def today = dateFormat.format(new java.util.Date())

workDir = "${launchDir}/work"

// Where THIS run's trace is written. The MultiQC step reads it back for the resource
// sections, so it is named once here rather than reconstructed from a second date string
// that would drift the moment a run crossed midnight.
params.trace_file = "${launchDir}/qfo_pfam_region.${today}.trace.txt"

// The trace a `-entry report` run READS, from some earlier run. Deliberately a different
// param from the one above, and it switches this run's own trace off.
//
// Nextflow TRUNCATES its trace file as the run starts. When both roles shared one param,
// `--trace_file <the run I want reported on>` pointed the observer at that file and
// emptied it before the report could read a single row -- destroying the original run's
// resource data and silently producing blank resource sections.
params.report_trace = null

trace {
    enabled = params.report_trace == null
    overwrite = true
    file = params.trace_file
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes'
}

timeline {
    enabled   = true
    overwrite = true
    file = "${launchDir}/qfo_pfam_region.${today}.timeline.html"
}

report {
    enabled   = true
    overwrite = true
    file = "${launchDir}/qfo_pfam_region.${today}.report.html"
}

// Image carrying both the region-scoring kmerseek binary and python+polars, so the
// search arm and the scoring arm share one pull. Baseline tools use their own
// biocontainers, pinned per process in main.nf.
params.kmerseek_image = 'docker.io/olgabot/kmerseek:2026-08-24-reduced-alphabets'

// Declared HERE, not in main.nf, because a `withName:` selector below references it and
// nextflow.config is parsed before the script's params. Declared in main.nf it read as
// null at selector-resolution time and the whole withName block silently evaluated to
// empty -- Nextflow logs "Unknown config attribute" and carries on. That is why
// kmerseek_image lives here too, and why folddisco_image can stay in main.nf: nothing in
// config refers to it.
params.metapredict_image = 'docker.io/olgabot/metapredict:2026-08-27'

// Submission throttle for the sherlock profile. Deliberately conservative: the cost of
// being too slow is a longer run, the cost of being too fast is the run dying partway
// with every completed task still on storeDir but the scheduler refusing more work.
// Raise it once `sacctmgr` tells you the real ceiling.
params.kmerseek_time_hours = 6
// How many tasks of ONE process may be in flight. Separate knob from queue_size, which
// caps the whole run: with several arms active at once the global cap binds first, and
// with one arm active this one does.
//
// Safe to raise. Neither this nor queue_size changes the submission RATE, so neither can
// trip the site's per-hour cap -- only submit_rate_limit does. The ceiling to respect is
// `normal` QOS MaxSubmitJobsPerUser = 2000, counting pending plus running, across every
// run you have going.
//
// 400 by default. That is only safe because of the reservation below, which was built and
// probe-tested against exactly this pair -- on its own, `--max_forks 400 --queue_size 800`
// is the setting that starved the serial arms, since 400 + 400 is the entire pool.
params.max_forks = 400
params.submit_rate_limit = '15/1min'
// In-flight cap, well under the `normal` QOS MaxSubmitJobsPerUser = 2000 that counts
// pending plus running across every run you have going. Stated rather than inherited from
// Nextflow's default of 100 so the two limits are visible together, since they answer
// different questions.
params.queue_size        = 800

// Neither knob above RESERVES anything, and that is a third question they do not answer.
// maxForks is per process, queueSize is global, and nothing stops one process from holding
// every slot in the global pool. kmerseekIndex and kmerseekSearch are 3294 tasks each
// against single digits for every other arm, so they win that race every time. Three
// separate runs sat like this:
//
//   [-] buildQueryCovariates   [  0%] 0 of 1
//   [-] extractDomainSequences [  0%] 0 of 10
//   [8a/8063c1] kmerseekIndex  [ 76%] 2507 of 3294
//   [05/00be59] kmerseekSearch [ 67%] 1700 of 2507
//
// with every queued-or-running SLURM job a kmerseek one. The counts prove those tasks were
// CREATED and simply never reached the scheduler; the three processes showing `-` are
// downstream of extractDomainSequences. Raising queue_size, which was the first thing
// tried, made it worse rather than better: a bigger pool is a bigger thing for one arm to
// fill. The identity arm is the axis claim 1 is stated on and buildQueryCovariates
// produces every covariate the report stratifies on, so a run that finishes the sweep and
// scores nothing is not a useful run.
//
// The fix is to deny the bulk arm the whole pool. Shares rather than fixed slot counts,
// because the reservation has to survive `--queue_size 800 --max_forks 400`, which is what
// was on the command line when this was observed and is now the default above. It does
// survive: Nextflow seeds CLI params into the config binding BEFORE parsing this file, so
// the expressions below read an overridden --queue_size rather than the default. That is
// worth stating because the opposite is the natural assumption -- it was checked with a
// probe run, not assumed.
//
// At the defaults: bulkPool 600, so kmerseekIndex and kmerseekSearch get 300 each,
// folddiscoQuery gets 800 - 600 - 12 = 188, and 12 slots stay open for the serial arms.
params.bulk_queue_share = 0.75
// Slots no bulk or mid-tier arm may ever take. Sized on the widest genuinely serial arm,
// extractDomainSequences at 10 (nine species plus human), so the arms starved above always
// have somewhere to land.
params.serial_reserve   = 12

// maxForks is PER PROCESS and Nextflow has no shared fork pool across processes, so
// "kmerseekIndex and kmerseekSearch may hold N slots BETWEEN them" is not directly
// expressible. Bounding the sum means halving the pool and giving each process its own
// half. The cost is real and worth naming rather than discovering later: at the tail, when
// every index is built and only searches remain, search runs at half the width it could
// have had. That is the price of the guarantee, and it beats the current behaviour where
// the short arms get nothing at all.
def queueTotal = params.queue_size as int
def bulkPool   = Math.max(2, (queueTotal * (params.bulk_queue_share as double)) as int)
params.kmerseek_max_forks = Math.max(1, bulkPool.intdiv(2))

// folddiscoQuery is the only other process with this shape, and it was checked rather than
// assumed: it is 9 species x params.folddisco_chunks (20) = 180 tasks, where scoreDomainCalls
// is 27 (one per truth set per species, 3 x 9, after the groupTuple batching change) and
// every other process is 18 or fewer. 180 cannot swamp the pool the way 6588 can, but it
// can take the entire remainder under --max_forks 400, which puts the serial arms right
// back where they started. It gets the remainder minus the reserve.
//
// The three caps sum to queueTotal - serial_reserve by construction. Below roughly
// queue_size 40 the reserve shrinks instead of holding; nothing is run at that size here,
// but the guarantee is not unconditional.
params.folddisco_max_forks = Math.max(1, queueTotal - bulkPool - (params.serial_reserve as int))

profiles {

    standard {
        process {
            cpus     = 2
            memory   = '16 GB'
            time     = '12h'
            maxForks = 4

            withLabel: high_cpu { cpus = 8;  memory = '32 GB' }

            // Container comes from the LABEL, not a list of process names. The name-list
            // version silently omitted buildSwissprotTruth, buildQueryCovariates and
            // folddiscoMerge as they were added, and a process with no container runs on
            // the host, where polars does not exist -- failing with ModuleNotFoundError
            // rather than anything that points at the config. Every python process
            // already carries this label, so new ones are covered automatically.
            withLabel: python {
                cpus = 1
                memory = '32 GB'
                container = params.kmerseek_image
            }

            // Container only. scoreDomainCalls sizes its own memory from the input file --
            // setting memory here would override that, which is what the python label was
            // silently doing.
            withLabel: python_scoring { cpus = 1; container = params.kmerseek_image }

            // No `container` here, deliberately. These two take theirs from a dynamic
            // directive in main.nf that reads the task's own image, so an alphabet that
            // needs a newer kmerseek build gets one WITHOUT changing params.kmerseek_image
            // for everything else that reads it -- every python-labelled process included.
            // A config selector beats a process directive, so setting it here would take
            // that choice away and silently put every task back on one image.
            // See the sherlock profile: withLabel 'python' would otherwise win.
            withName: proteomeDisorder { container = params.metapredict_image }
        }

        executor {
            name   = 'local'
            cpus   = 8
            memory = '110 GB'
        }

        docker { enabled = true }
    }

    // Stanford Sherlock: each process is its own SLURM job on the `hns` school-condo
    // partition, billed to the ayeletv account. Check `sh_part` before a big submission --
    // hns is usually far shorter than the public `normal` partition, but not always.
    sherlock {
        process {
            executor       = 'slurm'
            queue          = 'hns'
            clusterOptions = '--account=ayeletv'
            cpus     = 4
            memory   = '32 GB'
            time     = '24h'
            maxForks = params.max_forks

            // 12h, not 48h. The longest high_cpu task that has ever COMPLETED is
            // jackhmmerSearch at 2.76h, so 48h was 17x the worst case. SLURM backfills gaps
            // with jobs that fit, and a job declaring 48h fits almost none -- the request
            // itself was buying queue time. Doubles on retry via task.attempt.
            //
            // reseekSearch is excluded below, and the reason is a trap worth naming: this
            // 12h was derived from COMPLETED tasks, and reseekSearch has never completed
            // one. Every reseekSearch row in every trace on this project is ABORTED with no
            // realtime, so the single longest-running process in the pipeline contributed
            // nothing to the measurement that was used to shorten its own walltime.
            // Measuring finishers to bound a limit that kills non-finishers is circular.
            withLabel: high_cpu { cpus = 16; memory = '64 GB'
                                  time = { Math.min(12 * task.attempt, 48) + 'h' } }

            // Keeps the full QOS MaxWall. Live jobs have been observed past 26h still
            // running, and none has ever been seen to finish, so there is no measurement to
            // size this from -- only evidence that 12h is definitely too short. 48h is the
            // ceiling `normal` allows; if reseek needs more than that it needs the `long`
            // QOS, which permits 4 running jobs, or it needs investigating rather than
            // rescheduling.
            withName: reseekSearch { time = '48h' }
            // The eval joins a species' full region table against its domain map. HP
            // combos at low ksize produce the largest region tables in the sweep, so this
            // is sized for those rather than for the median combo.
            // Container by label, not by process name -- see the standard profile.
            withLabel: python {
                cpus = 2
                memory = '96 GB'
                time = '12h'
                container = params.kmerseek_image
            }

            // Container and cpus only. BOTH memory and time now come from main.nf --
            // scoreMemory() from the largest regions file, scoreTime() from the total --
            // and a `time` here would silently win over the script-declared one, which is
            // the same trap the note above records for memory.
            withLabel: python_scoring { cpus = 2; container = params.kmerseek_image }

            // memory/errorStrategy/maxRetries for kmerseekIndexAndSearch are set in main.nf,
            // not here: they need the task's own alphabet and ksize to size per-combo, and
            // config directives always beat script-declared ones in Nextflow. Setting them
            // here even as a "default" would silently override the per-combo sizing.
            // withName, not the script body. proteomeDisorder carries `label 'python'` for
            // its cpus and memory, and `withLabel: python` above sets container =
            // kmerseek_image -- a config selector beats a directive declared in the process
            // body, so `container params.metapredict_image` in main.nf lost silently and the
            // task died with ModuleNotFoundError inside the wrong image. Same rule the
            // memory note above records; withName outranks withLabel, so this wins.
            withName: proteomeDisorder { container = params.metapredict_image }

            withName: 'kmerseekIndex|kmerseekSearch' {
                // Container comes from main.nf's dynamic directive, not from here -- see
                // the note in the local profile above.
                // Half the bulk pool each, so the two together can never hold more than
                // params.bulk_queue_share of queueSize. This overrides the blanket
                // `maxForks = params.max_forks` above -- a withName selector beats a bare
                // process block -- which is what stops --max_forks 400 from reopening the
                // starvation.
                maxForks  = params.kmerseek_max_forks
                // 6h base rather than a flat 48h. The slowest kmerseek task ever measured
                // is fly_dayhoff_k10 at 1.95h across 189 tasks at FULL query scale, so 48h
                // was 25x the worst case and 864x the median. `normal` QOS caps MaxWall at
                // exactly 2 days, so every task was asking for the most the QOS allows and
                // could only be scheduled in a full-size gap.
                //
                // A walltime kill arrives as SIGTERM, exit 143, which the errorStrategy in
                // main.nf already retries -- so the multiplier matters: without it a retry
                // would hit the same wall it just died on.
                time      = { Math.min((params.kmerseek_time_hours as int) * task.attempt, 48) + 'h' }
            }

            // --- right-sized against the 2026-08-20 trace -------------------------
            // The `high_cpu` label asks for 16 cores and 64 GB. Three processes earn it:
            // foldseekSearch (1484% CPU), mmseqs2Search (1446%) and domainIdentity
            // (1385%). The rest measured 77-532% and were paying for the request twice --
            // once in cores nobody used, and again in queue time, because on `hns` a
            // 16-core ask waits 14.6 m median against 3.0 m for a 2-4 core ask. Over the
            // whole run that was 117 h queued against 98 h running.
            //
            // Each number below is the measured median %cpu and max peak_rss for that
            // process, rounded up. Re-measure before trusting them on another partition.
            // maxForks here is the second-tier reservation, not a resource number: 180
            // tasks against the reserve, see params.folddisco_max_forks.
            withName: folddiscoQuery  { cpus = 4; memory = '16 GB'   // used 2.0 cores, 2.4 GB
                                        maxForks = params.folddisco_max_forks }
            withName: hhblitsSearch   { cpus = 2; memory = '8 GB'  }  // hhsearch is -cpu 1
            withName: hhblitsBuildDB  { cpus = 8; memory = '16 GB' }  // used 5.3 cores, 2.3 GB
            withName: phmmerSearch    { cpus = 8 }                    // used 4.1 cores, 46.4 GB -- keeps 64 GB
            withName: jackhmmerSearch { cpus = 8 }                    // used 3.4 cores, 16.2 GB -- keeps 64 GB
            // Genuinely parallel, but 36 s of work behind a 23.6 m queue wait. Eight cores
            // roughly doubles its runtime and cuts the wait by more than that.
            withName: domainIdentity   { cpus = 8; memory = '16 GB' }

            // ProstT5 3Di prediction is a 3B-parameter forward pass and always wants a GPU.
            // hns has gpu:4, so this stays on the condo partition. --nv is what exposes the
            // CUDA runtime inside the container; without it foldseek's --gpu 1 fails at
            // runtime rather than falling back.
            // cpus/memory stay as prostt5Db declares them -- only the allocation and the
            // container flag belong here, since those are cluster facts, not task sizing.
            withName: prostt5Db {
                clusterOptions   = '--account=ayeletv --gres=gpu:1'
                containerOptions = '--nv'
            }

            // The two search arms that have a GPU path. Their allocation is per TASK, not
            // per process: --gpu_benchmark runs the CPU and GPU arms of the same process in
            // one session, and a blanket --gres here would put a GPU request in front of
            // the CPU tasks too, inflating exactly the queue-wait number the benchmark is
            // trying to measure. A dynamic directive resolves in the task's own context, so
            // `gpu` here is that task's input value.
            //
            // hns has gpu:4 against 8-9 foldseek and 18 mmseqs tasks, so a GPU run
            // serialises 4 at a time where a CPU run spreads over maxForks. Per-task time
            // and wall-clock time can point in opposite directions because of that; both
            // are reported, see bin/gpu_search_benchmark.py.
            withName: 'foldseekSearch|mmseqs2Search' {
                clusterOptions   = { gpu ? '--account=ayeletv --gres=gpu:1' : '--account=ayeletv' }
                containerOptions = { gpu ? '--nv' : null }
            }

            // Padding is a plain CPU pass over the database. No GPU, and it needs the
            // walltime of a createdb rather than of a search.
            withName: 'mmseqsPaddedDb|foldseekPaddedDb' {
                cpus   = 8
                memory = '32 GB'
                time   = '4h'
            }

            // Its container is declared in main.nf, like every other third-party tool.
            // Only the resource shape belongs here: the report is one short single-threaded
            // pass over a few parquet files.
            withName: multiqcReport {
                cpus   = 2
                memory = '16 GB'
                time   = '2h'
            }
        }

        // Sherlock throttles job SUBMISSION per hour, separately from how many may run at
        // once. Hitting it aborts the whole run:
        //   sbatch: error: Reached jobs per hour limit
        //   sbatch: error: Job violates accounting/QOS policy (job submit limit, ...)
        // and it happened with only ~45 jobs in the queue, so queueSize and maxForks are
        // the wrong knobs -- neither limits the RATE.
        //
        // This pipeline is submission-heavy by construction: 3294 kmerseekIndex plus 3294
        // kmerseekSearch (splitting those two doubled the count), ~10_100 scoreDomainCalls
        // across three truth sets, 180 folddiscoQuery and ~100 baselines, so roughly 17_000
        // sbatch calls for one full sweep.
        //
        // Check your own ceiling before raising this, since it is a per-user QOS setting:
        //   sacctmgr -n show assoc user=$USER format=account,qos,maxsubmitjobs
        //   sacctmgr -n show qos format=name,maxsubmitjobsperuser,maxjobsperuser
        executor {
            submitRateLimit = params.submit_rate_limit
            queueSize       = params.queue_size
        }

        apptainer {
            enabled    = true
            autoMounts = true
            // $SCRATCH, never $HOME -- the home quota is small and image conversion is big.
            cacheDir   = "${System.getenv('SCRATCH') ?: '.'}/apptainer-cache"
            // Converting a multi-layer OCI image to SIF on a busy login node is slow, and
            // the default 20m expired mid-pull. Only matters on a cold cache: `make
            // prefetch-images` populates it serially beforehand, which is what actually
            // prevents the concurrent-pull corruption this guards against.
            pullTimeout = '60m'
        }
    }

    // Declared LAST on purpose. Nextflow applies profiles in the order they are DECLARED
    // in this file, not the order given to -profile: `-profile sherlock,mini` and
    // `-profile mini,sherlock` produce byte-identical config. While this block sat above
    // `sherlock`, every one of its overrides lost, so `make run-mini` silently requested
    // sherlock-sized resources -- 16 cpus and 64 GB for high_cpu, 96 GB for python, 48h
    // for kmerseek -- on a 200-protein test set. Anything layered on top of another
    // profile has to be declared below it.
    //
    // Smoke test on the mini data set (bin/make_mini_testset.py): a few hundred
    // sequences, two species, a couple of combos. Layered on top of `sherlock` or
    // `standard` with -profile sherlock,mini -- it overrides only what scale requires,
    // so it exercises the same code path the real run takes.
    mini {
        params.kmerseek_memory         = '8 GB'
        params.kmerseek_memory_hp_lowk = '16 GB'
        params.folddisco_chunks        = 2

        // prostt5Search sets cpus/memory/time in its process body, which a blanket
        // `process { ... }` here cannot override -- only these params can.
        // Neither cpus nor memory is lowered here -- see the note on params.prostt5_memory
        // in main.nf. The model, not the data set, sets both floors, and a smoke test that
        // takes hours is not a smoke test.
        params.prostt5_time            = '2h'

        process {
            cpus   = 2
            memory = '8 GB'
            time   = '2h'

            withLabel: high_cpu { cpus = 4; memory = '16 GB'; time = '2h' }
            withLabel: python   { cpus = 1; memory = '16 GB'; time = '1h' }
            withLabel: python_scoring { cpus = 1; time = '1h' }

            withName: 'kmerseekIndex|kmerseekSearch' { time = '2h' }

            // A `withName:` selector beats a blanket `process { cpus = ... }` whichever
            // profile declares it, so the sherlock-sized padding jobs have to be named
            // again here or a 200-protein smoke test asks for 8 cores and 32 GB.
            withName: 'mmseqsPaddedDb|foldseekPaddedDb' {
                cpus   = 2
                memory = '8 GB'
                time   = '1h'
            }
        }
    }

}
