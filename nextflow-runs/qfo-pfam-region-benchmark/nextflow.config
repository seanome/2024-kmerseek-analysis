// Configuration for the QfO Pfam region/domain-finding benchmark.
//
// Two profiles: `standard` (local Docker, for smoke tests) and `sherlock`
// (SLURM + Apptainer, for the real sweep). See README-sherlock.md.

def dateFormat = new java.text.SimpleDateFormat('yyyy-MM-dd')
def today = dateFormat.format(new java.util.Date())

workDir = "${launchDir}/work"

// Where THIS run's trace is written. The MultiQC step reads it back for the resource
// sections, so it is named once here rather than reconstructed from a second date string
// that would drift the moment a run crossed midnight.
params.trace_file = "${launchDir}/qfo_pfam_region.${today}.trace.txt"

// The trace a `-entry report` run READS, from some earlier run. Deliberately a different
// param from the one above, and it switches this run's own trace off.
//
// Nextflow TRUNCATES its trace file as the run starts. When both roles shared one param,
// `--trace_file <the run I want reported on>` pointed the observer at that file and
// emptied it before the report could read a single row -- destroying the original run's
// resource data and silently producing blank resource sections.
params.report_trace = null

trace {
    enabled = params.report_trace == null
    overwrite = true
    file = params.trace_file
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes'
}

timeline {
    enabled   = true
    overwrite = true
    file = "${launchDir}/qfo_pfam_region.${today}.timeline.html"
}

report {
    enabled   = true
    overwrite = true
    file = "${launchDir}/qfo_pfam_region.${today}.report.html"
}

// Image carrying both the region-scoring kmerseek binary and python+polars, so the
// search arm and the scoring arm share one pull. Baseline tools use their own
// biocontainers, pinned per process in main.nf.
params.kmerseek_image = 'docker.io/olgabot/kmerseek:2026-08-24-reduced-alphabets'

profiles {

    standard {
        process {
            cpus     = 2
            memory   = '16 GB'
            time     = '12h'
            maxForks = 4

            withLabel: high_cpu { cpus = 8;  memory = '32 GB' }

            // Container comes from the LABEL, not a list of process names. The name-list
            // version silently omitted buildSwissprotTruth, buildQueryCovariates and
            // folddiscoMerge as they were added, and a process with no container runs on
            // the host, where polars does not exist -- failing with ModuleNotFoundError
            // rather than anything that points at the config. Every python process
            // already carries this label, so new ones are covered automatically.
            withLabel: python {
                cpus = 1
                memory = '32 GB'
                container = params.kmerseek_image
            }

            // Container only. scoreDomainCalls sizes its own memory from the input file --
            // setting memory here would override that, which is what the python label was
            // silently doing.
            withLabel: python_scoring { cpus = 1; container = params.kmerseek_image }

            withName: 'kmerseekIndex|kmerseekSearch' { container = params.kmerseek_image }
        }

        executor {
            name   = 'local'
            cpus   = 8
            memory = '110 GB'
        }

        docker { enabled = true }
    }

    // Stanford Sherlock: each process is its own SLURM job on the `hns` school-condo
    // partition, billed to the ayeletv account. Check `sh_part` before a big submission --
    // hns is usually far shorter than the public `normal` partition, but not always.
    sherlock {
        process {
            executor       = 'slurm'
            queue          = 'hns'
            clusterOptions = '--account=ayeletv'
            cpus     = 4
            memory   = '32 GB'
            time     = '24h'
            maxForks = 60

            withLabel: high_cpu { cpus = 16; memory = '64 GB';  time = '48h' }
            // The eval joins a species' full region table against its domain map. HP
            // combos at low ksize produce the largest region tables in the sweep, so this
            // is sized for those rather than for the median combo.
            // Container by label, not by process name -- see the standard profile.
            withLabel: python {
                cpus = 2
                memory = '96 GB'
                time = '12h'
                container = params.kmerseek_image
            }

            // Container and walltime only -- memory comes from scoreMemory() in main.nf.
            withLabel: python_scoring { cpus = 2; time = '12h'; container = params.kmerseek_image }

            // memory/errorStrategy/maxRetries for kmerseekIndexAndSearch are set in main.nf,
            // not here: they need the task's own alphabet and ksize to size per-combo, and
            // config directives always beat script-declared ones in Nextflow. Setting them
            // here even as a "default" would silently override the per-combo sizing.
            withName: 'kmerseekIndex|kmerseekSearch' {
                container = params.kmerseek_image
                time      = '48h'
            }

            // --- right-sized against the 2026-08-20 trace -------------------------
            // The `high_cpu` label asks for 16 cores and 64 GB. Three processes earn it:
            // foldseekSearch (1484% CPU), mmseqs2Search (1446%) and domainIdentity
            // (1385%). The rest measured 77-532% and were paying for the request twice --
            // once in cores nobody used, and again in queue time, because on `hns` a
            // 16-core ask waits 14.6 m median against 3.0 m for a 2-4 core ask. Over the
            // whole run that was 117 h queued against 98 h running.
            //
            // Each number below is the measured median %cpu and max peak_rss for that
            // process, rounded up. Re-measure before trusting them on another partition.
            withName: folddiscoQuery  { cpus = 4; memory = '16 GB' }  // used 2.0 cores, 2.4 GB
            withName: hhblitsSearch   { cpus = 2; memory = '8 GB'  }  // hhsearch is -cpu 1
            withName: hhblitsBuildDB  { cpus = 8; memory = '16 GB' }  // used 5.3 cores, 2.3 GB
            withName: phmmerSearch    { cpus = 8 }                    // used 4.1 cores, 46.4 GB -- keeps 64 GB
            withName: jackhmmerSearch { cpus = 8 }                    // used 3.4 cores, 16.2 GB -- keeps 64 GB
            // Genuinely parallel, but 36 s of work behind a 23.6 m queue wait. Eight cores
            // roughly doubles its runtime and cuts the wait by more than that.
            withName: domainIdentity   { cpus = 8; memory = '16 GB' }

            // ProstT5 3Di prediction is a 3B-parameter forward pass and always wants a GPU.
            // hns has gpu:4, so this stays on the condo partition. --nv is what exposes the
            // CUDA runtime inside the container; without it foldseek's --gpu 1 fails at
            // runtime rather than falling back.
            // cpus/memory stay as prostt5Db declares them -- only the allocation and the
            // container flag belong here, since those are cluster facts, not task sizing.
            withName: prostt5Db {
                clusterOptions   = '--account=ayeletv --gres=gpu:1'
                containerOptions = '--nv'
            }

            // The two search arms that have a GPU path. Their allocation is per TASK, not
            // per process: --gpu_benchmark runs the CPU and GPU arms of the same process in
            // one session, and a blanket --gres here would put a GPU request in front of
            // the CPU tasks too, inflating exactly the queue-wait number the benchmark is
            // trying to measure. A dynamic directive resolves in the task's own context, so
            // `gpu` here is that task's input value.
            //
            // hns has gpu:4 against 8-9 foldseek and 18 mmseqs tasks, so a GPU run
            // serialises 4 at a time where a CPU run spreads over maxForks. Per-task time
            // and wall-clock time can point in opposite directions because of that; both
            // are reported, see bin/gpu_search_benchmark.py.
            withName: 'foldseekSearch|mmseqs2Search' {
                clusterOptions   = { gpu ? '--account=ayeletv --gres=gpu:1' : '--account=ayeletv' }
                containerOptions = { gpu ? '--nv' : null }
            }

            // Padding is a plain CPU pass over the database. No GPU, and it needs the
            // walltime of a createdb rather than of a search.
            withName: 'mmseqsPaddedDb|foldseekPaddedDb' {
                cpus   = 8
                memory = '32 GB'
                time   = '4h'
            }

            // Its container is declared in main.nf, like every other third-party tool.
            // Only the resource shape belongs here: the report is one short single-threaded
            // pass over a few parquet files.
            withName: multiqcReport {
                cpus   = 2
                memory = '16 GB'
                time   = '2h'
            }
        }

        apptainer {
            enabled    = true
            autoMounts = true
            // $SCRATCH, never $HOME -- the home quota is small and image conversion is big.
            cacheDir   = "${System.getenv('SCRATCH') ?: '.'}/apptainer-cache"
            // Converting a multi-layer OCI image to SIF on a busy login node is slow, and
            // the default 20m expired mid-pull. Only matters on a cold cache: `make
            // prefetch-images` populates it serially beforehand, which is what actually
            // prevents the concurrent-pull corruption this guards against.
            pullTimeout = '60m'
        }
    }

    // Declared LAST on purpose. Nextflow applies profiles in the order they are DECLARED
    // in this file, not the order given to -profile: `-profile sherlock,mini` and
    // `-profile mini,sherlock` produce byte-identical config. While this block sat above
    // `sherlock`, every one of its overrides lost, so `make run-mini` silently requested
    // sherlock-sized resources -- 16 cpus and 64 GB for high_cpu, 96 GB for python, 48h
    // for kmerseek -- on a 200-protein test set. Anything layered on top of another
    // profile has to be declared below it.
    //
    // Smoke test on the mini data set (bin/make_mini_testset.py): a few hundred
    // sequences, two species, a couple of combos. Layered on top of `sherlock` or
    // `standard` with -profile sherlock,mini -- it overrides only what scale requires,
    // so it exercises the same code path the real run takes.
    mini {
        params.kmerseek_memory         = '8 GB'
        params.kmerseek_memory_hp_lowk = '16 GB'
        params.folddisco_chunks        = 2

        // prostt5Search sets cpus/memory/time in its process body, which a blanket
        // `process { ... }` here cannot override -- only these params can.
        // Neither cpus nor memory is lowered here -- see the note on params.prostt5_memory
        // in main.nf. The model, not the data set, sets both floors, and a smoke test that
        // takes hours is not a smoke test.
        params.prostt5_time            = '2h'

        process {
            cpus   = 2
            memory = '8 GB'
            time   = '2h'

            withLabel: high_cpu { cpus = 4; memory = '16 GB'; time = '2h' }
            withLabel: python   { cpus = 1; memory = '16 GB'; time = '1h' }
            withLabel: python_scoring { cpus = 1; time = '1h' }

            withName: 'kmerseekIndex|kmerseekSearch' { time = '2h' }

            // A `withName:` selector beats a blanket `process { cpus = ... }` whichever
            // profile declares it, so the sherlock-sized padding jobs have to be named
            // again here or a 200-protein smoke test asks for 8 cores and 32 GB.
            withName: 'mmseqsPaddedDb|foldseekPaddedDb' {
                cpus   = 2
                memory = '8 GB'
                time   = '1h'
            }
        }
    }

}
