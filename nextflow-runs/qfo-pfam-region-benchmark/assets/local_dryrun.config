// Local dry runs only (make run-disprot-local). Nextflow's local executor counts 8 of this
// Mac's CPUs, and the standard profile gives a high_cpu task (phmmer, jackhmmer, hmmscan)
// all 8, so one such task runs at a time and every other task waits behind it.
executor {
    cpus   = 14
    memory = '110 GB'
}
process {
    withLabel: high_cpu { cpus = 4 }
}
