// Any param a profile reads is set here, not only in main.nf: Nextflow 25.04 refuses a
// config that reads a param only the script defines.
params.max_forks         = 100
params.queue_size        = 100
params.submit_rate_limit = '15/1min'
params.kmerseek_image    = 'docker.io/olgabot/kmerseek:0.4.0-pr141-3c353d4'
params.run_tag           = 'convergence-afp'

process {
    cpus   = 2
    memory = '8 GB'
    time   = '4h'
    errorStrategy = { task.attempt < 3 ? 'retry' : 'finish' }
    maxRetries = 2
}

profiles {
    // Laptop: Docker, small asks. For the test target, which runs on a cut reference.
    standard {
        docker { enabled = true }
        process {
            cpus = 2
            memory = '6 GB'
            withLabel: high_cpu       { cpus = 4; memory = '8 GB' }
            withLabel: kmerseek       { cpus = 4 }
            withLabel: python_scoring { cpus = 2; memory = '8 GB' }
            withName: 'scans|foldseekQueryDbs|foldseekSearch' { memory = '8 GB' }
        }
    }
    sherlock {
        process {
            executor       = 'slurm'
            queue          = 'hns,normal'
            clusterOptions = '--account=ayeletv'
            maxForks       = params.max_forks
            withLabel: high_cpu { cpus = 16; memory = { "${32 * task.attempt} GB" } }
            withLabel: kmerseek { cpus = 8 }
            withName: jackhmmerSearch { cpus = 16; memory = { "${32 * task.attempt} GB" } }
        }
        executor {
            submitRateLimit = params.submit_rate_limit
            queueSize       = params.queue_size
        }
        apptainer {
            enabled    = true
            autoMounts = true
            cacheDir   = "${System.getenv('SCRATCH') ?: '.'}/apptainer-cache"
        }
    }
}

trace {
    enabled = true; overwrite = true; file = "trace.${params.run_tag}.txt"
    fields = 'task_id,hash,name,tag,status,exit,attempt,cpus,memory,time,realtime,%cpu,peak_rss,read_bytes,write_bytes'
}
report   { enabled = true; overwrite = true; file = "report.${params.run_tag}.html" }
timeline { enabled = true; overwrite = true; file = "timeline.${params.run_tag}.html" }
