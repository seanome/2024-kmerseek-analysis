// nextflow.config — AlphaFold + FoldSeek validation for 336 outside-benchmark proteins

def dateFormat = new java.text.SimpleDateFormat('yyyy-MM-dd')
def today = dateFormat.format(new java.util.Date())

workDir = "${launchDir}/work"

trace {
    enabled = true
    file    = "${launchDir}/alphafold_foldseek_336.${today}.trace.txt"
    fields  = 'task_id,hash,native_id,process,tag,name,status,exit,container,cpus,time,memory,attempt,submit,start,complete,duration,realtime,%cpu,%mem,rss,peak_rss'
}

timeline {
    enabled = true
    file    = "${launchDir}/alphafold_foldseek_336.${today}.timeline.html"
}

report {
    enabled = true
    file    = "${launchDir}/alphafold_foldseek_336.${today}.report.html"
}

// ---------------------------------------------------------------------------
// Process resource labels
// ---------------------------------------------------------------------------

process {
    errorStrategy = { task.exitStatus in [-1, 130, 137, 140] ? 'retry' : 'terminate' }
    maxRetries    = 3

    withLabel: medium_cpu {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = '12h'
    }

    withLabel: python {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = '4h'
    }

    withName: fetchQueryUniprotIds {
        cpus   = 1
        memory = '2 GB'
        time   = '2h'
    }

    withName: fetchRefUniprotIds {
        // SCOPe-40 has ~11K domains; allow more time for API calls
        cpus   = 1
        memory = '2 GB'
        time   = '8h'
    }

    withName: downloadAF2Structures {
        cpus     = 1
        memory   = '2 GB'
        time     = '12h'
        maxForks = 1   // one download batch at a time to respect EBI rate limits
    }

    withName: foldseekSearch {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = '12h'
    }

    withName: compareToKmerseek {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = '1h'
    }
}

// ---------------------------------------------------------------------------
// Executor
// ---------------------------------------------------------------------------

executor {
    name   = 'local'
    cpus   = 8
    memory = '32 GB'
}

// ---------------------------------------------------------------------------
// Docker (for FoldSeek)
// ---------------------------------------------------------------------------

docker {
    enabled    = true
    runOptions = '--entrypoint ""'
}
