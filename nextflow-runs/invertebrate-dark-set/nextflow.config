// Dark-set run. Same executor, queue and account conventions as
// nextflow-runs/qfo-pfam-region-benchmark -- deliberately, so a job from this pipeline
// queues and accounts exactly like its neighbours.

params.kmerseek_image = 'docker.io/olgabot/kmerseek:2026-08-24-reduced-alphabets'
params.max_forks      = 20

// Every process gets an errorStrategy. The default is 'terminate', which cancels every
// task still running, so one killed task takes the whole run with it. A task killed by the
// scheduler -- cgroup OOM, walltime, preemption, node failure -- reports
// exitStatus == Integer.MAX_VALUE, NOT a value in 128..143, so the common
// `task.exitStatus in 128..143` idiom never fires on the cases it was written for.
// The attempt cap lives inside the closure and every path out of it ends at 'finish', so
// an exhausted retry does not fail the run either.
process {
    errorStrategy = { task.attempt < 3 &&
                      (task.exitStatus == null ||
                       task.exitStatus == Integer.MAX_VALUE ||
                       task.exitStatus in 128..143)
                      ? 'retry' : 'finish' }
    maxRetries = 2
}

profiles {
    standard {
        process {
            cpus = 2
            memory = '8 GB'
            withLabel: high_cpu       { cpus = 8; memory = '32 GB' }
            withLabel: python_scoring { cpus = 1; container = params.kmerseek_image }
        }
        docker { enabled = true }
    }

    sherlock {
        process {
            executor       = 'slurm'
            queue          = 'hns'
            clusterOptions = '--account=ayeletv'
            cpus     = 4
            memory   = '32 GB'
            time     = '24h'
            maxForks = params.max_forks

            // jackhmmer at 3 iterations against 572_700 reviewed sequences is the long pole
            // here and has no measured runtime in this direction yet, so this starts at 12h
            // and doubles on retry rather than claiming a bound nothing has established.
            withLabel: high_cpu       { cpus = 16; memory = '64 GB'
                                        time = { Math.min(12 * task.attempt, 48) + 'h' } }
            withLabel: python_scoring { cpus = 2; memory = '32 GB'
                                        container = params.kmerseek_image }
        }
        apptainer {
            enabled    = true
            autoMounts = true
            cacheDir   = "${System.getenv('SCRATCH') ?: '.'}/apptainer-cache"
        }
    }
}

// One file per run, not one file per pipeline. The mini and the full run share a launch
// directory, so a single trace.txt meant the full run truncated the mini's timings the
// moment it started -- and those timings were the only measurement of how long an arm
// actually takes, which is what the full run's walltime and chunk size were sized on.
// Declared HERE, not in main.nf: the config is parsed first, so a params value
// defined in the script is not visible to it. The mini target passes --run_tag mini.
params.run_tag = 'full'

trace   { enabled = true; overwrite = true; file = "trace.${params.run_tag}.txt"
          fields = 'task_id,hash,name,status,exit,realtime,%cpu,peak_rss,read_bytes,write_bytes' }
report  { enabled = true; overwrite = true; file = "report.${params.run_tag}.html" }
timeline{ enabled = true; overwrite = true; file = "timeline.${params.run_tag}.html" }
