// Dark-set run. Same executor, queue and account conventions as
// nextflow-runs/qfo-pfam-region-benchmark -- deliberately, so a job from this pipeline
// queues and accounts exactly like its neighbours.

params.kmerseek_image = 'docker.io/olgabot/kmerseek:2026-08-24-reduced-alphabets'
// Per PROCESS, not per run. 20 is right for a single species, whose long pole is 23
// jackhmmer chunks; a ladder sweep has ~14_800 searches and wants the region benchmark's
// shape (--max_forks 150 --queue_size 400), which the Makefile's ladder target passes.
params.max_forks         = 20
params.submit_rate_limit = '15/1min'
params.queue_size        = 100

// metapredict is not in the kmerseek image, so darkSetDisorder gets its own. Same tag as
// qfo-pfam-region-benchmark uses, so the two pipelines score disorder with one predictor
// version rather than two that could drift apart.
params.metapredict_image     = 'docker.io/olgabot/metapredict:2026-08-27'
// null means "use metapredict's own default" rather than a number copied here that would
// silently diverge from the package's if it ever changed.
params.metapredict_threshold = null

// Every process gets an errorStrategy. The default is 'terminate', which cancels every
// task still running, so one killed task takes the whole run with it.
//
// Any non-zero exit is retried, up to three attempts, and every path out of the closure
// ends at 'finish' so an exhausted retry does not fail the run either. This used to
// enumerate the exit codes worth retrying -- null, Integer.MAX_VALUE (what a scheduler
// kill actually reports; NOT 128..143), and 128..143 -- and twice in one day on Sherlock
// the run was taken down by an infrastructure flake with a code outside that list:
//   exit 1    mmseqs `Cannot close index file tmp/.../aln_0.index.1`, a 0-byte per-thread
//             index beside a 536 KB data file, on 2 of 23 chunks (2026-09-11)
//   exit 255  apptainer `squashfuse_ll failed to mount ... in 10s`, the hmmer image never
//             mounted so phmmer never ran, on 1 of 23 chunks (2026-09-11)
// Every process here is deterministic on its inputs, so a real error fails three times
// and still stops the run; the cost of the blanket rule is two wasted attempts on a real
// bug, against a whole run lost to a node that could not mount an image.
process {
    errorStrategy = { task.attempt < 3 ? 'retry' : 'finish' }
    maxRetries = 2

    // The report is the last thing a run does, after every search and every scoring task
    // has already succeeded. Failing a finished proteome over a plot throws away days of
    // searching, so inside a full run this arm is allowed to fail and the run still ends
    // green -- every JSON and parquet is published either way.
    //
    // In a `-entry darkReport` run the report IS the work, so there it must fail loudly.
    // params.report_only is set only by that entry, which makes it the discriminator.
    //
    // Declared HERE and not in the process body: a config-level directive always beats one
    // declared in the process, so a body errorStrategy would lose to the generic setting
    // above without saying anything. A withName selector outranks that generic setting.
    withName: 'buildDarkMultiqcInputs|darkMultiqcReport' {
        errorStrategy = { params.report_only ? 'terminate' : 'ignore' }
    }
}

profiles {
    standard {
        process {
            cpus = 2
            memory = '8 GB'
            withLabel: high_cpu       { cpus = 8; memory = '32 GB' }
            withLabel: python_scoring { cpus = 1; container = params.kmerseek_image }
            // cpus only. Memory for both kmerseek processes is a per-combo closure in
            // main.nf, and a selector here would silently replace it -- see the note on
            // kmerseekIndex in main.nf for which config settings beat a body directive.
            withName: 'kmerseekIndex|kmerseekSearch' { cpus = 8 }

            // Container AND resources for darkSetDisorder live here, not in the process
            // body: a body directive loses silently to any config SELECTOR (withName,
            // withLabel) -- though not, as measured 2026-09-14, to the generic
            // `cpus`/`memory` two lines up. withName outranks every withLabel, so this is
            // the one place these are guaranteed to take effect. metapredict is
            // single-threaded per sequence, so the cpus buy nothing beyond the container.
            withName: darkSetDisorder { container = params.metapredict_image
                                        cpus = 2; memory = '16 GB' }
        }
        docker { enabled = true }
    }

    sherlock {
        process {
            executor       = 'slurm'
            queue          = 'hns'
            clusterOptions = '--account=ayeletv'
            cpus     = 4
            memory   = '32 GB'
            time     = '24h'
            maxForks = params.max_forks

            // jackhmmer at 3 iterations against 572_700 reviewed sequences is the long pole
            // here and has no measured runtime in this direction yet, so this starts at 12h
            // and doubles on retry rather than claiming a bound nothing has established.
            withLabel: high_cpu       { cpus = 16; memory = '64 GB'
                                        time = { Math.min(12 * task.attempt, 48) + 'h' } }

            // cpus and time ONLY for the two kmerseek processes. Their memory is a
            // per-combo closure in the process body (kmerseekIndexMemory and
            // kmerseekSearchMemory in main.nf), and a withName or withLabel selector
            // setting memory here would silently replace it -- measured on 2026-09-14
            // with Nextflow 25.10: a body directive beats the generic `process {}` block
            // but loses to any selector. The flat [64, 128, 180] GB ladder that used to
            // live here was cgroup-killed on 7 of 23 Botryllus chunks and cost six wasted
            // attempts; the per-combo model asks for the measured peak the first time.
            //
            // 8 cpus, not high_cpu's 16. The Botryllus searches used 2-5 cores of 16, and
            // at 60-130 GB a search is memory-bound on a 192 GB / 24-core hns node: two
            // 8-cpu searches fit where one 16-cpu search left the rest of the node idle.
            // Index builds took 5-10 min and searches 3-30 min on Botryllus, so 4h is a
            // bound, doubled on retry.
            withName: 'kmerseekIndex|kmerseekSearch' {
                cpus = 8
                time = { Math.min(4 * task.attempt, 24) + 'h' }
            }
            withLabel: python_scoring { cpus = 2; memory = '32 GB'
                                        container = params.kmerseek_image }

            // See the standard profile for why this is a withName and not a process-body
            // directive. 45_339 Botryllus proteins is one metapredict pass over the whole
            // proteome in a single task: the largest proteome in qfo-pfam-region-benchmark
            // peaked at 11.80 GB, so 32 GB has real headroom. The time starts at 8h and
            // doubles on retry rather than claiming a bound nothing here has measured;
            // the global errorStrategy handles the scheduler kill that a too-short
            // walltime produces, which reports exitStatus == Integer.MAX_VALUE.
            withName: darkSetDisorder { container = params.metapredict_image
                                        cpus = 4; memory = '32 GB'
                                        time = { Math.min(8 * task.attempt, 24) + 'h' } }
        }
        // Sherlock throttles job SUBMISSION per hour separately from how many may run,
        // and hitting it aborts the run (`sbatch: error: Reached jobs per hour limit`).
        // A ladder sweep is ~17_000 sbatch calls -- 1_647 indexes, ~14_800 searches, 243
        // sequence-arm chunks -- so the rate is the binding knob, not queueSize. The
        // values are the region benchmark's, which ran a sweep of the same shape under
        // them. queueSize is the in-flight cap, under the `normal` QOS
        // MaxSubmitJobsPerUser = 2000 that counts pending plus running across every run.
        executor {
            submitRateLimit = params.submit_rate_limit
            queueSize       = params.queue_size
        }

        apptainer {
            enabled    = true
            autoMounts = true
            cacheDir   = "${System.getenv('SCRATCH') ?: '.'}/apptainer-cache"
        }
    }

    // Wiring check only: `nextflow run main.nf -profile stub -stub-run ...` runs every
    // process's `stub:` block on the local executor with no container and no data,
    // which is what verifies that N species x M chunks x K combos fan out and regroup
    // per species without waiting for a reference build. Declared LAST: Nextflow
    // applies profiles in the order they are declared here, not the order on the
    // command line, and a layered profile declared above the one it overrides loses.
    stub {
        docker.enabled    = false
        apptainer.enabled = false
        // The per-combo kmerseek memory model still runs in a stub run and the local
        // executor refuses a task that asks for more than the machine has, so the cap
        // and both floors come down together; the model is exercised, the ask is not.
        params.kmerseek_memory_max          = '1 GB'
        params.kmerseek_memory_first_max    = '1 GB'
        params.kmerseek_skip_factor         = 0.001
        params.kmerseek_search_memory_floor = '1 GB'
        params.kmerseek_index_memory_floor  = '1 GB'
        process {
            executor = 'local'
            cpus     = 1
            memory   = '1 GB'
            withLabel: high_cpu { cpus = 1; memory = '1 GB' }
            withName: 'kmerseekIndex|kmerseekSearch' { cpus = 1 }
        }
    }
}

// One file per run, not one file per pipeline. The mini and the full run share a launch
// directory, so a single trace.txt meant the full run truncated the mini's timings the
// moment it started -- and those timings were the only measurement of how long an arm
// actually takes, which is what the full run's walltime and chunk size were sized on.
// Declared HERE, not in main.nf: the config is parsed first, so a params value
// defined in the script is not visible to it. The mini target passes --run_tag mini.
params.run_tag = 'full'

trace   { enabled = true; overwrite = true; file = "trace.${params.run_tag}.txt"
          fields = 'task_id,hash,name,status,exit,realtime,%cpu,peak_rss,read_bytes,write_bytes' }
report  { enabled = true; overwrite = true; file = "report.${params.run_tag}.html" }
timeline{ enabled = true; overwrite = true; file = "timeline.${params.run_tag}.html" }
