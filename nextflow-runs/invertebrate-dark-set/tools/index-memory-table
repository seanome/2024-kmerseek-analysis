#!/usr/bin/env python3
"""The memory each kmerseek index build needs on its FIRST attempt, from the builds a run has
already tried, written as assets/kmerseek_index_memory_measured.tsv for main.nf to read.

    tools/index-memory-table runs/ladder-0.4-midi [more run folders] > assets/kmerseek_index_memory_measured.tsv
    tools/index-memory-table --searches runs/ladder-0.4-midi [...] > assets/kmerseek_search_memory_measured.tsv

With --searches it does the same for kmerseekSearch, keyed by the index each search reads
(minus_<clade>.<alphabet>.k<k>[.s<scaled>].lc<mask>), since that index sets the memory: every
chunk and arm over one index gets the table's first ask. A search killed behind a pipe exits
1, not 137 (the pipe reports the last command's status), so a search attempt counts as killed
when its .command.err says "Killed" as well as on exit 137 or 135. On 2026-09-30 that was 337
killed search attempts in the 0.4 runs, 328 of them showing exit 1.

For every kmerseekIndex attempt in the runs' .nextflow.log* it reads the index name, the exit
status and the work folder, and from the work folder the memory the attempt asked for
(#SBATCH --mem). Then, per alphabet, k and scaled, over every clade:

  a larger ask built     first ask = the largest ask that built
  otherwise              first ask = 2 x the largest killed ask, capped at 500 GB
  never killed           no row: main.nf's model is enough

"Otherwise" includes a setting that built at the same ask another clade was killed at: on
2026-09-30 gbmr4 k21 scaled 1 built at 63 GB in one clade and was killed at 63 GB in
another, and the first version of this rule kept 63.

A kill is exit 137 or 135 (the cgroup memory killer). Exit "-" is a task the scheduler ended
(walltime, node failure) and says nothing about memory, so it is not counted. The measured
peak is not used: RocksDB's file pages fill whatever the cgroup allows, so a build that asked
63 GB reads back a 62.98 GB peak whatever it needed.

With --searches --times it writes assets/kmerseek_search_time_measured.tsv instead: the
walltime, in whole hours, a search's FIRST attempt asks for, keyed by index the same way.

  a search hit the limit  first ask = 2 x the largest limit hit (exit 140, or "-"), unless a
                          search with a larger limit finished, then that limit
  none did                first ask = 1.5 x the longest finished search, rounded up
  either way              a row only when that is above the default 4 h, capped at 24 h

The finished time is `realtime` in the attempt's .command.trace. Added 2026-10-02: two
human hsdm17 k5 searches hit the 4 h limit after others on the same index took 3.9 h, so
their retry waited in the queue again for an 8 h ask.

Python 3.6, standard library only, for Sherlock's login node.
"""

import glob
import os
import re
import sys
from collections import defaultdict

PROCESS = "kmerseekSearch" if "--searches" in sys.argv else "kmerseekIndex"
DONE = re.compile(r"Task completed > TaskHandler\[jobId: \S+; id: \d+; name: \S*" + PROCESS + r" "
                  r"\(([^)]*)\); status: \S+; exit: (\S+); error: [^;]*; workDir: (\S+) ")
INDEX = re.compile(r"(minus_[A-Za-z]+\.[A-Za-z0-9_]+\.k\d+(?:\.s\d+)?\.lc(?:true|false))\.kmerseek\.rocksdb")


def search_key(workdir):
    """The index a search read, from its .command.sh, as the table key."""
    try:
        m = INDEX.search(open(os.path.join(workdir, ".command.sh"), errors="replace").read())
    except OSError:
        return None
    return m.group(1) if m else None


def was_killed(workdir, status):
    if status in KILLED:
        return True
    if PROCESS != "kmerseekSearch" or status == "0":
        return False
    try:
        return "Killed" in open(os.path.join(workdir, ".command.err"), errors="replace").read()[-8000:]
    except OSError:
        return False
NAME = re.compile(r"^minus_[A-Za-z]+\.(.+)\.k(\d+)(?:\.s(\d+))?\.lc(true|false)$")
MEM = re.compile(r"^#SBATCH --mem[= ](\d+)([MG]?)")
WALL = re.compile(r"^#SBATCH -t (?:(\d+)-)?(\d+):(\d+):(\d+)")
TIMES = "--times" in sys.argv
WALL_KILLED = {"140", "-"}
DEFAULT_H = 4
CAP_H = 24
KILLED = {"137", "135"}
CAP_GB = 500


def asked_gb(workdir):
    try:
        with open(os.path.join(workdir, ".command.run")) as fh:
            for line in fh:
                m = MEM.match(line)
                if m:
                    mb = int(m.group(1)) * (1024 if m.group(2) == "G" else 1)
                    return mb / 1024.0
                if line.startswith("### name"):
                    return None
    except OSError:
        return None
    return None


def asked_h(workdir):
    """The walltime an attempt asked for, in hours, from its #SBATCH -t line."""
    try:
        with open(os.path.join(workdir, ".command.run")) as fh:
            for line in fh:
                m = WALL.match(line)
                if m:
                    d, h, mi, se = (int(x or 0) for x in m.groups())
                    return d * 24 + h + mi / 60.0 + se / 3600.0
                if line.startswith("### name"):
                    return None
    except OSError:
        return None
    return None


def ran_h(workdir):
    """How long a finished attempt ran, in hours, from realtime (ms) in .command.trace."""
    try:
        with open(os.path.join(workdir, ".command.trace")) as fh:
            for line in fh:
                if line.startswith("realtime="):
                    return int(line.split("=", 1)[1]) / 3600000.0
    except (OSError, ValueError):
        return None
    return None


def times(attempts):
    longest = defaultdict(float)
    hit = defaultdict(list)
    done_limit = defaultdict(float)
    for wd, (_name, status) in attempts.items():
        k = search_key(wd)
        if k is None:
            continue
        if status == "0":
            r = ran_h(wd)
            if r is not None:
                longest[k] = max(longest[k], r)
            a = asked_h(wd)
            if a is not None:
                done_limit[k] = max(done_limit[k], a)
        elif status in WALL_KILLED:
            a = asked_h(wd)
            if a is not None:
                hit[k].append(a)
    print("index\tfirst_ask_h\tbasis")
    rows = 0
    for k in sorted(set(longest) | set(hit)):
        if hit.get(k):
            if done_limit.get(k, 0) > max(hit[k]):
                h, basis = done_limit[k], "largest limit a search finished in, above every limit hit"
            else:
                h, basis = 2 * max(hit[k]), "twice the largest limit hit"
        else:
            h, basis = 1.5 * longest[k], "1.5 x the longest finished search"
        h = min(CAP_H, int(-(-h // 1)))
        if h > DEFAULT_H:
            print("{}\t{}\t{}".format(k, h, basis))
            rows += 1
    sys.stderr.write("{} attempts read, {} indexes with a first ask above {} h\n".format(
        len(attempts), rows, DEFAULT_H))


def main():
    attempts = {}
    for run in [a for a in sys.argv[1:] if not a.startswith("--")]:
        for log in sorted(glob.glob(os.path.join(run, ".nextflow.log*"))):
            with open(log, errors="replace") as fh:
                for line in fh:
                    m = DONE.search(line)
                    if m:
                        attempts[m.group(3)] = (m.group(1), m.group(2))
    if TIMES:
        if PROCESS != "kmerseekSearch":
            sys.exit("--times needs --searches")
        times(attempts)
        return
    ok = defaultdict(list)
    killed = defaultdict(list)
    for wd, (name, status) in attempts.items():
        gb = asked_gb(wd)
        if gb is None:
            continue
        if PROCESS == "kmerseekSearch":
            k = search_key(wd)
            if k is None:
                continue
            key = (k,)
        else:
            m = NAME.match(name)
            if not m:
                continue
            key = (m.group(1), int(m.group(2)), int(m.group(3) or 1))
        if status == "0":
            ok[key].append(gb)
        elif was_killed(wd, status):
            killed[key].append(gb)
    print("index\tfirst_ask_gb\tbasis" if PROCESS == "kmerseekSearch"
          else "alphabet\tksize\tscaled\tfirst_ask_gb\tbasis")
    for key in sorted(killed):
        if ok.get(key) and max(ok[key]) > max(killed[key]):
            gb, basis = max(ok[key]), "largest ask that built, above every killed ask"
        else:
            gb, basis = min(CAP_GB, 2 * max(killed[key])), "twice the largest killed ask"
        print("\t".join([str(x) for x in key] + [str(int(round(gb))), basis]))
    sys.stderr.write("{} attempts read, {} alphabet x k x scaled with a kill\n".format(len(attempts), len(killed)))


if __name__ == "__main__":
    main()
