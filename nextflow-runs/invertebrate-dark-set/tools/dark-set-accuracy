        sys.exit(__doc__)
    cmd, args = sys.argv[1], sys.argv[2:]
    if cmd == "best-targets" and len(args) == 2:
        best_targets(*args)
    elif cmd == "query-pfam-uniprot" and len(args) == 2:
        query_pfam_uniprot(*args)
    elif cmd == "score" and len(args) == 8:
        score(*args)
    elif cmd == "plan-regions" and len(args) == 3:
        plan_regions(*args)
    elif cmd == "best-regions" and len(args) == 3:
        best_regions(*args)
    elif cmd == "query-domains-interpro" and len(args) == 2:
        query_domains_interpro(*args)
    elif cmd == "realign-prepare" and len(args) == 4:
        realign_prepare(*args)
    elif cmd == "realign-collect" and len(args) == 2:
        realign_collect(*args)
