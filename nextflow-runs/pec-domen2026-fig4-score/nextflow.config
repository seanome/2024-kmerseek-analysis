// Notebook 361, Fig. 4C-D score from reads. No `def` here: Nextflow 26 rejects declarations in configs.

params {
    run_date = new java.text.SimpleDateFormat('yyyy-MM-dd_HHmm').format(new java.util.Date())
}

workDir = "${launchDir}/work"

trace {
    enabled   = true
    overwrite = false
    file      = "${launchDir}/fig4-score.${params.run_date}.trace.txt"
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,cpus,time,memory,attempt,submit,start,complete,duration,realtime,%cpu,%mem,rss,peak_rss,workdir'
}

process {
    // A scheduler kill reports Integer.MAX_VALUE (not 137/140). Retry it and memory or time kills
    // twice with more memory and time. Any other failure, or a third kill, lets running tasks end and
    // stops the run with an error: with 12 counting tasks a missing one must not pass unnoticed.
    errorStrategy = { def s = task.exitStatus
                      (s == null || s == Integer.MAX_VALUE || s in 128..143) && task.attempt <= 2
                          ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: build { cpus = 4;  memory = { 8.GB * task.attempt };  time = { 30.min * task.attempt } }
    // time is set per share of reads in main.nf; sizing evidence is in this folder's README
    withLabel: count { cpus = 16; memory = { 4.GB * task.attempt } }
}

profiles {
    sherlock {
        process {
            executor       = 'slurm'
            queue          = 'normal,hns'
            clusterOptions = '--account=ayeletv'
        }
        executor {
            queueSize       = 20
            submitRateLimit = '10/1min'
            pollInterval    = '30 sec'
        }
    }
}
