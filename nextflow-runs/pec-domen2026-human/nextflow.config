// Notebook 361, human exercise series. No `def` here: Nextflow 26 rejects declarations in configs.

params {
    pec_root  = null
    out_root  = null
    code_dir  = null
    series    = 'GSE99963,GSE144304,GSE120862'
    contrasts = ''
    reuse_dir = ''
    label_swap = false
    routes    = 'compactors_p05,kamrat_deseq2_p05'
    compactors_num_kmers = 1
    run_date  = new java.text.SimpleDateFormat('yyyy-MM-dd_HHmm').format(new java.util.Date())
}

workDir = "${launchDir}/work"

trace {
    enabled   = true
    overwrite = false
    file      = "${launchDir}/pec361-human.${params.run_date}.trace.txt"
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,cpus,time,memory,attempt,submit,start,complete,duration,realtime,%cpu,%mem,rss,peak_rss,workdir'
}
timeline { enabled = true; overwrite = false; file = "${launchDir}/pec361-human.${params.run_date}.timeline.html" }
report   { enabled = true; overwrite = false; file = "${launchDir}/pec361-human.${params.run_date}.report.html" }

// First asks: the Botryllus traces (README of ../pec-domen2026 and
// analysis/pec-domen2026-splash/exports/paper_recovery/resources.tsv), scaled by input size;
// see this folder's README for the table. Retries double memory and time.
process {
    // A scheduler kill reports Integer.MAX_VALUE (not 137/140); retry it and memory/time kills
    // (137, 140, 128..143) twice, then ignore that one task, so one contrast cannot stop the rest.
    errorStrategy = { def s = task.exitStatus
                      (s == null || s == Integer.MAX_VALUE || s in 128..143) && task.attempt <= 2
                          ? 'retry' : 'ignore' }
    maxRetries    = 2

    // a corrupted or stalled transfer exits 1 or 22; a fresh attempt fixes it, so retry any failure
    withLabel: download     { cpus = 1;  memory = { 2.GB * task.attempt };   time = { 12.h * task.attempt }
                              errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }; maxRetries = 3 }
    withLabel: fastp        { cpus = 4;  memory = { 8.GB * task.attempt };   time = { 2.h * task.attempt } }
    withLabel: db           { cpus = 16; memory = { 64.GB * task.attempt };  time = { 6.h * task.attempt } }
    withLabel: small_mem    { cpus = 2;  memory = { 32.GB * task.attempt };  time = { 2.h * task.attempt } }
    withLabel: splash       { cpus = 32; memory = { 128.GB * task.attempt }; time = { 12.h * task.attempt } }
    withLabel: compactors   { cpus = 32; memory = { 96.GB * task.attempt };  time = { 12.h * task.attempt } }
    // about 4 times the anchors of the corrected list, which peaked at 33.3 GB in 6 min
    withLabel: compactors_p05 { cpus = 32; memory = { 96.GB * task.attempt }; time = { 4.h * task.attempt } }
    withLabel: dekupl       { cpus = 32; memory = { 64.GB * task.attempt };  time = { 24.h * task.attempt } }
    withLabel: kamrat       { cpus = 4;  memory = { 64.GB * task.attempt };  time = { 12.h * task.attempt } }
    // kamrat_deseq and search: lowered 2026-11-03 from 128 and 96 GB, which waited over 90 min in the
    // queue; human peaks were 15.5 GB (41 samples) and 26.2 GB
    withLabel: kamrat_deseq { cpus = 16; memory = { 32.GB * task.attempt };  time = { 24.h * task.attempt } }
    withLabel: search       { cpus = 16; memory = { 48.GB * task.attempt };  time = { 24.h * task.attempt } }
}

profiles {
    sherlock {
        process {
            executor       = 'slurm'
            queue          = 'normal,hns'
            clusterOptions = '--account=ayeletv'
        }
        executor {
            queueSize       = 40
            submitRateLimit = '10/1min'
            pollInterval    = '1 min'
        }
    }
    // Label swaps use the same samples as the real contrasts, so asks are 1.4-2x the real peaks
    // (exports/human/resources_by_process.tsv: SPLASH 10.7 GB, 5 min; compactors 33.3 GB, 6 min;
    // DE-kupl 57.1 GB, 67 min; KaMRaT 7.7 GB, 36 min; KaMRaT + DESeq2 15.5 GB, 11 min; search 31.1 GB,
    // 10 min). Lower asks start sooner. Retries still double memory and time.
    // Fig. 4 groups: the largest has 84 samples and 3,971 M reads, about 6 times the GSE120862
    // contrasts, whose peaks scale these asks: DE-kupl 26.6 GB, 59 min; KaMRaT + DESeq2 7.9 GB, 8 min.
    // Search has only the 31.1 GB peak on far fewer sequences.
    fig4 {
        process {
            withLabel: dekupl       { cpus = 32; memory = { 160.GB * task.attempt }; time = { 12.h * task.attempt } }
            withLabel: kamrat_deseq { cpus = 16; memory = { 64.GB * task.attempt };  time = { 4.h * task.attempt } }
            withLabel: search       { cpus = 16; memory = { 96.GB * task.attempt };  time = { 12.h * task.attempt } }
        }
    }
    label_swap {
        process {
            // a withLabel block here replaces the one above, so cpus and memory are repeated
            withLabel: splash       { cpus = 32; memory = { 24.GB * task.attempt }; time = { 1.h * task.attempt } }
            withLabel: compactors   { cpus = 32; memory = { 48.GB * task.attempt }; time = { 1.h * task.attempt } }
            withLabel: dekupl       { cpus = 32; memory = { 64.GB * task.attempt }; time = { 4.h * task.attempt } }
            withLabel: kamrat       { cpus = 4;  memory = { 16.GB * task.attempt }; time = { 3.h * task.attempt } }
            withLabel: kamrat_deseq { cpus = 16; memory = { 32.GB * task.attempt }; time = { 2.h * task.attempt } }
            withLabel: search       { cpus = 16; memory = { 48.GB * task.attempt }; time = { 2.h * task.attempt } }
        }
    }
}
