// nextflow.config — Pfam benchmark tools comparison pipeline

def dateFormat = new java.text.SimpleDateFormat('yyyy-MM-dd')
def today = dateFormat.format(new java.util.Date())

workDir = "${launchDir}/work"

trace {
    enabled = true
    file    = "${launchDir}/pfam_benchmark_tools.${today}.trace.txt"
    fields  = 'task_id,hash,native_id,process,tag,name,status,exit,container,cpus,time,memory,attempt,submit,start,complete,duration,realtime,%cpu,%mem,rss,peak_rss'
}

timeline {
    enabled = true
    file    = "${launchDir}/pfam_benchmark_tools.${today}.timeline.html"
}

report {
    enabled = true
    file    = "${launchDir}/pfam_benchmark_tools.${today}.report.html"
}

// ---------------------------------------------------------------------------
// Process resource labels
// ---------------------------------------------------------------------------

process {
    errorStrategy = { task.exitStatus in [-1, 130, 137, 140] ? 'retry' : 'terminate' }
    maxRetries    = 3

    withLabel: medium_cpu {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = '12h'
    }

    withLabel: high_cpu {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = '24h'
    }

    withLabel: python {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = '4h'
        // No container; uses conda Python via shebang in script
    }

    withLabel: gpu_or_high_cpu {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = '24h'
        // For PSALM: add GPU resource if available
        // accelerator = 1   // uncomment if GPU is available
    }

    // Per-process overrides
    withName: diamondMakeDB {
        cpus     = 4
        memory   = { 8.GB * task.attempt }
        maxForks = 4
    }

    withName: diamondSearch {
        cpus     = 4
        memory   = { 8.GB * task.attempt }
        time     = '48h'
        maxForks = 1    // disk-space limited: ultra-sensitive uses ~10 GB tmp per run
    }

    withName: mmseqs2EasySearch {
        cpus     = 4
        memory   = { 16.GB * task.attempt }
        maxForks = 3    // MMseqs2 uses tmp disk; limit concurrency
    }

    withName: hmmer3Phmmer {
        cpus     = 4
        memory   = { 16.GB * task.attempt }
        time     = '48h'    // phmmer on full proteomes can be slow
        maxForks = 2        // amd64 image runs under Rosetta on arm64; limit concurrency
    }

    withName: hmmer3Hmmscan {
        cpus     = 8
        memory   = { 8.GB * task.attempt }
        time     = '48h'
        maxForks = 3
    }

    withName: hmmer3HmmscanPairScores {
        cpus     = 1
        memory   = { 4.GB * task.attempt }
        maxForks = 9
    }

    withName: hhblitsBuildDB {
        cpus     = 8
        memory   = { 32.GB * task.attempt }
        time     = '48h'
        maxForks = 2
    }

    withName: hhblitsBuildQueryProfiles {
        cpus     = 8
        memory   = { 32.GB * task.attempt }
        time     = '48h'
        maxForks = 1
    }

    withName: hhblitsSearch {
        cpus     = 8
        memory   = { 16.GB * task.attempt }
        time     = '48h'
        maxForks = 2
    }

    withName: psalmAnnotate {
        cpus     = 8
        memory   = { 32.GB * task.attempt }
        time     = '24h'
        maxForks = 2
    }

    withName: evaluateBenchmark {
        cpus     = 1
        memory   = { 4.GB * task.attempt }
        maxForks = 9
    }

    withName: aggregateMetrics {
        cpus     = 1
        memory   = '4 GB'
    }
}

// ---------------------------------------------------------------------------
// Executor
// ---------------------------------------------------------------------------

executor {
    name   = 'local'
    cpus   = 12        // leave 4 CPUs free on a 16-core machine
    memory = '64 GB'
}

// ---------------------------------------------------------------------------
// Docker
// ---------------------------------------------------------------------------

docker {
    enabled    = true
    runOptions = '--entrypoint ""'  // override ENTRYPOINT so Nextflow can call /bin/bash
}
