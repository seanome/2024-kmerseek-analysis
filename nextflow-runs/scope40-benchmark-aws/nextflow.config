// scope40-benchmark-aws/nextflow.config

def dateStr = new java.text.SimpleDateFormat('yyyy-MM-dd').format(new java.util.Date())

trace    { enabled = true;  file = "${launchDir}/scope40_benchmark.${dateStr}.trace.txt";
           fields  = 'task_id,hash,native_id,process,tag,status,exit,container,cpus,time,memory,attempt,submit,start,complete,duration,realtime,%cpu,%mem,peak_rss' }
timeline { enabled = true;  file = "${launchDir}/scope40_benchmark.${dateStr}.timeline.html" }
report   { enabled = true;  file = "${launchDir}/scope40_benchmark.${dateStr}.report.html" }

// ---------------------------------------------------------------------------
// Process resource labels
// ---------------------------------------------------------------------------

process {
    // Retry on OOM / preemption / SIGTERM
    errorStrategy = { task.exitStatus in [-1, 130, 137, 140] ? 'retry' : 'terminate' }
    maxRetries    = 2

    withLabel: download {
        cpus   = 2
        memory = { 2.GB * task.attempt }
        time   = '4h'
    }

    withLabel: light_cpu {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = '2h'
    }

    withLabel: medium_cpu {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = '8h'
    }

    withLabel: high_cpu {
        cpus   = 16
        memory = { 64.GB * task.attempt }
        time   = '24h'
    }

    // GPU label — accelerator directive is effective only under the aws profile
    withLabel: gpu {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = '12h'
    }

    // Per-process tuning
    withName: blastSearch {
        cpus   = 16
        memory = { 32.GB * task.attempt }
        time   = '48h'   // BLAST all-vs-all on 14k seqs can be slow
    }

    withName: diamondSearch {
        cpus   = 16
        memory = { 32.GB * task.attempt }
        time   = '12h'
        maxForks = 1   // large tmp disk usage per run
    }

    withName: mmseqs2Search {
        cpus   = 16
        memory = { 64.GB * task.attempt }
        time   = '12h'
    }

    withName: 'foldseekSearch|foldseekSearchEF' {
        cpus   = 16
        memory = { 64.GB * task.attempt }
        time   = '12h'
    }

    // kmerseek 0.4.0 sweep (local binary, no container): 52 small (encoding, ksize)
    // combos on the 4 MB SCOPe40 FASTA — modest per-task memory, throttled via
    // maxForks so concurrent tasks stay within the local profile's 64 GB cap.
    withName: kmerseekIndex {
        cpus     = 2
        memory   = { 16.GB * task.attempt }
        time     = '4h'
        maxForks = 4
    }

    withName: kmerseekSearch {
        cpus     = 2
        memory   = { 16.GB * task.attempt }
        time     = '4h'
        maxForks = 4
    }

    withName: esmfoldPredict {
        cpus   = 4
        memory = { 32.GB * task.attempt }
        time   = '6h'
        maxForks = 10   // parallel GPU jobs for chunked prediction
    }

    withName: evaluateScope40 {
        cpus   = 2
        memory = { 16.GB * task.attempt }
        time   = '2h'
    }
}

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------

profiles {

    // ─── local — Docker on macOS / Linux workstation ─────────────────────────
    local {
        workDir = "${launchDir}/work"

        executor {
            name   = 'local'
            cpus   = 16
            memory = '64 GB'
        }

        docker {
            enabled    = true
            runOptions = '--entrypoint ""'  // required; never use ENTRYPOINT in containers
        }

        // GPU tools run on CPU locally (no accelerator directive)
        process {
            withLabel: gpu {
                cpus   = 4
                memory = '16 GB'
                time   = '24h'
            }
        }
    }

    // ─── aws — plain AWS Batch (no Seqera Platform Fusion) ───────────────────
    //
    // No Fusion filesystem here, so every process needs a `container` with the
    // AWS CLI baked in at aws.batch.cliPath — Nextflow shells out to `aws s3 cp`
    // for staging in/out of the S3 workDir. See docker/Dockerfile.eval and the
    // kmerseek Dockerfile: both install AWS CLI v2 to /usr/local/bin/aws.
    //
    // Required overrides at launch time (queue/bucket names are account-specific,
    // never hardcode them here — see .env / memory):
    //   --queue      YOUR-CPU-QUEUE
    //   --gpu_queue  YOUR-GPU-QUEUE   (only if running GPU tools)
    //   --aws_region us-west-2        (defaults below if omitted)
    //   -w           s3://YOUR-BUCKET/.../work
    //
    aws {
        process.executor = 'awsbatch'
        process.queue    = params.queue ?: 'REPLACE_WITH_CPU_QUEUE'

        aws {
            region = params.aws_region ?: 'us-west-2'
            batch {
                cliPath = '/usr/local/bin/aws'
                // jobRole and computeEnvironment are set on the queue itself
            }
        }

        docker {
            enabled    = true
            runOptions = '--entrypoint ""'
        }

        // Kmerseek runs from a container on AWS (unlike the bare local-binary
        // path used by -profile local) — override the bin path to rely on $PATH.
        params.kmerseek_bin = 'kmerseek'

        process {
            withName: 'kmerseekIndex|kmerseekSearch' {
                container = { params.kmerseek_container }
            }

            // GPU processes need a separate queue with GPU instances.
            // Override params.gpu_queue to route GPU jobs to the right queue.
            withLabel: gpu {
                queue        = params.gpu_queue ?: 'REPLACE_WITH_GPU_QUEUE'
                accelerator  { type = 'nvidia'; request = 1 }
                cpus         = 8
                memory       = { 60.GB * task.attempt }
                time         = '12h'
            }
        }
    }

    // ─── test — quick smoke-test with 10 sequences, no GPU tools ─────────────
    test {
        params {
            n_test         = 10
            run_plmsearch  = false
            run_foldseek_ef = false
            run_tea        = false
        }

        executor {
            name   = 'local'
            cpus   = 8
            memory = '16 GB'
        }

        docker {
            enabled    = true
            runOptions = '--entrypoint ""'
        }
    }
}
