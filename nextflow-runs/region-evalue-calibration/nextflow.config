// Three profiles: `stub` (laptop, no container, for `make stub`), `standard` (local
// Docker) and `sherlock` (SLURM + Apptainer).

params.run_date    = new java.text.SimpleDateFormat('yyyy-MM-dd').format(new java.util.Date())
// `make pilot` sets this to pilot, so its trace survives the full run's on the same day.
params.trace_label = 'run'

// kmerseek seanome/kmerseek PR 134 head 0a229700 (olgabot/run-evalue-checks, which holds
// PR 133's region_run_evalue and region_ka_evalue) plus python3 and segmasker, built from
// ./Dockerfile by `make push-image`. Replace the tag with its digest once pushed.
params.image = 'docker.io/olgabot/kmerseek:2026-10-18-nb344-0a22970'

// Memory and time for the search, before the pilot has measured them. The dark-set run
// (PR 134's data/290_plan/resources.tsv) searched 2000-query human chunks with
// hp_lehninger2 at 176 GB peak for k = 17 and 40 GB for k = 25; k = 19 was not run. Read
// on a straight line in log memory between them, k = 19 needs about 120 GB. The pilot asks
// 1.5x that, and `make measure` replaces it with 1.5x what the pilot used.
params.search_memory_gb = 180
params.search_time_h    = 6
params.search_cpus      = 8

workDir = "${launchDir}/work"

trace {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/region_evalue_calibration.${params.trace_label}.${params.run_date}.trace.txt"
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,container,cpus,time,memory,attempt,submit,start,complete,duration,realtime,%cpu,peak_rss,rchar,wchar'
}

process {
    container = params.image
    cpus   = 1
    memory = { 4.GB * task.attempt }
    time   = { 1.h * task.attempt }

    // A task the scheduler killed (out of memory, walltime, node failure, preemption) has
    // exitStatus Integer.MAX_VALUE, not a value in 128..143, so it is named explicitly.
    // Two retries with doubled memory and time. Anything else ends at `finish`: a missing
    // chunk would leave a stratum short of decoys, so the run must stop, not carry on.
    maxRetries    = 2
    errorStrategy = {
        (task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE || task.exitStatus in 128..143) && task.attempt <= 2 ? 'retry' : 'finish'
    }

    withName: 'MAKE_DECOYS' {
        memory = { 8.GB * task.attempt }
        time   = { 3.h * task.attempt }
    }
    withName: 'SEG' {
        memory = { 4.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
    // No history for a human-only index at k = 19 with the Karlin-Altschul fit (200 queries
    // and their shuffled copies searched against it). This is the model's ask.
    withName: 'INDEX' {
        cpus   = 8
        memory = { 64.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }
    withName: 'SEARCH' {
        cpus   = { params.search_cpus }
        memory = { params.search_memory_gb.GB * task.attempt }
        time   = { params.search_time_h.h * task.attempt }
    }
}

profiles {
    stub {
        docker.enabled = false
        process {
            container = null
            withName: '.*' {
                cpus   = 1
                memory = 1.GB
                time   = 1.h
            }
        }
    }

    standard {
        docker {
            enabled    = true
            runOptions = '--platform linux/amd64'
        }
    }

    sherlock {
        process {
            executor       = 'slurm'
            queue          = 'hns,normal'
            clusterOptions = '--account=ayeletv'
        }
        executor {
            submitRateLimit = '15/1min'
            queueSize       = 200
        }
        apptainer {
            enabled     = true
            autoMounts  = true
            cacheDir    = "${System.getenv('SCRATCH') ?: '.'}/apptainer-cache"
            pullTimeout = '60m'
        }
    }
}
