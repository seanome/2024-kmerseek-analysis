// Two profiles: `standard` (local Docker) and `sherlock` (SLURM + Apptainer).

params.run_date = new java.text.SimpleDateFormat('yyyy-MM-dd').format(new java.util.Date())

// kmerseek branch olgabot/run-evalue at 5fdfdcc (region_evalue on every region) plus
// python/polars, built from ./Dockerfile by `make push-image`. Pinned by digest: the tag
// 2026-09-25-run-evalue-5fdfdcc-rtcompat names the same image.
params.kmerseek_image = 'docker.io/olgabot/kmerseek@sha256:3e4f4d77f996ee97addbc235b68b3afd2f21130865e0eb2cba7abf7968a2d140'

// The image kmerseekArm searches with, kept separate so that changing kmerseek reruns only
// the searches and not the python steps (stageDatabase rewriting database.fasta would
// rerun every baseline). kmerseek branch olgabot/extend-without-fit at ffe71ce
// (seanome/kmerseek#88): regions are extended even where the index has no
// Karlin-Altschul fit. Tag 2026-09-25-extend-without-fit-ffe71ce.
params.kmerseek_search_image = 'docker.io/olgabot/kmerseek@sha256:ce379e5c202d0267a22e9a18a13dc518460360ea57965fad169b7597e81c4d33'

workDir = "${launchDir}/work"

trace {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/deep_twilight.${params.run_date}.trace.txt"
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,container,cpus,time,memory,attempt,submit,start,complete,duration,realtime,%cpu,peak_rss,rchar,wchar'
}

report {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/deep_twilight.${params.run_date}.report.html"
}

process {
    cpus   = 2
    memory = { 8.GB * task.attempt }
    time   = { 2.h * task.attempt }

    // A task the scheduler killed (out of memory, walltime, node failure, preemption) has
    // exitStatus Integer.MAX_VALUE, not a value in 128..143, so it is named explicitly.
    // Two retries with doubled memory and time; every other path ends at `finish`, which
    // lets the tasks already running complete instead of cancelling them.
    maxRetries    = 2
    errorStrategy = {
        (task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE || task.exitStatus in 128..143) && task.attempt <= 2 ? 'retry' : 'finish'
    }
}

profiles {
    standard {
        docker {
            enabled = true
            runOptions = '--platform linux/amd64'
        }
    }

    sherlock {
        process {
            executor       = 'slurm'
            // Either partition, whichever starts the job first.
            queue          = 'hns,normal'
            clusterOptions = '--account=ayeletv'
        }
        executor {
            submitRateLimit = '15/1min'
            queueSize       = 200
        }
        apptainer {
            enabled     = true
            autoMounts  = true
            cacheDir    = "${System.getenv('SCRATCH') ?: '.'}/apptainer-cache"
            pullTimeout = '60m'
        }
    }
}
