// Nextflow configuration for kmerseek 0.4.0 HP-only (k=18-19) human-mouse ortholog pipeline.
// Sibling of ../human-mouse-gencode-orthologs/nextflow.config — meant to run sequentially
// with that pipeline (not concurrently), so it reuses the same generous machine-wide limits.

def dateFormat = new java.text.SimpleDateFormat('yyyy-MM-dd')
def today = dateFormat.format(new java.util.Date())

workDir = "${launchDir}/work"

trace {
    enabled = true
    file = "${launchDir}/kmerseek_orthologs_hp_v040.${today}.trace.txt"
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes'
}

timeline {
    enabled = true
    file = "${launchDir}/kmerseek_orthologs_hp_v040.${today}.timeline.html"
}

report {
    enabled = true
    file = "${launchDir}/kmerseek_orthologs_hp_v040.${today}.report.html"
}

process {
    cpus = 1
    memory = '4 GB'
    time = '12h'

    withName: indexDatabase {
        cpus = 2
        memory = '100 GB'
        time = '24h'
        maxForks = 2 // Each index uses tens of GB RAM, must run one at a time
    }

    withName: downloadOrthologMapping {
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }

    withName: parseOrthologMapping {
        cpus = 1
        memory = '4 GB'
        time = '30m'
    }

    withName: searchHumanVsMouse {
        cpus = 2
        memory = '100 GB'
        time = '24h'
        maxForks = 2
    }

    withName: evaluateOrthologs {
        cpus = 2
        memory = '32 GB'  // "tens of MB" only holds for small/clean-signal encodings. Noisy HP
                           // alphabets (e.g. hp-lehninger) can produce multi-GB prefiltered results
                           // (5.7 GB compressed / tens of GB uncompressed at k19), and the prefiltered
                           // pathway falls back to non-streaming (full hash-join) collects for
                           // histograms/metric-stats, so real peak RSS can hit tens of GB.
                           // No container on this process, so Nextflow can't enforce this at the OS
                           // level -- it only uses this number to decide how much to co-schedule
                           // against executor.memory. Under-declaring it (previously 8 GB) let a huge
                           // evaluateOrthologs task run alongside a 100 GB searchHumanVsMouse task and
                           // the real combined RSS exceeded physical RAM -> macOS OOM-killed it (exit 137).
        time = '12h'
        maxForks = 3  // bounded by 32 GB x maxForks fitting inside executor.memory once a 100 GB
                       // search/index task is also running
    }

    withName: aggregateResults {
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }
}

executor {
    name = 'local'
    cpus = 8
    memory = '110 GB'  // Leave ~18 GB for OS and other processes
}

// No docker block: this pipeline calls the local kmerseek 0.4.0 binary directly
// (params.kmerseek_bin), not a container.
