// Sherlock settings for nf-core/rnaseq 3.27.0 and nf-core/differentialabundance 2.0.0 on
// the young-colony PEC libraries. Passed with `-c sherlock.config`; the pipelines' own
// cluster profiles are not used.

process {
    executor       = 'slurm'
    // Either partition, whichever starts the job first.
    queue          = 'hns,normal'
    clusterOptions = '--account=ayeletv'

    // A task killed by SLURM (memory, walltime, node failure, preemption) reaches Nextflow
    // with exitStatus == Integer.MAX_VALUE, not 128..143, so the pipelines' own
    // `exitStatus in 130..145` rule never retries it and the run stops. Retry those twice
    // with the pipelines' doubling resource closures; anything else stops new submissions.
    errorStrategy = {
        (task.attempt <= 2 && (task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE
            || task.exitStatus in 104..145 || task.exitStatus == 175)) ? 'retry' : 'finish'
    }
    maxRetries = 2

    // Sizes are the pipelines' defaults (process_high: 12 CPUs, 72 GB, 16 h for STAR index
    // and alignment), which fit the largest library here: 69.9 million trimmed pairs,
    // SRR32233964. No earlier STAR run on this genome exists to size from.
    resourceLimits = [cpus: 32, memory: 250.GB, time: 48.h]
}

executor {
    submitRateLimit = '15/1min'
    queueSize       = 100
}

apptainer {
    enabled     = true
    autoMounts  = true
    cacheDir    = "${System.getenv('SCRATCH') ?: '.'}/apptainer-cache"
    pullTimeout = '60m'
}
