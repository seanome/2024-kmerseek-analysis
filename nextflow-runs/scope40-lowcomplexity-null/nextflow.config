// scope40-lowcomplexity-null/nextflow.config

def dateStr = new java.text.SimpleDateFormat('yyyy-MM-dd').format(new java.util.Date())

workDir = "${launchDir}/work"

trace {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/lowcomplexity_null.${dateStr}.trace.txt"
    fields    = 'task_id,hash,process,tag,status,exit,cpus,memory,attempt,submit,start,complete,duration,realtime,%cpu,peak_rss'
}

timeline { enabled = true; overwrite = true; file = "${launchDir}/lowcomplexity_null.${dateStr}.timeline.html" }
report   { enabled = true; overwrite = true; file = "${launchDir}/lowcomplexity_null.${dateStr}.report.html" }

process {
    cpus   = 1
    memory = '4 GB'
    time   = '4h'

    errorStrategy = { task.exitStatus in [-1, 130, 137, 140] ? 'retry' : 'terminate' }
    maxRetries    = 2

    withName: 'subsetFasta|parseScopeHeaders' {
        cpus   = 1
        memory = '1 GB'
        time   = '15m'
    }

    // Pure-Python Euler-path shuffle over ~15k domains; CPU-bound, low memory.
    withName: shuffleFasta {
        cpus   = 1
        memory = '4 GB'
        time   = '2h'
    }

    // Indexing dominates wall time. On the existing hp-alphabet-sweep trace the
    // median index at k>=20 was ~7 min against SCOPe40 at scaled=1; memory is
    // capped well above the largest observed index.
    withName: indexDatabase {
        cpus     = 2
        memory   = { 24.GB * task.attempt }
        time     = '12h'
        maxForks = 4
    }

    withName: searchAllVsAll {
        cpus     = 2
        memory   = { 24.GB * task.attempt }
        time     = '12h'
        maxForks = 4
    }

    withName: hitComplexity {
        cpus     = 1
        memory   = { 16.GB * task.attempt }
        time     = '2h'
        maxForks = 4
    }

    // Holds a dict over every distinct HP k-mer in SCOPe40 (order 10^6 entries).
    withName: kmerFrequency {
        cpus     = 1
        memory   = { 16.GB * task.attempt }
        time     = '4h'
        maxForks = 4
    }

    withName: aggregate {
        cpus   = 1
        memory = '16 GB'
        time   = '1h'
    }
}

profiles {

    // Local workstation, kmerseek and python invoked as absolute paths from
    // params (no containers) — matches how the release binary is built here.
    local {
        executor {
            name   = 'local'
            cpus   = 8
            memory = '96 GB'
        }
    }

    // Fast end-to-end check of the whole DAG on a truncated FASTA.
    test {
        params {
            n_test     = 300
            n_shuffles = 2
            alphabets  = ['hp-thomas-dill', 'hp-kyte-doolittle']
            ksizes     = [22, 26]
            // Relative, not "${launchDir}/...": launchDir is not resolvable
            // inside a profile params block and would evaluate to null.
            outdir     = 'results-test'
        }
        executor {
            name   = 'local'
            cpus   = 8
            memory = '32 GB'
        }
    }
}
