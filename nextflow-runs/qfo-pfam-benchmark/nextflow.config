// nextflow.config — QfO Pfam subdomain benchmark

def dateFormat = new java.text.SimpleDateFormat('yyyy-MM-dd')
def today = dateFormat.format(new java.util.Date())

workDir = "${launchDir}/work"

trace {
    enabled = true
    file = "${launchDir}/qfo_pfam_benchmark.${today}.trace.txt"
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar'
}

timeline {
    enabled = true
    file = "${launchDir}/qfo_pfam_benchmark.${today}.timeline.html"
}

report {
    enabled = true
    file = "${launchDir}/qfo_pfam_benchmark.${today}.report.html"
}

process {
    cpus          = 1
    errorStrategy = { task.exitStatus in [130, 137, 140] ? 'retry' : 'terminate' }
    maxRetries    = 3

    withName: indexSpecies {
        cpus     = 1
        memory   = { 4.GB * task.attempt }
        time     = '24h'
        maxForks = 8   // 8 × 4 GB = 32 GB; safe once OrbStack is set to ≥64 GB
    }

    withName: searchHumanVsSpecies {
        cpus     = 1
        memory   = { 8.GB * task.attempt }
        time     = '24h'
        maxForks = 4
    }
}

executor {
    name   = 'local'
    cpus   = 12        // 75% of 16
    memory = '64 GB'   // set OrbStack VM to ≥64 GB in OrbStack → Settings → Resources
}

docker {
    enabled    = true
    // --entrypoint "" overrides the container's ENTRYPOINT so Nextflow can run /bin/bash
    // No -v mount needed: Nextflow stages path inputs into the work dir automatically
    runOptions = '--entrypoint ""'
}
