# Lightweight image for this pipeline's Python steps (parseOrthologMapping, aggregate*,
# listMetricLeaderboardCombos, computeMetricLeaderboard, computeRbhF1, computeFamilyAuc) --
# NOT the kmerseek search/index steps, which stay on kmerseek:0.3.1 / kmerseek:main and are
# expected to be skipped via storeDir on Sherlock (see ../README-sherlock.md).
#
# Versions pinned to match the 2025-kmerseek-analysis conda env these scripts were written
# and tested against on the Mac, so bootstrap_auc_ci's resampling and every numeric result
# match bit-for-bit between local and Sherlock runs.
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends zstd && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    polars==1.34.0 \
    numpy==2.3.5 \
    scipy==1.16.3 \
    scikit-learn==1.8.0 \
    pyarrow==21.0.0 \
    requests==2.32.5
