// Nextflow configuration for kmerseek human-mouse ortholog pipeline

def dateFormat = new java.text.SimpleDateFormat('yyyy-MM-dd')
def today = dateFormat.format(new java.util.Date())

workDir = "${launchDir}/work"

trace {
    enabled = true
    file = "${launchDir}/kmerseek_orthologs.${today}.trace.txt"
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes'
}

timeline {
    enabled = true
    file = "${launchDir}/kmerseek_orthologs.${today}.timeline.html"
}

report {
    enabled = true
    file = "${launchDir}/kmerseek_orthologs.${today}.report.html"
}

process {
    cpus = 1
    memory = '4 GB'
    time = '12h'

    withName: indexDatabase {
        cpus = 2
        memory = '100 GB'
        time = '24h'
        maxForks = 2 // Each index uses 27-54 GB RAM, must run one at a time
    }

    withName: downloadOrthologMapping {
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }

    withName: parseOrthologMapping {
        cpus = 1
        memory = '4 GB'
        time = '30m'
    }

    withName: decompressFasta {
        cpus = 1
        memory = '2 GB'
        time = '30m'
    }

    withName: searchHumanVsMouse {
        cpus = 2
        memory = '100 GB'
        time = '24h'
        maxForks = 2
    }

    withName: evaluateOrthologs {
        cpus = 2
        memory = '64 GB'
        time = '12h'
        maxForks = 1  // macOS can't enforce memory limits without containers; run sequentially
    }

    withName: aggregateResults {
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }
}

executor {
    name = 'local'
    cpus = 8
    memory = '110 GB'  // Leave ~18 GB for OS and other processes
}

docker {
    enabled = true
}
