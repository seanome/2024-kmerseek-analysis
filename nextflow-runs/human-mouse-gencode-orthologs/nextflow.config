// Nextflow configuration for kmerseek human-mouse ortholog pipeline

def dateFormat = new java.text.SimpleDateFormat('yyyy-MM-dd')
def today = dateFormat.format(new java.util.Date())

workDir = "${launchDir}/work"

trace {
    enabled = true
    file = "${launchDir}/kmerseek_orthologs.${today}.trace.txt"
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes'
}

timeline {
    enabled = true
    file = "${launchDir}/kmerseek_orthologs.${today}.timeline.html"
}

report {
    enabled = true
    file = "${launchDir}/kmerseek_orthologs.${today}.report.html"
}

process {
    cpus = 1
    memory = '4 GB'
    time = '12h'

    withName: indexDatabase {
        cpus = 2
        memory = '100 GB'
        time = '24h'
        maxForks = 2 // Each index uses 27-54 GB RAM, must run one at a time
    }

    withName: downloadOrthologMapping {
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }

    withName: parseOrthologMapping {
        cpus = 1
        memory = '4 GB'
        time = '30m'
    }

    withName: searchHumanVsMouse {
        cpus = 2
        memory = '100 GB'
        time = '24h'
        maxForks = 2
        // `memory` above is a Nextflow scheduling hint only -- Docker Desktop's actual VM on
        // this machine caps out around 16 GB, well under it, so dense-hub-kmer combos (HP
        // encodings at low ksize) can still get OOM-killed by the kernel inside the VM. Now
        // that the .nf script no longer swallows that failure, `ignore` lets those combos fail
        // individually (leaving them genuinely MISSING for notebooks 200/201 to report) instead
        // of the whole sweep terminating on the first crash.
        errorStrategy = 'ignore'
    }

    withName: convertResultsToParquet {
        cpus = 1
        memory = '6 GB'  // streaming converter measured flat ~3.75GB RSS regardless of file
                          // size (zstdcat piped into pyarrow's incremental reader); was
                          // unbounded before 2026-08-10 (default 4GB hint, real usage up to
                          // 79GB on one combo) which is what took the whole machine down.
        time = '12h'
    }

    withName: evaluateOrthologs {
        cpus = 2
        memory = '8 GB'  // real usage is ~tens of MB (streaming awk/zstd + polars on the filtered file);
                          // 64 GB was capping concurrency to 1 against executor.memory regardless of maxForks
        time = '12h'
        maxForks = 4  // no container on this process anyway, so the memory limit was never enforced; run 4 in parallel
    }

    withName: aggregateResults {
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }

    withName: listMetricLeaderboardCombos {
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }

    withName: computeMetricLeaderboard {
        cpus = 1
        memory = '8 GB'  // true for ~82/84 combos; the two >100M-row combos (hp_lehninger and
                          // hp_lehninger_plus_c, both k18) measured 56 GB peak RSS in a
                          // standalone test (53s wall-clock -- vs. 5+ days near-zero-progress
                          // before this process existed, see comment above). Not raised to 56 GB
                          // here: at maxForks=4 that would starve the other ~82 cheap combos of
                          // scheduling headroom for two combos that are rare and already
                          // errorStrategy 'ignore' if they do get OOM-killed by the host kernel
                          // (local executor doesn't cgroup-enforce this directive anyway).
        time = '24h'
        maxForks = 4
        errorStrategy = 'ignore'  // one bad/missing combo shouldn't sink the whole sweep
    }

    withName: aggregateMetricLeaderboard {
        cpus = 1
        memory = '2 GB'
        time = '10m'
    }

    withName: computeRbhF1 {
        cpus = 1
        memory = '8 GB'  // true for the vast majority of combos; the same two rare >100M-row
                          // combos (hp_lehninger / hp_lehninger_plus_c, both k18) measured 43.4GB
                          // peak RSS in a standalone test (168s wall-clock) -- lighter than
                          // computeMetricLeaderboard's 56GB for the same combo since load_pair_table
                          // only carries jaccard, not the full composite-score column set. Not
                          // raised here for the same maxForks-starvation reason as
                          // computeMetricLeaderboard above.
        time = '24h'
        maxForks = 4
        errorStrategy = 'ignore'
    }

    withName: aggregateRbhF1 {
        cpus = 1
        memory = '2 GB'
        time = '10m'
    }
}

executor {
    name = 'local'
    cpus = 12
    memory = '110 GB'  // Leave ~18 GB for OS and other processes
}

docker {
    enabled = true
}

// Stanford Sherlock (SLURM + Apptainer), for the Python sweep steps only (parseOrtholog-
// Mapping, aggregate*, listMetricLeaderboardCombos, computeMetricLeaderboard, computeRbhF1,
// computeFamilyAuc) -- see README-sherlock.md. indexDatabase/searchHumanVsMouse/convertResults-
// ToParquet/evaluateOrthologs/multiQC are expected to be storeDir-skipped (their outputs
// already exist, rsynced from the Mac) rather than actually run under this profile; they keep
// their kmerseek:0.3.1/kmerseek:main container directives unchanged, which only matters if a
// combo turns out to be genuinely missing and Nextflow has to execute (and pull for) them.
//
// Everything in the top-level process{}/executor{}/docker{} blocks above still applies by
// default (this pipeline's ordinary local Mac runs are untouched) -- `-profile sherlock`
// layers the settings below on top, overriding executor/container/docker/apptainer only.
profiles {
    sherlock {
        params {
            // Absolute path to python3 INSIDE the pushed container (python:3.11-slim's own
            // python3), not the Mac conda path -- see kmerseek_human_mouse_orthologs.nf's
            // params.python_bin comment for why every Python-step process calls this
            // explicitly instead of relying on each bin/*.py script's own Mac-only shebang.
            python_bin = "/usr/local/bin/python3"

            // Skip the search/index/convert/evaluate chain entirely -- its results were
            // rsynced from the Mac (see README-sherlock.md step 3), not recomputed. See
            // params.skip_search's definition in kmerseek_human_mouse_orthologs.nf for why
            // re-running it on Sherlock would trigger a multi-day kmerseek re-search instead
            // of a resume.
            skip_search = true

            // Everything below points inside this pipeline's OWN sparse-checked-out directory
            // (${launchDir}), not a separate $SCRATCH root -- same convention as kmer-spectra's
            // Sherlock setup, where rsynced data lives alongside the tracked pipeline files
            // rather than in some other absolute location. See README-sherlock.md step 3 for
            // the exact rsync targets these paths assume.
            outdir = "${launchDir}/data/results-human-mouse-orthologs"
            of_tsv = "${launchDir}/data/orthofinder/gencode.v49.pc_translations__v__gencode.vM38.pc_translations.tsv"
        }

        process {
            executor = 'slurm'
            queue    = 'hns'
            clusterOptions = '--account=ayeletv'

            withName: 'downloadOrthologMapping|parseOrthologMapping|listMetricLeaderboardCombos|computeMetricLeaderboard|computeRbhF1|computeFamilyAuc|aggregateRbhF1|aggregateMetricLeaderboard|aggregateFamilyAuc|aggregateResults' {
                container = 'docker://olgabot/kmerseek-python-sweep:2026-08-18'
            }
        }

        // Sherlock has no Docker daemon; Apptainer pulls/converts the same image referenced
        // by the `container` directives above.
        docker {
            enabled = false
        }

        apptainer {
            enabled    = true
            autoMounts = true
            // Cache pulled/converted images under $SCRATCH rather than $HOME (small quota).
            cacheDir = "${System.getenv('SCRATCH') ?: '.'}/apptainer-cache"
        }

        // ortholog_analysis_utils.py's DATA_DIR/EXTRA_DATA_DIRS/OF_DIR/GENCODE_DIR and the
        // bin/*.py scripts' sys.path.insert all default to Mac-only /Users/olga/... paths;
        // these env vars (read via os.environ.get, see notebooks/ortholog_analysis_utils.py)
        // repoint them at wherever the corresponding data actually lives here. KMERSEEK_DATA_DIR
        // deliberately matches params.outdir above -- ortholog_analysis_utils.py's own
        // module-level functions (load_hgnc_family_gene_sets, load_mgi_orthologs) have no
        // --data-dir CLI equivalent, so this is the only lever for them. OF_DIR/GENCODE_DIR
        // aren't actually read by any of computeFamilyAuc/computeRbhF1/computeMetricLeaderboard's
        // code paths (compute_rbh_f1_combo.py takes --of-tsv directly instead), so these two are
        // forward-compatible placeholders, not things README-sherlock.md's rsync step covers.
        env {
            KMERSEEK_NOTEBOOKS_DIR = "${launchDir}/../../notebooks"
            KMERSEEK_DATA_DIR = "${launchDir}/data/results-human-mouse-orthologs"
            KMERSEEK_EXTRA_DATA_DIRS = "${launchDir}/data/results-human-mouse-orthologs-hp-v040"
            KMERSEEK_OF_DIR = "${launchDir}/data/orthofinder"
            KMERSEEK_GENCODE_DIR = "${launchDir}/data/gencode"
        }
    }
}
