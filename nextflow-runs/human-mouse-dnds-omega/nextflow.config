// human-mouse-dnds-omega/nextflow.config

def dateStr = new java.text.SimpleDateFormat('yyyy-MM-dd').format(new java.util.Date())

workDir = "${launchDir}/work"

trace {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/omega.${dateStr}.trace.txt"
    fields    = 'task_id,hash,process,tag,status,exit,cpus,memory,attempt,submit,start,complete,duration,realtime,%cpu,peak_rss'
}
timeline { enabled = true; overwrite = true; file = "${launchDir}/omega.${dateStr}.timeline.html" }
report   { enabled = true; overwrite = true; file = "${launchDir}/omega.${dateStr}.report.html" }

process {
    errorStrategy = { task.exitStatus in [-1, 130, 137, 140] ? 'retry' : 'terminate' }
    maxRetries    = 2

    withLabel: download {
        cpus   = 1
        memory = '2 GB'
        time   = '30m'   // batch REST calls (~60 requests total, see main.nf), not per-pair
    }

    withLabel: light_cpu {
        cpus   = 1
        memory = '2 GB'
        time   = '20m'   // MAFFT + codeml on a single-gene pairwise alignment is fast
        maxForks = 8
    }
}

docker {
    enabled    = true
    // Nextflow execs `/bin/bash .command.run` inside the container — a custom
    // ENTRYPOINT breaks that (see memory `feedback_docker_entrypoint`; also see
    // the Dockerfile, which resets ENTRYPOINT as a second layer of defense).
    runOptions = '--entrypoint ""'
}

profiles {
    // Full run against whatever --gene_pairs points to.
    standard {
        executor {
            name   = 'local'
            cpus   = 8
            memory = '16 GB'
        }
    }

    // Smoke test: 5 gene pairs end-to-end, to validate the codeml .mlc parser
    // (unvalidated as written — see main.nf header) before a full-scale run.
    test {
        params {
            fetch_limit = 5
        }
        executor {
            name   = 'local'
            cpus   = 4
            memory = '8 GB'
        }
    }
}
