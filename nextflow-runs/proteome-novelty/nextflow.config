// proteome-novelty: notebook 343. Profiles: `sherlock` (SLURM + Apptainer), `standard`
// (local Docker), `stub` (no containers, for `-stub-run` on the laptop).

params.run_date = new java.text.SimpleDateFormat('yyyy-MM-dd').format(new java.util.Date())

// The python image deep-twilight-controls uses (tag 2026-09-25-run-evalue-5fdfdcc-rtcompat):
// python 3.13.5, polars 1.43.2 built for CPUs without AVX2, numpy 2.5.2 (checked
// 2026-10-18). The 0.4.1-rc1 image's polars segfaults without AVX2. Only python runs here;
// no kmerseek command does.
params.python_image = 'docker.io/olgabot/kmerseek@sha256:3e4f4d77f996ee97addbc235b68b3afd2f21130865e0eb2cba7abf7968a2d140'

workDir = "${launchDir}/work"

trace {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/proteome_novelty.${params.run_date}.trace.txt"
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,container,cpus,time,memory,attempt,submit,start,complete,duration,realtime,%cpu,peak_rss,rchar,wchar'
}

report {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/proteome_novelty.${params.run_date}.report.html"
}

process {
    cpus   = 1
    memory = { 4.GB * task.attempt }
    time   = { 1.h * task.attempt }

    withLabel: python { container = params.python_image }

    // A task the scheduler killed (out of memory, walltime, node failure, preemption) has
    // exitStatus Integer.MAX_VALUE, not a value in 128..143, so it is named explicitly.
    // Two retries with doubled asks. After that the setting is left out (`ignore`): the
    // notebook lists every clade x setting it expected and says which are missing. Any
    // other error is a bug and ends the run once running tasks finish.
    maxRetries    = 2
    errorStrategy = {
        (task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE || task.exitStatus in 128..143) ? (task.attempt <= 2 ? 'retry' : 'ignore') : 'finish'
    }
}

profiles {
    standard {
        docker {
            enabled    = true
            runOptions = '--platform linux/amd64'
        }
    }

    // Docker stays off, so the containers named above are not pulled.
    stub {
        process.resourceLimits = [cpus: 4, memory: 8.GB, time: 1.h]
        executor {
            name   = 'local'
            cpus   = 4
            memory = '8 GB'
        }
    }

    sherlock {
        process {
            executor       = 'slurm'
            queue          = 'hns,normal'
            clusterOptions = '--account=ayeletv'
            // The largest hns node; a doubled retry is capped here instead of failing.
            resourceLimits = [cpus: 32, memory: 500.GB, time: 7.d]
        }
        executor {
            submitRateLimit = '15/1min'
            queueSize       = 100
        }
        apptainer {
            enabled     = true
            autoMounts  = true
            cacheDir    = "${System.getenv('SCRATCH') ?: '.'}/apptainer-cache"
            pullTimeout = '60m'
        }
    }
}
