// Notebook 360 pipeline. Two profiles: `standard` (local Docker, for -stub-run only; the
// laptop never runs this for real) and `sherlock` (SLURM + Apptainer).

params.run_date = new java.text.SimpleDateFormat('yyyy-MM-dd').format(new java.util.Date())

// kmerseek 0.4.0 as the dark set ran it, plus kmerseek PR 141 (3c353d4): target coordinates of
// aliased index entries were wrong for 2.3% of 0.4.0 regions, and this test reads them.
// Tag 0.4.0-pr141-3c353d4. Its python3 has polars 1.43.2, used by every python step.
params.kmerseek_image  = 'docker.io/olgabot/kmerseek@sha256:ad3ab295b147a24737c604af6ae88299a025c14a771194d486b73291d25be0de'
// BioContainers, pinned by digest; the tag is in the comment.
params.polyester_image = 'quay.io/biocontainers/bioconductor-polyester@sha256:b83aa57d41726b3d380849a274ae7664b677532755fb182b5f1f12b2d26a895b' // 1.38.0--r43hdfd78af_0
params.deseq2_image    = 'quay.io/biocontainers/bioconductor-deseq2@sha256:2d299c5f045c65879e8da189bba17857963d50703af5410003e7e84883deef13'    // 1.42.0--r43hf17093f_2
params.trinity_image   = 'quay.io/biocontainers/trinity@sha256:9117e2fdc7d5f3cb037b284510fbf0f30e98e613de28a2a4e754795fc07f1bf5'                // 2.15.2--pl5321h077b44d_6
params.salmon_image    = 'quay.io/biocontainers/salmon@sha256:3938cc6dfaca6f7ee14eac0cdc0f305fdff8faa7f14541c72e684feb1b443a74'                 // 1.10.3--h45fbf2d_5
params.jellyfish_image = 'quay.io/biocontainers/jellyfish@sha256:e385805d4bf54e2c8c61016155d3bc28837ff0081102c21029d0a7ff1ebc12f3'              // 2.2.10--h6bb024c_1
params.diamond_image   = 'quay.io/biocontainers/diamond@sha256:e02013280712f1295e59339dc6ea162adf8a6bbdd730e73a9c00700c03c3e556'                // 2.2.8--he361c42_0

workDir = "${launchDir}/work"

trace {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/de_kmer_landing.${params.run_date}.${new java.text.SimpleDateFormat('HHmmss').format(new java.util.Date())}.trace.txt"
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,container,cpus,time,memory,attempt,submit,start,complete,duration,realtime,%cpu,peak_rss,rchar,wchar'
}

report {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/de_kmer_landing.${params.run_date}.report.html"
}

process {
    // A task the scheduler killed (out of memory, walltime, node failure, preemption) has
    // exitStatus Integer.MAX_VALUE, not a value in 128..143, so it is named explicitly.
    // Two retries, each with memory and time scaled by the attempt (every process asks
    // `x * task.attempt`). After that, or on any other failure: one kmerseek setting can be
    // lost and the test still answered (the notebook lists missing settings), so those end
    // at `ignore`; every other step is needed by everything after it, so it ends at
    // `finish`, which lets running tasks complete and then stops the run.
    maxRetries    = 2
    errorStrategy = {
        (task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE || task.exitStatus in 128..143) && task.attempt <= 2 ? 'retry'
            : (task.process in ['kmerseekIndex', 'kmerseekSearch', 'landings'] ? 'ignore' : 'finish')
    }

    withLabel: 'python'    { container = params.kmerseek_image }
    withLabel: 'kmerseek'  { container = params.kmerseek_image }
    withLabel: 'polyester' { container = params.polyester_image }
    withLabel: 'deseq2'    { container = params.deseq2_image }
    withLabel: 'trinity'   { container = params.trinity_image }
    withLabel: 'salmon'    { container = params.salmon_image }
    withLabel: 'jellyfish' { container = params.jellyfish_image }
    withLabel: 'diamond'   { container = params.diamond_image }
}

profiles {
    standard {
        docker {
            enabled    = true
            runOptions = '--platform linux/amd64'
        }
    }

    sherlock {
        process {
            executor       = 'slurm'
            queue          = 'hns,normal'
            clusterOptions = '--account=ayeletv'
        }
        executor {
            submitRateLimit = '15/1min'
            queueSize       = 60
        }
        apptainer {
            enabled     = true
            autoMounts  = true
            cacheDir    = "${System.getenv('SCRATCH') ?: '.'}/apptainer-cache"
            pullTimeout = '60m'
        }
    }
}
