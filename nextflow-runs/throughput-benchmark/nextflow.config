// Nextflow configuration for throughput benchmark
//
// Container images:
//   kmerseek:bench  — kmerseek:0.3.0 + python3
//                     Build with: nextflow-runs/throughput-benchmark/Dockerfile
//   blast           — quay.io/biocontainers/blast (BioContainers, linux/amd64)
//   mmseqs2         — quay.io/biocontainers/mmseqs2 (BioContainers, linux/amd64)
//   python          — python:3.12-slim (subsample + collect helper processes)
//
// Update image tags below to match what is available on your machine / registry.

def dateFormat = new java.text.SimpleDateFormat('yyyy-MM-dd')
def today = dateFormat.format(new java.util.Date())

workDir = "${launchDir}/work"

// ── Container images (update tags to match your platform) ─────────────────────
params {
    kmerseek_image = 'kmerseek:bench'
    blast_image    = 'quay.io/biocontainers/blast:2.16.0--h66cff3f_1'
    mmseqs2_image  = 'quay.io/biocontainers/mmseqs2:18.8cc5c--h43eeafb_3'
    python_image   = 'python:3.12-slim'
}

// ── Docker — disabled; all tools run from local conda envs ────────────────────
docker {
    enabled = false
}

// ── Reporting ──────────────────────────────────────────────────────────────────
trace {
    enabled = true
    file    = "${launchDir}/throughput_benchmark.${today}.trace.txt"
    fields  = 'task_id,hash,process,tag,status,exit,submit,start,complete,duration,realtime,%cpu,%mem,rss,peak_rss'
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/throughput_benchmark.${today}.timeline.html"
}

report {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/throughput_benchmark.${today}.report.html"
}

// ── Per-process resource limits and container assignments ─────────────────────
process {
    cpus   = 1
    memory = '8 GB'
    time   = '4h'

    withName: SUBSAMPLE_QUERIES {
        memory = '1 GB'
        time   = '5m'
    }

    withName: KMERSEEK_INDEX {
        memory = '32 GB'
        time   = '30m'
    }

    withName: KMERSEEK_SEARCH_TIMING {
        memory = '32 GB'
        time   = '30m'
    }

    withName: BLAST_MAKEDB {
        memory = '4 GB'
        time   = '15m'
    }

    withName: BLAST_SEARCH_TIMING {
        memory = '4 GB'
        time   = '2h'
    }

    withName: MMSEQS_MAKEDB {
        memory = '4 GB'
        time   = '15m'
    }

    withName: MMSEQS_SEARCH_TIMING {
        memory = '8 GB'
        time   = '2h'
    }

    withName: COLLECT_TIMING {
        memory = '256 MB'
        time   = '5m'
    }
}

executor {
    name   = 'local'
    cpus   = 8
    memory = '64 GB'
}
