// Nextflow configuration for throughput benchmark
//
// Profiles:
//   (default)  — local Mac, conda binaries, no Docker (resource trace won't work on macOS)
//   ec2        — single Linux EC2 instance, Docker enabled, full resource trace
//                Launch: nextflow run main.nf -profile ec2
//                Recommended instance: c7i.8xlarge (32 vCPU, 64 GB RAM, ~$1.60/hr on-demand)
//
// Container images (used by ec2 profile):
//   kmerseek   — push locally-built image to ECR, then set params.kmerseek_image
//                  docker build -t kmerseek:bench .
//                  docker tag kmerseek:bench <ACCOUNT>.dkr.ecr.<REGION>.amazonaws.com/kmerseek:bench
//                  aws ecr create-repository --repository-name kmerseek
//                  aws ecr get-login-password | docker login --username AWS --password-stdin <ACCOUNT>.dkr.ecr.<REGION>.amazonaws.com
//                  docker push <ACCOUNT>.dkr.ecr.<REGION>.amazonaws.com/kmerseek:bench
//   blast      — quay.io/biocontainers/blast (BioContainers, linux/amd64 — works natively on EC2)
//   mmseqs2    — quay.io/biocontainers/mmseqs2 (BioContainers, linux/amd64 — works natively on EC2)
//   python     — python:3.12-slim

def dateFormat = new java.text.SimpleDateFormat('yyyy-MM-dd')
def today = dateFormat.format(new java.util.Date())

workDir = "${launchDir}/work"

// ── Container images ──────────────────────────────────────────────────────────
params {
    kmerseek_image = 'kmerseek:bench'   // override with ECR URI when using ec2 profile
    blast_image    = 'quay.io/biocontainers/blast:2.16.0--h66cff3f_1'
    mmseqs2_image  = 'quay.io/biocontainers/mmseqs2:18.8cc5c--h43eeafb_3'
    python_image   = 'python:3.12-slim'

    // local conda binary paths (default profile only)
    python3     = "${System.getProperty('user.home')}/anaconda3/envs/2025-kmerseek-analysis/bin/python3"
    kmerseek    = "${System.getProperty('user.home')}/code/kmerseek/target/release/kmerseek"
    blastp      = "${System.getProperty('user.home')}/anaconda3/envs/orthofinder/bin/blastp"
    makeblastdb = "${System.getProperty('user.home')}/anaconda3/envs/orthofinder/bin/makeblastdb"
    mmseqs      = "${System.getProperty('user.home')}/anaconda3/envs/orthofinder/bin/mmseqs"
}

// ── Docker — disabled by default (local Mac conda) ────────────────────────────
docker {
    enabled = false
}

// ── Reporting ─────────────────────────────────────────────────────────────────
// NOTE: peak_rss / %cpu / %mem are NOT populated on macOS without Docker.
//       Run with -profile ec2 on Linux to get accurate resource measurements.
trace {
    enabled = true
    file    = "${launchDir}/throughput_benchmark.${today}.trace.txt"
    fields  = 'task_id,hash,process,tag,status,exit,submit,start,complete,duration,realtime,%cpu,%mem,rss,peak_rss'
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/throughput_benchmark.${today}.timeline.html"
}

report {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/throughput_benchmark.${today}.report.html"
}

// ── Per-process resource limits ───────────────────────────────────────────────
process {
    cpus   = 1
    memory = '8 GB'
    time   = '4h'

    withName: SUBSAMPLE_QUERIES {
        memory = '1 GB'
        time   = '5m'
    }

    withName: KMERSEEK_INDEX {
        memory = '32 GB'
        time   = '30m'
    }

    withName: KMERSEEK_SEARCH_TIMING {
        memory = '32 GB'
        time   = '30m'
    }

    withName: BLAST_MAKEDB {
        memory = '4 GB'
        time   = '15m'
    }

    withName: BLAST_SEARCH_TIMING {
        memory = '4 GB'
        time   = '2h'
    }

    withName: MMSEQS_MAKEDB {
        memory = '4 GB'
        time   = '15m'
    }

    withName: MMSEQS_SEARCH_TIMING {
        memory = '8 GB'
        time   = '2h'
    }

    withName: COLLECT_TIMING {
        memory = '256 MB'
        time   = '5m'
    }
}

executor {
    name   = 'local'
    cpus   = 8
    memory = '64 GB'
}

// ── ec2 profile: single Linux instance, Docker, full resource trace ───────────
// Usage: nextflow run main.nf -profile ec2 --kmerseek_image <ECR_URI>
// Recommended: c7i.8xlarge (32 vCPU, 64 GB RAM) or r7i.4xlarge (16 vCPU, 128 GB RAM)
profiles {
    ec2 {
        docker {
            enabled    = true
            runOptions = '--platform linux/amd64'
        }

        process {
            // containers assigned per-process in main.nf via container directive
            withName: 'KMERSEEK_INDEX|KMERSEEK_SEARCH_TIMING' {
                cpus   = 8
                memory = '32 GB'
            }
            withName: 'BLAST_SEARCH_TIMING' {
                cpus   = 4
                memory = '8 GB'
            }
            withName: 'MMSEQS_MAKEDB|MMSEQS_SEARCH_TIMING' {
                cpus   = 8
                memory = '16 GB'
            }
        }

        executor {
            name   = 'local'
            cpus   = 32   // c7i.8xlarge: 32 vCPU
            memory = '60 GB'
        }

        // resource trace works on Linux — peak_rss and %cpu will be populated
    }
}
