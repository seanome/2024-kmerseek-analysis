// Resource-benchmark pipeline: Kmerseek HP k=24 vs OrthoFinder, human vs mouse

manifest {
    name        = 'resource-benchmark'
    description = 'Capture wall-time, CPU, and memory for Kmerseek HP k=24 and OrthoFinder on human vs mouse GENCODE proteomes'
    version     = '1.0.0'
}

// ---------------------------------------------------------------------------
// Docker
// ---------------------------------------------------------------------------
docker {
    enabled    = true
    runOptions = '--platform linux/amd64'   // uncomment on Apple Silicon if needed
    host       = 'unix:///Users/olga/.orbstack/run/docker.sock'
}

// ---------------------------------------------------------------------------
// Execution
// ---------------------------------------------------------------------------
executor {
    name   = 'local'
    cpus   = 8
    memory = '64 GB'
}

process {
    errorStrategy = 'terminate'

    withName: 'KMERSEEK_INDEX' {
        container = 'kmerseek:latest'
        cpus      = 1
        memory    = '8 GB'
    }

    withName: 'KMERSEEK_SEARCH' {
        container = 'kmerseek:latest'
        cpus      = 1
        memory    = '16 GB'
    }

    withName: 'ORTHOFINDER' {
        container = 'orthofinder-procps:latest'
        cpus      = 8
        memory    = '32 GB'
    }
}

// ---------------------------------------------------------------------------
// Work directory
// ---------------------------------------------------------------------------
workDir = "${launchDir}/work"

// ---------------------------------------------------------------------------
// Resource reporting
// ---------------------------------------------------------------------------
report {
    enabled = true
    file    = "${launchDir}/results/pipeline_report.html"
}

timeline {
    enabled = true
    file    = "${launchDir}/results/pipeline_timeline.html"
}

trace {
    enabled   = true
    file      = "${launchDir}/results/pipeline_trace.txt"
    overwrite = true
    fields    = 'task_id,name,status,exit,submit,start,complete,duration,realtime,cpus,memory,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar'
}
