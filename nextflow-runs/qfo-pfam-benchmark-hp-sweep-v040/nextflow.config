// nextflow.config — QfO Pfam benchmark, HP-alphabet x ksize sweep (kmerseek 0.4.0)

def dateFormat = new java.text.SimpleDateFormat('yyyy-MM-dd')
def today = dateFormat.format(new java.util.Date())

workDir = "${launchDir}/work"

trace {
    enabled = true
    file = "${launchDir}/qfo_pfam_benchmark_hp_sweep.${today}.trace.txt"
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar'
}

timeline {
    enabled = true
    file = "${launchDir}/qfo_pfam_benchmark_hp_sweep.${today}.timeline.html"
}

report {
    enabled = true
    file = "${launchDir}/qfo_pfam_benchmark_hp_sweep.${today}.report.html"
}

process {
    cpus          = 2
    errorStrategy = { task.exitStatus in [130, 137, 140] ? 'retry' : 'terminate' }
    maxRetries    = 3

    withName: INDEX_AND_SEARCH {
        cpus     = 2
        memory   = { 24.GB * task.attempt }
        time     = '24h'
        // 4 x 24 GB = 96 GB, leaving headroom under executor.memory below.
        // Bump this down (and maxForks up) if real usage looks much lower in
        // practice -- macOS gives no peak_rss in the trace to check this from,
        // see the pipeline's top-of-file NOTE.
        maxForks = 4
    }
}

executor {
    name   = 'local'
    cpus   = 12        // 75% of 16
    memory = '110 GB'  // leave ~18 GB for OS and other processes (128 GB machine)
}

// No docker block: this pipeline calls the local kmerseek 0.4.0 binary directly
// (params.kmerseek_bin), not a container.
