// clade-splash: notebook 357. Profiles: `sherlock` (SLURM + Apptainer), `stub` (no
// containers, for `-stub-run` on the laptop).

params.run_date = new java.text.SimpleDateFormat('yyyy-MM-dd').format(new java.util.Date())

// The python image proteome-novelty (notebook 345) uses: python 3.13.5, polars 1.43.2 built
// for CPUs without AVX2, numpy 2.5.2, no scipy (checked 2026-10-20 on Sherlock). Only python
// runs in it; no kmerseek command does.
params.python_image = 'docker.io/olgabot/kmerseek@sha256:3e4f4d77f996ee97addbc235b68b3afd2f21130865e0eb2cba7abf7968a2d140'

workDir = "${launchDir}/work"

trace {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/clade_splash.${params.run_date}.trace.txt"
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,container,cpus,time,memory,attempt,submit,start,complete,duration,realtime,%cpu,peak_rss,rchar,wchar'
}

report {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/clade_splash.${params.run_date}.report.html"
}

process {
    cpus   = 1
    memory = { 4.GB * task.attempt }
    time   = { 1.h * task.attempt }

    withLabel: python { container = params.python_image }

    // A task the scheduler killed (out of memory, walltime, node failure, preemption) has
    // exitStatus Integer.MAX_VALUE, not a value in 128..143, so it is named explicitly. Two
    // retries with doubled asks. Every task here feeds the verdict (a missing bucket would
    // silently drop anchors), so after that the run stops (`finish`) rather than going on
    // without it. Any other error is a bug and stops the run the same way.
    maxRetries    = 2
    errorStrategy = {
        (task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE || task.exitStatus in 128..143) && task.attempt <= 2 ? 'retry' : 'finish'
    }
}

profiles {
    stub {
        process.resourceLimits = [cpus: 4, memory: 8.GB, time: 1.h]
        executor {
            name   = 'local'
            cpus   = 4
            memory = '8 GB'
        }
    }

    sherlock {
        process {
            executor       = 'slurm'
            queue          = 'hns,normal'
            clusterOptions = '--account=ayeletv'
            resourceLimits = [cpus: 32, memory: 500.GB, time: 7.d]
        }
        executor {
            submitRateLimit = '15/1min'
            queueSize       = 200
        }
        apptainer {
            enabled     = true
            autoMounts  = true
            cacheDir    = "${System.getenv('SCRATCH') ?: '.'}/apptainer-cache"
            pullTimeout = '60m'
        }
    }
}
