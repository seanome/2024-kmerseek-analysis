// SCOPe40 all-against-all with kept hit lists (main.nf). Sherlock only: no profile runs
// the searches on a laptop.

trace {
    enabled = true
    file    = "${launchDir}/scope40_hitlists.${new java.text.SimpleDateFormat('yyyy-MM-dd-HHmm').format(new java.util.Date())}.trace.txt"
    fields  = 'task_id,hash,native_id,process,tag,name,status,exit,container,cpus,time,memory,attempt,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}
timeline { enabled = true; file = "${launchDir}/scope40_hitlists.${new java.text.SimpleDateFormat('yyyy-MM-dd-HHmm').format(new java.util.Date())}.timeline.html" }
report   { enabled = true; file = "${launchDir}/scope40_hitlists.${new java.text.SimpleDateFormat('yyyy-MM-dd-HHmm').format(new java.util.Date())}.report.html" }

process {
    // Nextflow runs each task under bash -ue. A scheduler kill reports Integer.MAX_VALUE,
    // not 128..143, so any non-zero exit retries once, with the same ask (sized from the
    // measured QfO run, README); a second failure drops that one search (its row on the page then reads "not run") and
    // the rest carry on. prepareScope has nothing downstream without it, so it stops the run.
    errorStrategy = { task.attempt < 2 ? 'retry' : 'ignore' }
    maxRetries    = 1
    withName: prepareScope { errorStrategy = { task.attempt < 2 ? 'retry' : 'terminate' } }
}

profiles {
    sherlock {
        process {
            executor       = 'slurm'
            queue          = 'hns,normal'
            clusterOptions = '--account=ayeletv'
            // ProstT5 predicts 3Di with a GPU; hns has gpu:4 (qfo-pfam-region-benchmark).
            withName: prostt5Db {
                queue            = 'hns'
                clusterOptions   = '--account=ayeletv --gres=gpu:1'
                containerOptions = '--nv'
            }
        }
        executor {
            submitRateLimit = '15/1min'
            queueSize       = 50
        }
        apptainer {
            enabled    = true
            autoMounts = true
            cacheDir   = "${System.getenv('SCRATCH') ?: '.'}/apptainer-cache"
        }
    }
}
