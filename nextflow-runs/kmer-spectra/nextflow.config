// Nextflow configuration for the k-mer spectra pipeline

def dateFormat = new java.text.SimpleDateFormat('yyyy-MM-dd')
def today = dateFormat.format(new java.util.Date())

workDir = "${launchDir}/work"

trace {
    enabled = true
    file = "${launchDir}/kmer_spectra.${today}.trace.txt"
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes'
}

timeline {
    enabled   = true
    overwrite = true
    file = "${launchDir}/kmer_spectra.${today}.timeline.html"
}

report {
    enabled   = true
    overwrite = true
    file = "${launchDir}/kmer_spectra.${today}.report.html"
}

profiles {
    // Default: local Docker execution (original behavior, unchanged).
    standard {
        process {
            cpus   = 2
            maxForks = 4

            // memory/time are set in main.nf (per-combo/per-run, since HP-family combos
            // need far more RAM than everything else, and UniRef-scale inputs need more
            // wall-clock than Swiss-Prot) -- see the comment on the sherlock profile's
            // process block for why they're not set here.
            withName: indexAndSpectrum {
                container = 'kmerseek-spectra:latest'
            }
        }

        executor {
            name   = 'local'
            cpus   = 8
            memory = '110 GB'   // Leave ~18 GB for OS and other processes.
        }

        docker {
            enabled = true
        }
    }

    // Stanford Sherlock (SLURM + Apptainer). Each process is submitted as its own
    // SLURM job on the `hns` school-condo partition (billed to the ayeletv account) --
    // much shorter queue than the public `normal` partition at submission time.
    //
    // Prerequisites (see nextflow-runs/kmer-spectra/README-sherlock.md for the full runbook):
    //   1. Push the image built from ./Dockerfile to docker.io/olgabot/kmerseek:2026-08-20-kmer-spectra
    //      (see README-sherlock.md for the exact build/tag/push commands).
    //   2. rsync the input fasta and this nextflow-runs/kmer-spectra/ directory to Sherlock
    //      (e.g. under $SCRATCH), and launch `nextflow run main.nf -profile sherlock ...`
    //      from a login node inside tmux/screen, or from an `sh_dev` session -- not bare
    //      on the login node, since the docs ask that non-trivial work happen on compute nodes.
    sherlock {
        process {
            executor = 'slurm'
            clusterOptions = '--account=ayeletv'
            cpus   = 2

            // queue/maxForks/memory/time/errorStrategy/maxRetries for indexAndSpectrum are
            // set in main.nf, not here -- queue needs to switch to `bigmem` (up to 4096
            // GB/node, vs hns's ~186 GB) for datasets whose in-memory proteome doesn't fit
            // on an hns node at all, maxForks needs to drop for bigmem's much tighter
            // per-user QOSMaxSubmitJobPerUserLimit than hns's, memory needs the task's label
            // to size per-combo (every HP-family alphabet needs far more RAM than
            // protein/dayhoff, across its whole ksize range -- see main.nf's taskMemory
            // comment), and time needs params.task_time to scale for UniRef-scale inputs
            // (see params.queue/node_mem_cap_gb/node_mem_min_gb/max_forks in main.nf).
            // Config-level directives here can only see task.attempt, not the process's own
            // inputs or params set via CLI flags at the same priority. Config directives
            // always override script-declared ones in Nextflow, so don't set
            // queue/maxForks/memory/time/errorStrategy/maxRetries on indexAndSpectrum here
            // even as a "default" -- it would silently win over the per-combo/per-run sizing.
            withName: indexAndSpectrum {
                container = 'docker://olgabot/kmerseek:2026-08-20-kmer-spectra'
            }
        }

        apptainer {
            enabled    = true
            autoMounts = true
            // Cache pulled/converted images under $SCRATCH rather than $HOME (small quota).
            cacheDir = "${System.getenv('SCRATCH') ?: '.'}/apptainer-cache"
        }
    }
}
