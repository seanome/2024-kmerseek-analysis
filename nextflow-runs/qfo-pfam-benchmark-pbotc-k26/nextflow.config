// nextflow.config — QfO Pfam benchmark, hp-pbotc-1st-ed k=26

def today = new java.text.SimpleDateFormat('yyyy-MM-dd').format(new java.util.Date())

workDir = "${launchDir}/work"

docker {
    enabled    = true
    runOptions = '--entrypoint ""'
}

executor {
    name   = 'local'
    cpus   = 12
    memory = '64 GB'
}

process {
    errorStrategy = { task.exitStatus in [130, 137, 140] ? 'retry' : 'terminate' }
    maxRetries    = 3

    withName: 'INDEX_SPECIES' {
        cpus     = 1
        memory   = { 4.GB * task.attempt }
        maxForks = 8
    }

    withName: 'SEARCH_HUMAN_VS_SPECIES' {
        cpus     = 1
        memory   = { 8.GB * task.attempt }
        maxForks = 4
    }
}

resume = true

trace {
    enabled = true
    file    = "${launchDir}/qfo_pfam_pbotc_k26.${today}.trace.txt"
    fields  = 'task_id,hash,native_id,process,tag,name,status,exit,container,cpus,memory,attempt,submit,start,complete,duration,realtime,%cpu,%mem,rss,peak_rss,vmem,peak_vmem,rchar,wchar'
}
timeline {
    enabled = true
    file    = "${launchDir}/qfo_pfam_pbotc_k26.${today}.timeline.html"
}
report {
    enabled = true
    file    = "${launchDir}/qfo_pfam_pbotc_k26.${today}.report.html"
}
