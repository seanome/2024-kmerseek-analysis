// Nextflow configuration for kmerseek QfO 2020 all-vs-all run

manifest {
    name        = 'kmerseek-qfo-2020'
    description = 'All-vs-all kmerseek HP multi-k on QfO 2020 reference proteomes → OrthoXML'
    version     = '2.0.0'
}

// ---------------------------------------------------------------------------
// Docker
// ---------------------------------------------------------------------------
docker {
    enabled    = true
    runOptions = '--entrypoint ""'
}

// ---------------------------------------------------------------------------
// Execution
// ---------------------------------------------------------------------------
executor {
    name    = 'local'
    cpus    = 8
    memory  = '32 GB'
}

process {
    errorStrategy = { task.exitStatus in [130, 137, 140] ? 'retry' : 'retry' }
    maxRetries    = 3

    withName: 'INDEX_PROTEOME' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
    }

    withName: 'KMERSEEK_SEARCH' {
        cpus     = 1
        memory   = { 8.GB * task.attempt }
        maxForks = 6   // limit concurrent searches to avoid memory pressure
    }

    withName: 'FORMAT_ORTHOXML' {
        cpus   = 1
        memory = { 16.GB * task.attempt }
    }
}

// ---------------------------------------------------------------------------
// Work directory and caching
// ---------------------------------------------------------------------------
workDir = "${launchDir}/work"

// Resume by default when re-running
resume = true

// ---------------------------------------------------------------------------
// Reporting
// ---------------------------------------------------------------------------
report {
    enabled = true
    file    = "${launchDir}/results/pipeline_report.html"
}

timeline {
    enabled = true
    file    = "${launchDir}/results/pipeline_timeline.html"
}

trace {
    enabled   = true
    file      = "${launchDir}/results/pipeline_trace.txt"
    overwrite = true
    fields    = 'task_id,name,tag,status,exit,submit,start,complete,duration,realtime,cpus,memory,%cpu,%mem,rss,peak_rss,vmem,peak_vmem,rchar,wchar'
}
