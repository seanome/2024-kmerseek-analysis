// Sherlock settings for nf-core/rnaseq 3.27.0, pre-processing only.
// Passed with `-c sherlock.config`; the pipeline's own profiles are not used.

process {
    executor       = 'slurm'
    // Either partition, whichever starts the job first.
    queue          = 'hns,normal'
    clusterOptions = '--account=ayeletv'

    // The largest pair is 13.3 GB gzipped, about 120 million read pairs of 150 bp, 600
    // times the 200_000 pairs of the test, where Trim Galore used 78 MB and ran 3 s
    // (task realtime), so about 30 min here. Trim Galore holds little in
    // memory; the pipeline's default 36 GB only slows scheduling. 8 CPUs gives cutadapt
    // 4 cores (the module subtracts 4 for pigz).
    withName: 'TRIMGALORE' {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }
    // FastQC: 6 s and under 1 GB on 200_000 reads in the test, so about 1 h on 120 million.
    withName: 'FASTQC' {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 6.h  * task.attempt }
    }
    // Measured in the 2-sample test (2026-10-21): the index peaked at 3.2 GB in 4 min 46 s,
    // a quant at 2.3 GB. The pipeline asks 72 GB and 36 GB.
    withName: 'SALMON_INDEX' {
        cpus   = 6
        memory = { 8.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withName: 'SALMON_QUANT' {
        cpus   = 6
        memory = { 6.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
}

executor {
    submitRateLimit = '15/1min'
    queueSize       = 100
}

apptainer {
    enabled     = true
    autoMounts  = true
    cacheDir    = "${System.getenv('SCRATCH') ?: '.'}/apptainer-cache"
    pullTimeout = '60m'
}
