// SCOPe40 kmerseek 0.4 alphabet x ksize x extension sweep.

def today = new java.text.SimpleDateFormat('yyyy-MM-dd-HHmm').format(new java.util.Date())

trace {
    enabled = true
    file    = "${launchDir}/scope40_v040.${today}.trace.txt"
    fields  = 'task_id,hash,native_id,process,tag,name,status,exit,container,cpus,time,memory,attempt,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}
timeline { enabled = true; file = "${launchDir}/scope40_v040.${today}.timeline.html" }
report   { enabled = true; file = "${launchDir}/scope40_v040.${today}.report.html" }

process {
    // Any non-zero exit retries, three attempts in all. A scheduler kill reports
    // Integer.MAX_VALUE, not 128..143, so the rule is not limited to exit codes.
    // An index or a search that fails three times is dropped, not fatal: one alphabet-
    // ksize pair must not stop 1_358 searches. collectScores lists every dropped search
    // as `failed`, so nothing goes missing silently. Nothing downstream counts tasks
    // with groupTuple, so a dropped task cannot leave a group waiting.
    errorStrategy = { task.attempt < 3 ? 'retry' : 'ignore' }
    maxRetries    = 2
    withName: 'prepareScope|collectScores' {
        errorStrategy = { task.attempt < 3 ? 'retry' : 'terminate' }
    }
}

profiles {
    standard {
        process {
            executor = 'local'
            cpus     = 2
            memory   = '8 GB'
            withName: 'kmerseekIndex|kmerseekSearch' { cpus = 4 }
        }
        docker { enabled = true }
    }

    sherlock {
        process {
            executor       = 'slurm'
            queue          = 'hns,normal'
            clusterOptions = '--account=ayeletv'
            cpus           = 2
            memory         = '8 GB'
            time           = '4h'
            maxForks       = params.max_forks
            // cpus only: memory and time for these are per-pair closures in main.nf, and a
            // selector setting them here would silently replace those (a withName beats a
            // process-body directive).
            withName: 'kmerseekIndex|kmerseekSearch' { cpus = 8 }
        }
        executor {
            submitRateLimit = params.submit_rate_limit
            queueSize       = params.queue_size
        }
        apptainer {
            enabled    = true
            autoMounts = true
            cacheDir   = "${System.getenv('SCRATCH') ?: '.'}/apptainer-cache"
        }
    }

    // Wiring check: nextflow run main.nf -profile stub -stub-run
    stub {
        docker.enabled    = false
        apptainer.enabled = false
        process { executor = 'local'; cpus = 1 }
    }
}
