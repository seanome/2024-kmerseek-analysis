// Short disulfide-rich peptides by cysteine framework.
//
// Everything that runs kmerseek runs on Sherlock, under `-profile sherlock`: the pilot,
// run-phylum and run-genus. `standard` exists only so `-stub-run` can check the wiring on
// the Mac, and main.nf refuses a real run under it.
//
// Why: two pilot runs under `standard` crashed the laptop (2026-10-14 15:54 and
// 2026-10-15 about 04:58). Each started 4-5 `kmerseek index` tasks at once; in the first,
// three of the four cys2 tasks reached 61-66 GB each within 4 minutes. On the local
// executor `memory` caps nothing; it only tells Nextflow how many tasks fit side by side.

params.run_date = new java.text.SimpleDateFormat('yyyy-MM-dd').format(new java.util.Date())

// kmerseek branch olgabot/cys-runs-040 at c39370c: v0.4.0, plus PR 141 (an index entry is
// keyed by its sequence, not by its k-mer set), plus cys2 (PR 147) and cys_hp3 (PR 148).
//
// The key fix has to be in. Without it an entry is keyed by its k-mer set, so two
// sequences with equal sets collapse into one and only the first is stored. Under cys2
// that is the common case rather than the corner case, since cys2 is built so that
// peptides sharing a cysteine framework encode identically: on the 125 test
// ribonucleases a cys2 index held 94 of them before the fix and 121 after, where 121 is
// right because 4 of the 125 are duplicate sequences.
params.kmerseek_sha = 'c39370c4e8d3b1b89cee726945bb0aa1bf90a8a3'

// Built from that commit by `make push-image`, from nextflow-runs/cys-frameworks/Dockerfile
// with the kmerseek worktree as the build context. Set it to the digest the push prints,
// so a run names one immutable image rather than a tag that can move under it.
params.pipeline_image = 'docker.io/olgabot/kmerseek:2026-10-15-cys-frameworks-c39370c'

// HMMER 3.4, the same pinned biocontainer digest the deep-twilight controls use, so
// phmmer is the same binary in both experiments.
params.hmmer_image = 'quay.io/biocontainers/hmmer@sha256:7a2b317b8d2fd3650b4924a8482cddeb940d4a0746c6a1501ff03ac1b7439e0c'

workDir = "${launchDir}/work"

trace {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/cys_frameworks.${params.run_date}.trace.txt"
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,container,cpus,time,memory,attempt,submit,start,complete,duration,realtime,%cpu,peak_rss,rchar,wchar'
}

report {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/cys_frameworks.${params.run_date}.report.html"
}

process {
    cpus   = 2
    memory = { 8.GB * task.attempt }
    time   = { 2.h * task.attempt }

    // A task the scheduler killed -- out of memory, walltime, node failure, preemption --
    // has exitStatus Integer.MAX_VALUE rather than a value in 128..143, so it is named
    // explicitly or the retry never fires on the thing it was written for. The attempt cap
    // is inside the closure, since an exhausted `retry` fails the run.
    //
    // Where a path out ends is per process: indexReference ends at `finish`, because every
    // search against that reference needs the index, and searchQueries, regexScan and
    // phmmerSearch end at `ignore`, because one of those is one cell of the results table
    // and the scoring step records a missing cell as missing rather than as a zero.
    maxRetries    = 3
    errorStrategy = {
        (task.exitStatus == null
         || task.exitStatus == Integer.MAX_VALUE
         || task.exitStatus in 128..143) && task.attempt <= 3 ? 'retry' : 'finish'
    }
}

profiles {
    // -stub-run only. Every process has a stub: block that writes empty outputs, so this
    // checks the channels and file names in seconds without running kmerseek or phmmer.
    // main.nf stops a run under this profile that is not a stub run.
    standard {
        process {
            executor  = 'local'
            container = null
            // The stubs only touch files. Without this the local executor refuses to start
            // a cys2 task, whose Sherlock ask (180 GB) is more than this laptop has.
            withName: 'indexReference|searchQueries' {
                memory = 1.GB
            }
        }
        docker.enabled = false
        apptainer.enabled = false
    }

    sherlock {
        process {
            executor       = 'slurm'
            queue          = 'hns,normal'
            clusterOptions = '--account=ayeletv'
        }
        apptainer {
            enabled    = true
            autoMounts = true
            // Converted images live here, not in the launch folder, so two runs share one
            // conversion instead of each unpacking its own copy.
            cacheDir   = "${System.getenv('SCRATCH')}/apptainer_cache"
        }
        executor {
            queueSize       = 200
            submitRateLimit = '20/1min'
        }
    }
}
