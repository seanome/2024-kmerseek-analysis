// nextflow.config — E3 detection-gap benchmark, missing baseline arms

def dateFormat = new java.text.SimpleDateFormat('yyyy-MM-dd')
def today = dateFormat.format(new java.util.Date())

workDir = "${launchDir}/work"

trace {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/e3_detection_gap.${today}.trace.txt"
    // peak_rss / %cpu are NOT recorded on macOS without containers; the throughput
    // numbers in notebook 340 must come from a Linux run to be quotable.
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,container,cpus,time,memory,attempt,submit,start,complete,duration,realtime,%cpu,%mem,rss,peak_rss'
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/e3_detection_gap.${today}.timeline.html"
}

report {
    enabled   = true
    overwrite = true
    file      = "${launchDir}/e3_detection_gap.${today}.report.html"
}

process {
    errorStrategy = { task.exitStatus in [-1, 130, 137, 140] ? 'retry' : 'terminate' }
    maxRetries    = 3

    withLabel: low_cpu {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = '4h'
    }

    withLabel: medium_cpu {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = '12h'
    }

    withLabel: high_cpu {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = '24h'
    }

    withLabel: very_high_cpu {
        cpus   = 12
        memory = { 48.GB * task.attempt }
        time   = '72h'
    }

    withLabel: gpu {
        cpus   = 8
        memory = { 48.GB * task.attempt }
        time   = '48h'
        // accelerator = 1   // uncomment on a GPU executor
    }

    // foldseekCollectStructures runs inline conda Python via an absolute-path
    // shebang, so it must NOT be containerised.
    withName: foldseekCollectStructures {
        container = null
        maxForks  = 4
    }

    withName: foldseekCreateDB {
        maxForks = 2
    }

    withName: foldseekSearch {
        maxForks = 1    // structure search is disk-tmp heavy
    }

    // InterProScan is a local install, not a container.
    withName: interproscanPfam {
        container = null
        maxForks  = 1
    }

    withName: jackhmmerBuildProfiles {
        maxForks = 1
    }

    withName: jackhmmerSearch {
        maxForks = 2
    }
}

executor {
    name   = 'local'
    cpus   = 12
    memory = '64 GB'
}

docker {
    enabled    = true
    // Nextflow runs /bin/bash inside the container; an image ENTRYPOINT breaks that.
    runOptions = '--entrypoint ""'
}

profiles {
    local {
        // defaults above
    }

    // Structure and PLM arms are the ones worth pushing to the cloud.  Real queue,
    // bucket and account values live in a gitignored .env — this repo is public.
    awsbatch {
        process.executor = 'awsbatch'
        process.queue    = System.getenv('NF_BATCH_QUEUE')      ?: 'REPLACE_ME'
        workDir          = System.getenv('NF_WORKDIR_S3')       ?: 's3://REPLACE_ME/work'
        aws.region       = System.getenv('AWS_REGION')          ?: 'REPLACE_ME'
    }
}
