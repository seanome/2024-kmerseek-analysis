// nextflow.config — QfO HP-alphabet x ksize sweep
// 6 encodings x 7 ksizes x 9 species, batched one job per species per stage.

def today = new java.text.SimpleDateFormat('yyyy-MM-dd').format(new java.util.Date())

trace    { enabled = true;  file = "${launchDir}/qfo_hp_alphabet_sweep.${today}.trace.txt";
           fields  = 'task_id,hash,native_id,process,tag,status,exit,container,cpus,time,memory,attempt,submit,start,complete,duration,realtime,%cpu,%mem,peak_rss' }
timeline { enabled = true;  file = "${launchDir}/qfo_hp_alphabet_sweep.${today}.timeline.html" }
report   { enabled = true;  file = "${launchDir}/qfo_hp_alphabet_sweep.${today}.report.html" }

process {
    // Retry on OOM / preemption / SIGTERM (Spot reclamation)
    errorStrategy = { task.exitStatus in [-1, 130, 137, 140] ? 'retry' : 'terminate' }
    maxRetries    = 2

    // Each task runs 42 (encoding, ksize) combos sequentially, one species'
    // worth of indexing or searching. Per-combo peak RSS was ~1-2 GB in prior
    // QfO runs (larger protein alphabet, k up to 40); HP alphabets collapse
    // 20 symbols to 2, so this should be an upper bound, not a floor.
    //
    // time=48h (not 12h): a local smoke test (ecoli, 1 encoding, k=18+20 only)
    // measured ~25 min search time alone, and low-k HP search cost scales
    // with target proteome size — extrapolating that measurement to the
    // largest species (arabidopsis, ~6.3x ecoli's sequence count) across all
    // 6 encodings x 7 ksizes projects ~18h for that one species' batched job.
    // 12h would have been cut off mid-run.
    withName: 'INDEX_SPECIES|SEARCH_HUMAN_VS_SPECIES' {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = '48h'
    }
}

profiles {

    // ─── local — bare kmerseek 0.4.0 binary, no container ───────────────────
    local {
        workDir = "${launchDir}/work"

        executor {
            name   = 'local'
            cpus   = 8
            memory = '32 GB'
        }
    }

    // ─── aws — AWS Batch via Seqera Platform, Fusion + Wave ─────────────────
    //
    // Prereq: source ~/.config/seqera/seanome-kmerseek.env
    //   (sets TOWER_ACCESS_TOKEN, TOWER_WORKSPACE_ID — read automatically by
    //   Nextflow's tower/wave/fusion client, no need to reference them here)
    //
    // Fusion streams S3 I/O directly (no `aws s3 cp` staging, no AWS CLI
    // baked into the container). Wave builds/serves the kmerseek container
    // on the fly from the Dockerfile in the kmerseek repo (olgabot/bump-
    // version-0.4.0 branch) — still push a tagged image too (see Makefile)
    // so Wave has a stable source to build from and launches don't depend
    // on local source state.
    //
    // Required overrides at launch time (queue/bucket names are account-specific,
    // never hardcode them here — see .env / memory):
    //   --queue  YOUR-CPU-QUEUE
    //   -w       s3://YOUR-BUCKET/qfo-hp-alphabet-sweep/work
    //   --outdir s3://YOUR-BUCKET/qfo-hp-alphabet-sweep
    //
    aws {
        process.executor = 'awsbatch'
        process.queue    = params.queue ?: 'REPLACE_WITH_CPU_QUEUE'

        aws {
            region = params.aws_region ?: 'us-west-2'
        }

        wave   { enabled = true }
        fusion { enabled = true }

        // kmerseek runs from a Wave-built container on AWS, not the bare
        // local binary path used by -profile local.
        params.kmerseek_bin = 'kmerseek'

        process {
            withName: 'INDEX_SPECIES|SEARCH_HUMAN_VS_SPECIES' {
                container = { params.kmerseek_container }
            }
        }
    }

    // ─── test — 1 species (ecoli, smallest proteome), 1 encoding, 2 ksizes ──
    test {
        params {
            species   = ['ecoli']
            encodings = ['hp-thomas-dill']
            ksizes    = [18, 20]
        }
    }
}
